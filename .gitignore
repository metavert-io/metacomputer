# VM disks, downloads, build tools, runtime state
.cache/
.run/
.run-vms/
vendor/
*.img
*.iso
*.raw
# evidence (kept on this host, not in git)
recordings/*
screenshots/*
logs/*
logs-vms/
results/*
!recordings/.gitkeep
!screenshots/.gitkeep
!logs/.gitkeep
!results/.gitkeep
# per-machine settings
config/local.env
config/*.local.env
# never commit credentials
*.pem
*vnc-pass*
.DS_Store
__pycache__/
CLAUDE.local.md
/local/

# per-VM settings (metacomputer vm create) and the default computer (metacomputer default)
config/vms/
config/default-vm
config/.default-vm.*
