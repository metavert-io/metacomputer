!screenshots/.gitkeep
!logs/.gitkeep
!results/.gitkeep
# per-machine settings
config/local.env
config/*.local.env
# never commit credentials
*.pem
*vnc-pass*
.DS_Store
__pycache__/
CLAUDE.local.md
/local/

# per-VM settings (metacomputer vm create)
config/vms/
