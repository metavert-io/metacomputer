# metacomputer defaults. Sourced by scripts/lib.sh (bash) BEFORE
# config/local.env, which holds this machine's own settings (written by
# install.sh, never committed; see config/local.env.example). Set MCOMP_CONFIG to
# use another local file instead, e.g. for a separate test VM.
# Pinned versions and digests make a rebuild on another Apple-silicon Mac
# produce the same guest.

# --- VM ---------------------------------------------------------------------
VM_NAME=metacomputer
BASELINE_NAME=metacomputer-baseline
VM_CPU=4
VM_MEMORY=8GB
VM_DISK_BYTES=53687091200          # 50 GiB (sparse)
IMPORT_MIN_FREE_GB=10              # copies from the VM (get, task finish, recordings --sync) stop before
                                   # the Mac has less than this free; they also stop past VM_DISK_BYTES
VM_DISPLAY=1920x1080
VM_HOSTNAME=metacomputer

# --- Guest accounts ---------------------------------------------------------
GUEST_USER=cua                     # desktop / automation user, no sudo
ADMIN_USER=cuaadmin                # maintenance user, narrow sudo allowlist after build

# --- Official Ubuntu image (cloud-images.ubuntu.com, GPG-signed SHA256SUMS) --
UBUNTU_RELEASE=20261017
UBUNTU_BASE_URL=https://cloud-images.ubuntu.com/releases/noble/release-20261017
UBUNTU_IMAGE=ubuntu-24.04-server-cloudimg-arm64.img
UBUNTU_IMAGE_SHA256=50e24e1fb79e89116e939d90aa7738f7af48c442fa1bc2510131e0b39c50348e
UBUNTU_SIGNING_KEY_FPR=D2EB44626FDDC30B513D5BB71A5D6C4C7DB87C81

# --- Lume (runs the VM) --------------------------------------------------------
# install.sh asks which Lume to use and writes LUME to config/local.env:
# mcomp-vm (default): metacomputer's build of Lume, from source plus flags that
#   can leave out the host-sharing devices (https://github.com/metavert-io/metacomputer-vm;
#   made by Metavert, not by Cua);
# standard: Cua's notarized Lume release, which always shares them.
# mcomp-vm was called lume-secure. While LUME's runner isn't installed and
# ~/.local/bin/lume-secure is, metacomputer uses that one and says so.
LUME="$HOME/.local/bin/mcomp-vm"
# mcomp-vm's source; install.sh checks that the tag is this commit. A local.env
# from before the rename may set LUME_SECURE_REPO, LUME_SECURE_TAG and
# LUME_SECURE_COMMIT instead: install.sh still reads those, and these names win
# when a local.env sets both.
MCOMP_VM_REPO=https://github.com/metavert-io/metacomputer-vm.git
MCOMP_VM_TAG=v0.7.2-mcomp.2
MCOMP_VM_COMMIT=26dc0df2b75edaca26cb2306995a0b6437a87349

# --- Host sharing ----------------------------------------------------------------
# Lume connects every VM to the Mac's clipboard (SPICE agent port), audio
# (speakers and microphone) and Rosetta. With mcomp-vm, metacomputer leaves out
# each one that isn't "on" here (standard Lume can't; it shares all three).
SHARE_CLIPBOARD=off
SHARE_AUDIO=off
SHARE_ROSETTA=off

# --- Cua components -----------------------------------------------------------
LUME_VERSION=0.7.2
LUME_TARBALL_SHA256=c96cf5a7b01df77f7259263d7142d522d53fcb0e5dd8ce76d1bee835dddaa574
CUA_DRIVER_VERSION=0.53.0
CUA_DRIVER_TARBALL=cua-driver-rs-0.53.0-linux-arm64.tar.gz
CUA_DRIVER_SHA256=fd5e6a9d0a61a78b558ec86940d9d99fab8d4f2fe7d9cf83ae364fb2518d6786
CUA_SRC_COMMIT=ca6a6434ea8469ce08417bf1f639240d7a30352b   # cua-netgw is built from here

# --- Mozilla APT repository (arm64 Firefox .deb, no snap) ---------------------
MOZILLA_KEY_URL=https://packages.mozilla.org/apt/repo-signing-key.gpg
MOZILLA_KEY_FPR=35BAA0B33E9EB396F59CA838C0BA5CE6DC6315A3
# Browsers baked in at build time. Firefox is always installed and stays the
# default browser; "chrome" adds Google Chrome (official arm64 .deb from
# Google's APT repo, key pinned below; Google publishes this fingerprint at
# https://www.google.com/linuxrepositories/). Using Chrome means accepting
# Google's terms; install.sh asks.
BROWSERS="firefox chrome"
GOOGLE_KEY_URL=https://dl.google.com/linux/linux_signing_key.pub
GOOGLE_KEY_FPR=EB4C1BFD4F042F6DDDCCEC917721F63BD38B4796

# --- Network (cua-netgw user-mode gateway; nothing listens off-loopback) ------
NET_SUBNET=10.213.77.0/24
NET_GATEWAY_IP=10.213.77.1
NET_GATEWAY_MAC=5a:94:ef:e4:0c:01
NET_GUEST_IP=10.213.77.2
NET_DNS_UPSTREAM='"1.1.1.1:53","9.9.9.9:53"'
SSH_PORT=2277                      # 127.0.0.1:2277 -> guest :22
SECRETS_PROXY_PORT=18765           # metacomputer secrets: the API proxy's port inside the VM (127.0.0.1; next build)
VNC_PORT=5977                      # 127.0.0.1:5977 -> guest x11vnc :5900 (password)

# --- Paths ------------------------------------------------------------------
SSH_DIR="$HOME/.ssh/metacomputer"     # keys + pinned guest host key, outside the repo
GUEST_RUN_DIR="/home/$GUEST_USER/metacomputer-runs"
# This VM's runtime files (gateway process, build seed) and logs (Lume, gateway,
# action log) on the Mac. Empty = .run/ and logs/ in this checkout (.run-vms/NAME
# and logs-vms/NAME for a VM in config/vms/). A second VM that runs at the same
# time as the first needs its own (and its own VM_NAME, SSH_DIR and ports):
# `metacomputer vm create NAME` sets them all up. A VM in config/vms/ can't set these
# (its folders are fixed by its name). No VM's folder may be another's, be inside one
# or hold one, or be in the runner's VM storage (~/.lume) and the like: docs/commands.md.
RUN_DIR=""
LOG_DIR=""
# This VM's secrets vault folder (passed to mcomp-vault as MCOMP_VAULT_DIR) and the
# event spool its vault drops events into (MCOMP_EVENTS_SPOOL). Empty = the
# vault's own folder, ~/Library/Application Support/metacomputer, and its
# events/spool, for config/local.env (as before); a VM in config/vms/ has
# .../metacomputer-vms/NAME and .../metacomputer-vms/NAME/events/spool, fixed. MCOMP_VAULT_DIR
# and MCOMP_EVENTS_SPOOL in the environment override these (for a config/vms/ VM, only
# with its own folders).
VAULT_DIR=""
EVENTS_SPOOL=""

# --- Storage (docs/storage.md) ---------------------------------------------------
# Disk volumes and reference disks live outside the VM, so reset, restore and rebuild keep
# them. Manage them with `metacomputer volume ...` and `metacomputer refdisk ...`; attach
# them here. Each takes effect at the next start (`metacomputer start --no-volumes` starts
# without any of them).
STORAGE_DIR=""                     # where new volumes and reference disks go: any folder you can reach
                                   # (an external drive, a NAS mount); empty = ~/.local/share/metacomputer
VOLUMES=""                         # disk volumes to attach, read-write (one VM at a time):
                                   # name[:mountpoint] separated by commas; default mount point ~/data/NAME
                                   # in the VM, e.g. "work" or "work:/volume,cache:/mnt/cache"
REFDISKS=""                        # read-only reference disks to attach (any number of VMs):
                                   # name[:mountpoint]; default ~/ref/NAME in the VM
S3_SYNC_INTERVAL=60                # S3-backed folder volumes: seconds between syncs while the VM runs
                                   # (also at start and at stop)
S3_BACKUP_MAX_GB=5                 # S3 volumes: local copies a sync overwrote or deleted are kept up to this
                                   # much (newest first); the reserve IMPORT_MIN_FREE_GB also caps each sync
# rclone syncs S3-backed folder volumes with their bucket (bisync). Downloaded on first use by
# scripts/fetch-artifacts.sh rclone: SHA256SUMS signed by rclone's release key (fingerprint
# pinned), the zip's digest pinned and cross-checked. The program inside the zip is pinned too
# (RCLONE_BIN_SHA256): it's checked against that value before every use, and unpacked again from
# the verified zip when it's missing or different; no digest file on disk is trusted. Runs only on
# the Mac, never in the VM.
RCLONE_VERSION=1.75.2
RCLONE_BASE_URL=https://downloads.rclone.org/v1.75.2
RCLONE_ZIP=rclone-v1.75.2-osx-arm64.zip
RCLONE_SHA256=610ab7d48615135dfc60b763858b11a426a0d3d1160c1bb76fb0ae6011b02edd
RCLONE_BIN_SHA256=af0257730173748dc9706ad3c83288bf3a0c5d5e9768fef20235e375e9d835e1
RCLONE_KEYS_URL=https://rclone.org/KEYS
RCLONE_SIGNING_KEY_FPR=FBF737ECE9F8AB18604BD2AC93935E02FF3B54FA

# --- Extra apps ----------------------------------------------------------------
# More Ubuntu packages installed when the VM is built, from Ubuntu's own archive
# like the rest and without their "recommended" extras, e.g.
# "inkscape gimp". Takes effect on the next build.
EXTRA_PACKAGES=""

# A sound card inside the VM that plays into nothing (PulseAudio with one null
# sink). Apps such as browsers, games and audio or video editors get working
# sound output, and desktop recordings capture it (RECORD_AUDIO). Nothing
# reaches the Mac's speakers or microphone: the virtio sound device stays
# switched off in the guest, and Lume's own audio sharing is SHARE_AUDIO.
# off | on. Takes effect on the next build.
VIRTUAL_AUDIO=off

# --- Desktop recordings (metacomputer record) -----------------------------------
RECORD_FPS=20                      # frames per second
RECORD_QUALITY=standard            # standard: small files, enough to see what happened
                                   # high: sharp enough to edit into videos (several times larger)
RECORD_TO=host                     # host: stream to the Mac while recording; what was sent is out of the
                                   # VM's reach (a script that wipes ~ mid-recording can't take it back)
                                   # guest: record inside the VM, copy to the Mac at stop; anything running
                                   # in the VM can delete it first (record start warns)
RECORD_DIR=""                      # folder on the Mac for recordings; empty = recordings/manual/ here
RECORD_AUDIO=auto                  # auto: include the VM's sound when it has the virtual sound card
                                   # (VIRTUAL_AUDIO=on); off: video only
# Per-task recordings (Cua Driver's start_recording into a task folder) are written in the VM. While a task
# folder is open (task start .. task finish), every this many seconds the Mac copies each recording turn the
# driver has finished, once; task finish copies the rest, the video included. 0: copy only at task finish.
TASK_SYNC_INTERVAL=15

# --- Live view password (VNC) -------------------------------------------------
# file: a random password in $SSH_DIR/vnc-pass (0600). keychain: the login Keychain
# (item metacomputer-vnc, account VM_NAME; a new password each build; read it with
# `security find-generic-password -s metacomputer-vnc -a VM_NAME -w`), which
# install.sh sets for a new config/local.env; a password already in $SSH_DIR/vnc-pass
# stays in use, and a Keychain that won't take it (locked, no login session) falls
# back to that file. command: your own secret store (a password manager CLI):
# VNC_PASSWORD_GET prints the password and VNC_PASSWORD_SET stores the password it
# reads on stdin.
VNC_PASSWORD_STORE=file
VNC_PASSWORD_GET=""
VNC_PASSWORD_SET=""
# `metacomputer view --open` puts the password on the clipboard and clears it after this
# many seconds, if the clipboard still holds it then (0: never cleared).
VIEW_CLIPBOARD_S=45
# Screen Sharing's remembered password: `view --open` can save the live-view password in the login
# keychain item Screen Sharing reads for vnc://127.0.0.1:VNC_PORT, so it connects without asking.
# ask: the first time, at a terminal, it asks (no: it writes VIEW_REMEMBER=off for you); once
# saved, each view --open keeps it up to date. on: save without asking. off: no writes at all
# (the clipboard, as above; `view --forget` removes one saved earlier); any other value counts
# as off. `view --remember` and `view --forget` run only at a terminal.
VIEW_REMEMBER=ask

# --- Dialogs on this Mac -----------------------------------------------------------
# Allow metacomputer to show dialogs on this Mac that wait for you. off: nothing pops up on your
# screen by itself (Claude may run commands while you're away). on: when Claude hands you the
# computer (metacomputer handoff), a dialog on the Mac's screen says what it needs, with a button
# that opens the live view (never over SSH, and not without your screen session); and `secrets ask`
# also shows a dialog with a hidden field for the one-time code (read when you unlock the vault).
# A command without a terminal never prompts or opens a dialog itself, whatever this says.
INTERACTIVE_PROMPTS=off

# --- Skill defaults (metacomputer browser) ---------------------------------------
BROWSER=firefox                    # firefox | chrome
MODE=human                         # human | page | hybrid (sign-ins and other account pages: human)
BROWSER_PACING=human               # human: the hub types into Firefox and Chrome windows with a person's pauses
                                   # (a random 60-140 ms per key, 120-320 ms between batch steps, the pointer moved
                                   # toward pixel clicks first; at most 15 s added per call); fast: as fast as the
                                   # driver goes (lib/pacing.py)

# --- One-time codes (SECURITY.md "One-time codes and sign-in links") ------------------
CODES_VIA=vault                    # vault: Claude uses `secrets code`, `relay` or `ask` and never reads or
                                   # types a one-time code itself; claude: your opt-in to let it (the code then
                                   # lands in the transcript, with no site binding). Guidance, not enforced

# --- Shell channel (metacomputer sh; docs/shell.md, SECURITY.md) -------------------
# bash in the VM as the desktop user, over the same SSH connection as `metacomputer ssh ops`.
VM_SHELL=auto                      # auto: on, except off while DRIVER_MODE=bounded (the shell isn't
                                   # limited by the driver's manifest); on: always; off: never
SHELL_LOG=auto                     # auto: each run goes in the signed action log when ACTION_LOG=on
                                   # (script and output hashed and sized; text only with ACTION_LOG_TEXT=keep);
                                   # off: shell runs are never logged

# --- The hub (lib/mcp_hub.py; architecture.md "The hub", SECURITY.md) -------------
# One process per VM on this Mac holds the single connection to Cua Driver and serves
# Claude Code's bridge, `metacomputer call` and scripts (lib/mcomp_sdk.py) over a private
# socket in RUN_DIR, applying every guard to every client. Element tokens, driver
# sessions, recordings and a Chrome from browser_prepare outlive a single call.
MCP_HUB=on                         # on: one shared hub per VM; off: each client connects on its own
                                   # (the same guards, run inside each client)
HUB_IDLE=10m                       # the hub exits after this long with no client and no recording
COORD_GUARD=on                     # on: pixel input (click x,y, drag, scroll x,y, run_steps steps with x,y)
                                   # is refused when the windows changed since the screenshot it was
                                   # aimed from; off: only Cua Driver's own checks
HIDDEN_TEXT=on                     # on: page text a person likely can't see (tiny, off the page, no size) or
                                   # that addresses AI agents is marked in results for Claude, and reported as
                                   # security.hidden_text (SECURITY.md "Hidden page text"); off: results as is

# --- Lessons from your own sessions (metacomputer learn; docs/learn.md) ----------
LESSONS=on                         # on: the lessons you approved go in the MCP instructions of every new
                                   # session, as advice (no guard reads them); off: they're kept, not sent
LESSONS_DIR=""                     # their private store; empty = ~/.local/share/metacomputer/lessons

# --- Optional hardening (docs: SECURITY.md) ----------------------------------
# All off by default, which is Cua's own behavior. Each one is independent.
ACTION_LOG=off                     # on: a signed, hash-chained log of every tool call (logs/actions/)
ACTION_LOG_TEXT=redact             # redact | keep: typed text, values and scripts in that log
ACTION_LOG_KEY=""                  # signing key; default $SSH_DIR/action-log (made on first use),
                                   # or a .pub whose private key is in ssh-agent (e.g. hardware-backed)
SSH_AUTH=key                       # key | cert: a fresh key and a short-lived SSH certificate per connection
SSH_CERT_TTL=5m                    # cert lifetime (only the connection's start must fall inside it)
SSH_CA_KEY=""                      # the CA; default $SSH_DIR/ca (made on first use), or a .pub in ssh-agent
DRIVER_MODE=standard               # standard | bounded: Cua Driver's permission mode for MCP connections
DRIVER_PROFILE=desktop             # bounded: readonly | desktop | browser (config/driver-profiles/)
DRIVER_ORIGINS=""                  # bounded browser profile: the sites it may open ("https://a.example https://b.example")
DRIVER_MANIFEST=""                 # bounded: your own Cua capability manifest instead of a profile
DRIVER_EXPIRES=8h                  # bounded: a driver session's lifetime (Cua's limit: 24h)
DRIVER_IDLE=30m                    # bounded: it ends after this long without a call

# --- Event stream (docs/events.md) ----------------------------------------------
# Off until you add a sink (metacomputer events sink add); the sinks are its whole
# configuration, kept in ~/.config/metacomputer/events.json, not here. Two
# environment variables move its files: MCOMP_EVENTS_DIR (that folder) and
# MCOMP_EVENTS_SPOOL (where other programs drop events).
