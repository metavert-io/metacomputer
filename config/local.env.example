# This machine's settings for claude-virtual-computer. install.sh copies this
# file to config/local.env (never committed) and fills in what it asked. Any
# value in config/defaults.env can be overridden here; the common ones are
# listed. Bash syntax: it is sourced after config/defaults.env.

# --- The VM -------------------------------------------------------------------
# Lume VM names. Change them to keep several virtual computers side by side.
#VM_NAME=claude-vc
#BASELINE_NAME=claude-vc-baseline
#VM_HOSTNAME=claude-vc
#VM_CPU=4
#VM_MEMORY=8GB

# Browsers baked in at build time ("firefox" or "firefox chrome"). Chrome means
# accepting Google's terms of service.
#BROWSERS="firefox chrome"

# --- Host side ----------------------------------------------------------------
# SSH keys for the VM (generated by the build, kept outside the repository).
#SSH_DIR="$HOME/.ssh/claude-vc"
# Loopback ports on this Mac for the VM's SSH and live view.
#SSH_PORT=2277
#VNC_PORT=5977

# Where the live-view (VNC) password is kept:
#   file      a random password in $SSH_DIR/vnc-pass (0600)  [default]
#   command   your own secret store (a Keychain helper, a password manager CLI):
#             VNC_PASSWORD_GET prints the password, VNC_PASSWORD_SET stores the
#             password it reads on stdin
#VNC_PASSWORD_STORE=file
#VNC_PASSWORD_GET="my-secret-tool get claude-vc/vnc"
#VNC_PASSWORD_SET="my-secret-tool set claude-vc/vnc"

# --- What Claude does by default (claude-vc browser default|mode) ----------------
#BROWSER=firefox     # firefox | chrome
#MODE=human          # human | page | hybrid
