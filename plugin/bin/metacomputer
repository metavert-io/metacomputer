#!/bin/bash
# metacomputer: the plugin's launcher (the Claude Code plugin, which Codex installs too). The plugin carries no settings,
# VM keys or tools of its own: this runs the metacomputer checkout that ./install.sh (or get.sh) set up on this Mac, with
# the same arguments: $MCOMP_HOME/bin/metacomputer, or else ~/.local/bin/metacomputer (the link install.sh makes). It is
# the `metacomputer` command on Claude Code's PATH while the plugin is on. The plugin declares no MCP server or hooks:
# install.sh registers the agents' MCP server itself (Claude Code's at user scope: ~/.local/bin/metacomputer mcp-lazy).
#
# With no checkout set up, the only thing it runs is `setup`: /bin/bash with the get.sh at the root of this plugin copy,
# which says what it will do and asks first (--confirm). Only the options below pass through; no setting or variable
# can point it at another script or repository. It never hands over to a copy inside an agent's plugin folder (Claude
# Code's, or Codex's plugin cache).
set -uo pipefail
mc_plugins="${CLAUDE_CODE_PLUGIN_CACHE_DIR:-${CLAUDE_CONFIG_DIR:-$HOME/.claude}/plugins}"
mc_codex="${CODEX_HOME:-$HOME/.codex}/plugins/cache"
mc_in_plugins() { case "$1" in "$(readlink -f "$mc_plugins" 2>/dev/null || echo "$mc_plugins")"/*|"$HOME/.claude/plugins/"*) return 0 ;;
                  "$(readlink -f "$mc_codex" 2>/dev/null || echo "$mc_codex")"/*|"$HOME/.codex/plugins/cache/"*) return 0 ;;
                  "$(readlink -f "$HOME/.codex/plugins/cache" 2>/dev/null || echo "$HOME/.codex/plugins/cache")"/*) return 0 ;; esac
                  return 1; }
mc_self="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
for mc_to in ${MCOMP_HOME:+"$MCOMP_HOME/bin/metacomputer"} "$HOME/.local/bin/metacomputer"; do
  mc_to="$(readlink -f "$mc_to" 2>/dev/null)" || continue
  [ -f "$mc_to" ] && [ -x "$mc_to" ] && [ "$mc_to" != "$mc_self" ] && ! mc_in_plugins "$mc_to" || continue
  # A checkout whose install.sh predates the user-scope MCP server (no CLAUDE_MCP=user line) relied on the plugin for
  # the tools, which this plugin no longer brings: its checks and help say so (other commands just run).
  mc_co="$(dirname "$(dirname "$mc_to")")"
  case "${1:-}" in ""|status|agents|where|help|version)
    if [ -f "$mc_co/install.sh" ] && ! grep -q '^CLAUDE_MCP=user' "$mc_co/install.sh" 2>/dev/null; then
      printf '%s\n' "metacomputer: this plugin no longer brings metacomputer's MCP tools (mcp__metacomputer__*): the installer adds" \
        "them, and the metacomputer installed in $mc_co is older than that. Run \`metacomputer update\`, then" \
        "restart Claude Code." >&2
    fi ;;
  esac
  exec "$mc_to" "$@"
done
mc_root="$(dirname "$(dirname "$mc_self")")"
if ! mc_in_plugins "$mc_self"; then   # loaded in place (a local marketplace) from a checkout that isn't set up
  printf '%s\n' "metacomputer: this plugin is loaded from a metacomputer checkout that isn't set up yet: run ./install.sh" \
    "in that folder (it links ~/.local/bin/metacomputer and adds metacomputer's MCP server to Claude Code)," \
    "or point MCOMP_HOME at it." >&2
  exit 1
fi
if [ "${1:-}" = setup ]; then
  shift; mc_args=(--confirm)
  while [ $# -gt 0 ]; do
    case "$1" in
      --dir) [ $# -ge 2 ] || { echo "metacomputer setup: --dir needs a folder" >&2; exit 2; }; mc_args+=(--dir "$2"); shift ;;
      --no-chrome|--no-build|--no-codex|--no-claude|--no-openclaw|--no-hermes|--no-gemini|--no-antigravity|--yes|-y|--dry-run|--help|-h) mc_args+=("$1") ;;
      *) echo "metacomputer setup: unknown option $1 (setup takes --dir DIR, --no-chrome, --no-build, --no-claude, --no-codex, --no-openclaw, --no-hermes, --no-gemini, --no-antigravity, --yes, --dry-run)" >&2; exit 2 ;;
    esac
    shift
  done
  mc_get="$(readlink -f "$mc_root/get.sh" 2>/dev/null)"
  if [ -n "$mc_get" ] && [ "$mc_get" = "$mc_root/get.sh" ] && [ -f "$mc_get" ] && mc_in_plugins "$mc_get"; then
    exec /bin/bash "$mc_get" "${mc_args[@]}"
  fi
  printf '%s\n' "metacomputer setup: this plugin copy has no get.sh of its own (update the plugin: claude plugin update metacomputer@metacomputer, or codex plugin marketplace upgrade metacomputer)." \
    "Or set it up in Terminal: curl -fsSL https://raw.githubusercontent.com/metavert-io/metacomputer/main/get.sh | bash" >&2
  exit 1
fi
printf '%s\n' "metacomputer: this is the metacomputer plugin's launcher, and this Mac has no metacomputer set up yet." \
  "Set it up from here (it says what it will do and asks first; macOS on Apple silicon; it builds the VM):" \
  "  $mc_self setup" \
  "or in Terminal: curl -fsSL https://raw.githubusercontent.com/metavert-io/metacomputer/main/get.sh | bash" \
  "or point MCOMP_HOME at an existing checkout. Setup adds metacomputer's MCP server to each coding agent on this" \
  "Mac; start a new session afterwards (in Claude Code, a restart or /mcp) to load its tools." >&2
exit 1
