#!/bin/bash
# metacomputer on Fly Sprites: the Sprites service "desktop" (root, through sudo; needs xvfb). XFCE as the desktop
# user on its own D-Bus session, inside the session's namespaces (in-session: /.sprite covered, nothing outside
# visible), entered before anything runs as the desktop user, with a clean
# environment that carries what /etc/X11/Xsession.d/90metacomputer-env sets on a VM with a display manager
# (accessibility on, the driver's telemetry off): there's no display manager here. XFCE's autostart runs session-init
# (session.env for SSH sessions, the live view on 127.0.0.1).
set -eu
. /etc/metacomputer/sprite.env
U="${GUEST_USER:-cua}"; UID_="$(id -u "$U")"; D="${DISPLAY_NUM:-0}"
for _ in $(seq 1 100); do [ -S "/tmp/.X11-unix/X$D" ] && break; sleep 0.1; done
[ -S "/tmp/.X11-unix/X$D" ] || { echo "svc-desktop: no X server on :$D" >&2; exit 1; }
install -d -o "$U" -g "$U" -m 0700 "/run/user/$UID_"
exec /opt/metacomputer/sprite/in-session runuser -u "$U" -- env -i \
  HOME="/home/$U" USER="$U" LOGNAME="$U" SHELL=/bin/bash PATH=/usr/local/bin:/usr/bin:/bin \
  LANG=en_US.UTF-8 DISPLAY=":$D" XAUTHORITY="/home/$U/.Xauthority" XDG_RUNTIME_DIR="/run/user/$UID_" \
  XDG_SESSION_TYPE=x11 XDG_CURRENT_DESKTOP=XFCE XDG_SESSION_DESKTOP=xfce \
  GTK_MODULES=gail:atk-bridge NO_AT_BRIDGE=0 GNOME_ACCESSIBILITY=1 QT_ACCESSIBILITY=1 \
  QT_LINUX_ACCESSIBILITY_ALWAYS_ON=1 SAL_USE_VCLPLUGIN=gtk3 MOZ_ENABLE_WAYLAND=0 \
  CUA_DRIVER_RS_TELEMETRY_ENABLED=0 CUA_DRIVER_RS_UPDATE_CHECK=0 CUA_TELEMETRY_ENABLED=0 \
  /usr/bin/dbus-run-session -- /usr/bin/xfce4-session
