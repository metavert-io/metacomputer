#!/bin/bash
# metacomputer on Fly Sprites: the Sprites service "session" (root, through sudo; services run as `sprite`). It makes
# the namespaces everything of the desktop's and SSH's runs in, and keeps them while it runs:
#   - a mount namespace where an empty tmpfs covers /.sprite (hide-sprite-api): the Sprite's API socket there is
#     world-writable, and anything that reaches it can make a service that runs with root;
#   - a PID namespace with its own /proc, so a process in it sees no process outside it: /proc/PID/root of a process in
#     the Sprite's own namespaces (where /.sprite isn't covered) can't be reached from inside, by any account.
# tini is the namespace's init (it reaps what's orphaned there); a sleep keeps it running. sshd, the X server and the
# desktop join these namespaces (in-session) before anything runs as the desktop's account: nothing of the desktop's
# account ever runs outside them. Its pid, for in-session, in /run/metacomputer/session.pid.
# metacomputer's command-line rules (scripts/strictargs.sh; this runs in the VM on its own, so they're here):
# exactly -h or --help shows the usage; an option, anything shaped like one, or a form it doesn't take is
# refused (exit 2), and nothing is done.
mc_usage="svc-session (no arguments: a Sprite service)"
case "$*" in -h|--help) echo "usage: $mc_usage"; exit 0 ;; esac
for mc_a in "$@"; do case "$mc_a" in -*) echo "svc-session: usage: $mc_usage (nothing was run)" >&2; exit 2 ;; esac; done
case "$#:${1:-}" in 0:) ;; *) echo "svc-session: usage: $mc_usage (nothing was run)" >&2; exit 2 ;; esac
# end of the command-line rules
set -eu
install -d -o root -g root -m 0755 /run/metacomputer
echo "$$" > /run/metacomputer/session.pid
exec unshare --mount --pid --fork --propagation private --mount-proc -- \
  /opt/metacomputer/sprite/hide-sprite-api /usr/bin/tini -- /usr/bin/sleep infinity
