#!/bin/sh
# guest-firewall: the firewall of a metacomputer computer that isn't on the user's Mac (an Ubuntu VM reached over
# the internet: your own server, or one a provider made). On the Mac, the gateway (mcomp-netgw) is the boundary;
# here the computer itself enforces it, with one nftables table, inet metacomputer, that nothing else writes.
#
#   guest-firewall apply      load the rules for /etc/metacomputer/egress (metacomputer-firewall.service, at boot,
#                             before the network; metacomputer-admin egress, when the setting changes)
#   guest-firewall render [--egress internet|off] [--uids "resolve=N network=N timesync=N apt=N"]
#                             print the rules (what apply loads; the tests render them on the Mac)
#   guest-firewall status     the table as loaded
#
# Inbound: SSH (port 22) only, from anywhere; the provider's own firewall may narrow it. Nothing else listens
# outside: the live view (x11vnc) binds 127.0.0.1 and is reached through an SSH tunnel.
# Outbound, for every account (root and the desktop user alike):
#   - never the cloud's metadata services or any other link-local address (169.254.0.0/16, fe80::/10; that holds
#     169.254.169.254, the metadata address of every major cloud, OCI's DNS and its DHCP), nor a private, shared,
#     loopback-but-not-lo, documentation, multicast or reserved range (10/8, 172.16/12, 192.168/16, 100.64/10, fc00::/7
#     including OCI's IPv6 metadata fd00:c1::a9fe:a9fe, ...): no reaching the provider's internal network, the
#     user's home network or a tailnet;
#   - the exceptions are the system services that need the cloud's own addresses, each to its one port: the DNS
#     resolver (systemd-resolved, port 53), the DHCP client (systemd-networkd, 67/547) and the clock (chrony or
#     timesyncd, 123), matched by their accounts;
#   - EGRESS=internet (the default): the rest of the internet is open; EGRESS=off: nothing else leaves, except
#     package downloads (APT's _apt account), so security updates keep coming.
# The desktop user's programs reach DNS through the local resolver (127.0.0.53), so names resolve under both.
set -eu
PATH=/usr/sbin:/usr/bin:/sbin:/bin
CONF=/etc/metacomputer/egress
TABLE=metacomputer

private4="0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8, 169.254.0.0/16, 172.16.0.0/12, 192.0.0.0/24, 192.0.2.0/24, 192.168.0.0/16, 198.18.0.0/15, 198.51.100.0/24, 203.0.113.0/24, 224.0.0.0/3"
private6="::/127, ::ffff:0:0/96, 64:ff9b::/96, 64:ff9b:1::/48, 100::/64, 2001:db8::/32, fc00::/7, fe80::/10, ff00::/8"

uid_of() { id -u "$1" 2>/dev/null || true; }
system_uids() { # "resolve=N network=N timesync=N apt=N": the accounts the exceptions are for, as this system has them
  r="$(uid_of systemd-resolve)"; n="$(uid_of systemd-network)"; a="$(uid_of _apt)"
  t="$(uid_of _chrony)"; [ -n "$t" ] || t="$(uid_of systemd-timesync)"
  printf 'resolve=%s network=%s timesync=%s apt=%s' "$r" "$n" "$t" "$a"
}
pick() { # KEY "k=v k=v": the value, if it's a number
  for kv in $2; do
    case "$kv" in "$1="*) v="${kv#*=}"; case "$v" in ''|*[!0-9]*) ;; *) printf '%s' "$v" ;; esac ;; esac
  done
}

render() { # EGRESS UIDS
  egress="$1"; uids="$2"
  case "$egress" in internet|off) ;; *) echo "guest-firewall: egress must be internet or off, not '$egress'" >&2; exit 2 ;; esac
  r="$(pick resolve "$uids")"; n="$(pick network "$uids")"; t="$(pick timesync "$uids")"; a="$(pick apt "$uids")"
  cat <<EOF
# metacomputer guest firewall (guest-firewall render; EGRESS=$egress)
table inet $TABLE
delete table inet $TABLE
table inet $TABLE {
	set private4 {
		type ipv4_addr
		flags interval
		elements = { $private4 }
	}
	set private6 {
		type ipv6_addr
		flags interval
		elements = { $private6 }
	}
	chain input {
		type filter hook input priority filter; policy drop;
		iif "lo" accept
		ct state established,related accept
		ct state invalid drop
		meta l4proto icmp icmp type { echo-request, destination-unreachable, time-exceeded, parameter-problem } accept
		meta l4proto ipv6-icmp accept
		udp dport 68 accept comment "DHCP replies"
		udp dport 546 accept comment "DHCPv6 replies"
		tcp dport 22 accept comment "SSH, key only (sshd)"
	}
	chain output {
		type filter hook output priority filter; policy accept;
		oif "lo" accept
		ct state established,related accept
		meta l4proto ipv6-icmp icmpv6 type { nd-router-solicit, nd-neighbor-solicit, nd-neighbor-advert, mld-listener-report, mld2-listener-report } accept comment "IPv6 neighbour discovery"
EOF
  [ -z "$r" ] || printf '\t\tmeta skuid %s meta l4proto { tcp, udp } th dport 53 accept comment "the DNS resolver"\n' "$r"
  [ -z "$n" ] || printf '\t\tmeta skuid %s meta l4proto udp th dport { 67, 547 } accept comment "the DHCP client"\n' "$n"
  [ -z "$t" ] || printf '\t\tmeta skuid %s meta l4proto udp th dport 123 accept comment "the clock"\n' "$t"
  printf '\t\tip daddr @private4 counter reject comment "metadata, link-local and private ranges"\n'
  printf '\t\tip6 daddr @private6 counter reject comment "metadata, link-local and private ranges"\n'
  if [ "$egress" = off ]; then
    [ -z "$a" ] || printf '\t\tmeta skuid %s meta l4proto tcp th dport { 80, 443 } accept comment "package downloads"\n' "$a"
    printf '\t\tcounter reject comment "EGRESS=off"\n'
  fi
  printf '\t}\n}\n'
}

case "${1:-}" in
  apply)
    egress="$(head -n 1 "$CONF" 2>/dev/null | tr -d ' \t\r' || true)"; [ -n "$egress" ] || egress=internet
    tmp="$(mktemp /run/metacomputer-firewall.XXXXXX)"
    render "$egress" "$(system_uids)" > "$tmp"
    nft -c -f "$tmp" || { rm -f "$tmp"; echo "guest-firewall: the rules don't load; the previous ones stay" >&2; exit 1; }
    nft -f "$tmp"; rm -f "$tmp"
    echo "guest-firewall: EGRESS=$egress loaded" ;;
  render)
    shift; egress=internet; uids=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --egress) egress="${2:-}"; shift ;;
        --uids) uids="${2:-}"; shift ;;
        *) echo "usage: guest-firewall render [--egress internet|off] [--uids LIST]" >&2; exit 2 ;;
      esac
      shift
    done
    [ -n "$uids" ] || uids="$(system_uids)"
    render "$egress" "$uids" ;;
  status) nft list table inet "$TABLE" ;;
  *) echo "usage: guest-firewall apply | render [--egress internet|off] [--uids LIST] | status" >&2; exit 2 ;;
esac
