#!/bin/sh
# desktop-record start NAME [FPS] [QUALITY] [AUDIO] | stream NAME [FPS] [QUALITY] [AUDIO] | stop | status
# Whole-desktop recording of the guest's X display (ffmpeg x11grab, visible
# pointer). Independent of who drives the desktop, so it captures any task.
#   start   an MP4 in ~/metacomputer-runs/manual/; the host copies it at stop
#           (`metacomputer record stop`) or with `metacomputer recordings --sync`.
#   stream  Matroska video on stdout, for the host to save as it arrives
#           (RECORD_TO=host): nothing builds up on the VM's disk. `stop` ends it.
# QUALITY: standard (small files, enough to see what happened) or high (sharp
# enough to edit into videos; several times larger).
# AUDIO: auto (include the VM's sound when it has the virtual sound card,
# VIRTUAL_AUDIO=on; nothing else is ever captured) or off (video only, the default).
set -eu
RUN="/run/user/$(id -u)/metacomputer"
DIR="$HOME/metacomputer-runs/manual"
PIDF="$RUN/desktop-record.pid"
CUR="$RUN/desktop-record.current"
mkdir -p "$DIR"

alive() { [ -s "$PIDF" ] && kill -0 "$(cat "$PIDF")" 2>/dev/null; }

setup() { # NAME FPS QUALITY AUDIO -> sets NAME FPS SIZE ENC VQ AIN AENC; loads the session's DISPLAY
  NAME="$1"; FPS="${2:-20}"; QUALITY="${3:-standard}"; AUDIO="${4:-off}"
  case "$NAME" in ''|*[!A-Za-z0-9._-]*) echo "bad name: $NAME" >&2; exit 2;; esac
  case "$FPS" in ''|*[!0-9]*) echo "bad fps: $FPS" >&2; exit 2;; esac
  [ "$FPS" -ge 1 ] && [ "$FPS" -le 60 ] || { echo "fps must be 1-60" >&2; exit 2; }
  case "$QUALITY" in
    standard) ENC="-preset veryfast -crf 26" ;;
    # Lower CRF for sharp text and thin lines, a keyframe every 2 s so editors
    # can cut and seek anywhere quickly.
    high) ENC="-preset veryfast -crf 16 -g $((FPS * 2))" ;;
    *) echo "quality must be standard or high" >&2; exit 2 ;;
  esac
  case "$AUDIO" in auto|off) ;; *) echo "audio must be auto or off" >&2; exit 2 ;; esac
  if alive; then echo "already recording: $(cat "$CUR")" >&2; exit 1; fi
  [ -s "$RUN/session.env" ] || { echo "desktop session not up" >&2; exit 3; }
  set -a; . "$RUN/session.env"; set +a
  SIZE="$(xdpyinfo 2>/dev/null | awk '/dimensions:/{print $2; exit}')"
  SIZE="${SIZE:-1920x1080}"
  # Sound: only the virtual sound card's own output (the null sink's monitor).
  VQ=""; AIN=""; AENC=""; WITH=""
  if [ "$AUDIO" = auto ] && command -v pactl >/dev/null 2>&1 \
     && pactl list short sinks 2>/dev/null | awk '$2 == "metacomputer" {f = 1} END {exit !f}'; then
    VQ="-thread_queue_size 512"
    AIN="-thread_queue_size 2048 -f pulse -sample_rate 48000 -channels 2 -i metacomputer.monitor"
    # The pulse input's timestamps run ahead of x11grab's: with a flash and a beep
    # on the same frame, the beep landed 55-144 ms early (median about 86 ms over
    # 13 takes; steady within a take, different between takes). Delaying the sound
    # 90 ms centres it: expect sound within about 50 ms of the picture.
    AENC="-af adelay=90:all=1 -c:a aac -b:a 192k"
    WITH=", with sound"
  fi
}

case "${1:-status}" in
  start)
    setup "${2:-}" "${3:-}" "${4:-}" "${5:-}"
    OUT="$DIR/$NAME.mp4"
    # shellcheck disable=SC2086
    nohup ffmpeg -hide_banner -loglevel error -nostdin -y \
      $VQ -f x11grab -draw_mouse 1 -framerate "$FPS" -video_size "$SIZE" -i "$DISPLAY" $AIN \
      -c:v libx264 $ENC -pix_fmt yuv420p $AENC -movflags +faststart \
      "$OUT" > "$DIR/$NAME.ffmpeg.log" 2>&1 &
    echo $! > "$PIDF"
    echo "$OUT" > "$CUR"
    sleep 1
    alive || { echo "ffmpeg did not start:" >&2; cat "$DIR/$NAME.ffmpeg.log" >&2; exit 1; }
    echo "recording $OUT ($SIZE @ ${FPS} fps, $QUALITY$WITH)"
    ;;
  stream)
    setup "${2:-}" "${3:-}" "${4:-}" "${5:-}"
    [ -t 1 ] && { echo "stream writes video to stdout; redirect it" >&2; exit 2; }
    echo $$ > "$PIDF"          # exec keeps the PID, so stop signals ffmpeg itself
    echo "stream:$NAME" > "$CUR"
    # shellcheck disable=SC2086
    exec ffmpeg -hide_banner -loglevel error -nostdin \
      $VQ -f x11grab -draw_mouse 1 -framerate "$FPS" -video_size "$SIZE" -i "$DISPLAY" $AIN \
      -c:v libx264 $ENC -pix_fmt yuv420p $AENC -f matroska - 2> "$DIR/$NAME.ffmpeg.log"
    ;;
  stop)
    if ! alive; then rm -f "$PIDF" "$CUR"; echo "not recording"; exit 0; fi
    PID="$(cat "$PIDF")"
    kill -INT "$PID"
    i=0; while kill -0 "$PID" 2>/dev/null && [ $i -lt 60 ]; do sleep 0.5; i=$((i + 1)); done
    kill -0 "$PID" 2>/dev/null && kill -TERM "$PID"
    OUT="$(cat "$CUR")"; rm -f "$PIDF" "$CUR"
    echo "$OUT"
    ;;
  status)
    if alive; then echo "recording $(cat "$CUR")"; else echo "idle"; fi
    ;;
  *) echo "usage: desktop-record start NAME [FPS] [QUALITY] [AUDIO] | stream NAME [FPS] [QUALITY] [AUDIO] | stop | status" >&2; exit 2 ;;
esac
