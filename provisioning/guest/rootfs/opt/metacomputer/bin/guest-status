#!/usr/bin/env python3
"""guest-status: one JSON object describing the guest's readiness for
desktop automation. Runs as the automation user (host: `metacomputer status`)."""
import json, os, subprocess, time

UID = os.getuid()
RUN = f"/run/user/{UID}/metacomputer"


def sh(cmd, env=None, timeout=15):
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout, env=env)
        return p.returncode, p.stdout.strip(), p.stderr.strip()
    except Exception as e:  # noqa: BLE001 - report, never crash the probe
        return 255, "", str(e)


def session_env():
    env = dict(os.environ)
    try:
        with open(f"{RUN}/session.env") as f:
            for line in f:
                k, _, v = line.strip().partition("=")
                if k:
                    env[k] = v
        return env, True
    except OSError:
        return env, False


env, have_session = session_env()
out = {"checked_at": time.strftime("%Y-%m-%dT%H:%M:%S%z"), "hostname": os.uname().nodename}
out["lightdm"] = sh(["systemctl", "is-active", "lightdm"])[1]
out["xorg_running"] = sh(["pgrep", "-x", "Xorg"])[0] == 0
out["xfce_session_running"] = sh(["pgrep", "-u", str(UID), "-x", "xfce4-session"])[0] == 0
out["session_env_published"] = have_session
try:
    out["session_ready_at"] = open(f"{RUN}/session-ready").read().strip()
except OSError:
    out["session_ready_at"] = None

if have_session:
    out["display"] = env.get("DISPLAY")
    rc, so, _ = sh(["xrandr", "--current"], env=env)
    cur = [l for l in so.splitlines() if "*" in l]
    out["resolution"] = cur[0].split()[0] if cur else None
    rc, so, _ = sh(["xprop", "-root", "_NET_ACTIVE_WINDOW"], env=env)
    wid = so.split()[-1] if rc == 0 and so else None
    out["active_window_id"] = wid
    if wid and wid not in ("0x0", "0"):
        rc, so, _ = sh(["xprop", "-id", wid, "_NET_WM_NAME"], env=env)
        out["active_window_title"] = so.split("=", 1)[1].strip().strip('"') if "=" in so else None
    rc, so, _ = sh(["wmctrl", "-l"], env=env)
    out["windows"] = [l.split(None, 3)[-1] for l in so.splitlines()] if rc == 0 else []
    rc, so, se = sh(["dbus-send", "--session", "--print-reply", "--dest=org.a11y.Bus",
                     "/org/a11y/bus", "org.a11y.Bus.GetAddress"], env=env)
    out["atspi_bus"] = rc == 0 and "unix:" in so
    rc, so, _ = sh(["gsettings", "get", "org.gnome.desktop.interface", "toolkit-accessibility"], env=env)
    out["toolkit_accessibility"] = so == "true"
    # VIRTUAL_AUDIO=on: the null sink that apps play into and recordings capture.
    rc, so, _ = sh(["pactl", "list", "short", "sinks"], env=env)
    out["virtual_audio"] = rc == 0 and any(l.split("\t")[1:2] == ["metacomputer"] for l in so.splitlines())
    rc, so, se = sh(["/usr/local/bin/cua-driver", "doctor"], env=env, timeout=60)
    out["driver_doctor_rc"] = rc
    out["driver_doctor"] = (so + ("\n" + se if se else ""))[-4000:]

# The secrets fill account (VMs built before it have none: `metacomputer secrets` needs a rebuild).
def fill_account():
    import pwd
    try:
        pw = pwd.getpwnam("mcfill")
    except KeyError:
        return {"present": False}

    def root_only(p):
        try:
            st = os.stat(p)
        except OSError:
            return False
        return st.st_uid == 0 and not st.st_mode & 0o022
    return {"present": True, "shell": pw.pw_shell, "home_root_owned": root_only(pw.pw_dir),
            "script_root_owned": root_only("/opt/metacomputer/bin/secret-fill"),
            "keys_root_owned": root_only("/etc/ssh/metacomputer-fill/authorized_keys")}


out["secrets_fill"] = fill_account()
rc, so, _ = sh(["/usr/local/bin/cua-driver", "--version"])
out["driver_version"] = so.splitlines()[0] if so else None
out["x11vnc_running"] = sh(["pgrep", "-u", str(UID), "-x", "x11vnc"])[0] == 0
out["uinput_writable"] = os.access("/dev/uinput", os.W_OK)
out["uptime_s"] = float(open("/proc/uptime").read().split()[0])
out["loadavg"] = open("/proc/loadavg").read().split()[:3]
mem = {l.split(":")[0]: int(l.split()[1]) for l in open("/proc/meminfo")}
out["mem_available_mb"] = mem.get("MemAvailable", 0) // 1024
st = os.statvfs("/")
out["disk_free_gb"] = round(st.f_bavail * st.f_frsize / 2**30, 1)
out["reboot_required"] = os.path.exists("/var/run/reboot-required")
out["ready"] = bool(out["xorg_running"] and out["xfce_session_running"] and have_session
                   and out.get("atspi_bus"))
print(json.dumps(out, indent=2))
