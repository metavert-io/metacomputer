#!/bin/sh
# input-reset [--check]: remove the virtual master pointer/keyboard pairs
# ("CUA v1.…") that Cua Driver's background input route leaves in the X
# session (it keeps them between actions). While one exists, Google Chrome
# ignores all keyboard input, and Firefox has been seen ignoring a person's
# mouse and keyboard in the live view. Removing them fixes both at once; their
# slaves are left floating. A driver process that held a pair has to restart
# before its next background input (the host's hub reconnects it: its next
# pointer action through the removed pair would end it).
# --check only counts them. Prints the number found (and removed).
S=/opt/metacomputer/bin/session-run
command -v xinput >/dev/null || { echo "xinput not installed" >&2; exit 2; }
ids=$($S xinput list --short 2>/dev/null | LC_ALL=C.UTF-8 grep -E 'CUA v1\.[^[]*pointer[[:space:]]+id=[0-9]+[[:space:]]+\[master pointer' | grep -o 'id=[0-9]*' | cut -d= -f2)
n=0; for id in $ids; do n=$((n + 1)); done
if [ "${1:-}" != "--check" ]; then
  for id in $ids; do $S xinput remove-master "$id" 2>/dev/null; done
fi
echo "$n"
