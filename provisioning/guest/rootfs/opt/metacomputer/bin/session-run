#!/bin/sh
# session-run CMD [ARGS...]: run a command inside the automation user's
# desktop session environment (DISPLAY, XAUTHORITY, D-Bus/AT-SPI bus).
# Used by the host's lifecycle and diagnostic commands over SSH.
# metacomputer's command-line rules (scripts/strictargs.sh; this runs in the VM on its own, so they're here):
# exactly -h or --help shows the usage; an option, anything shaped like one, or no program is
# refused (exit 2), and nothing is done.
mc_usage="session-run CMD [ARGS...]"
case "$*" in -h|--help) echo "usage: $mc_usage"; exit 0 ;; esac
case "${1:-}" in ''|-*) echo "session-run: usage: $mc_usage (nothing was run)" >&2; exit 2 ;; esac
RUN="/run/user/$(id -u)/metacomputer"
if [ ! -s "$RUN/session.env" ]; then
  echo "metacomputer: the desktop session is not up (no $RUN/session.env)" >&2
  exit 3
fi
set -a
. "$RUN/session.env"
set +a
export CUA_DRIVER_RS_TELEMETRY_ENABLED=0 CUA_TELEMETRY_ENABLED=0 CUA_DRIVER_RS_UPDATE_CHECK=0
exec "$@"
