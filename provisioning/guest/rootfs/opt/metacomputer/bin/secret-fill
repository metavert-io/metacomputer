#!/usr/bin/python3 -I
"""secret-fill: the VM side of `metacomputer secrets fill`.

It runs as the fill account (mcfill), and only this program can: sshd forces it for
that account (/etc/ssh/sshd_config.d/15-metacomputer-fill.conf), whose key only the
vault on the Mac holds. The account has no password, no shell rc files, a root-owned
home and no TTY or forwarding; this file is root-owned. So the desktop account, which
the agent can use, can't change the program, read its input or alter its environment.

Request on stdin (one JSON line):
  {"mode": "fill" | "check", "field": "password" | "username" | "otp" | "text",
   "origins": ["https://example.com"], "profile": NAME or null, "selector": CSS or null,
   "value": "..."}                                  # value only when mode is "fill"
Result on stdout (one JSON line):
  {"ok": true, "mode": "fill", "field": "password", "origin": "https://example.com", "chars": 16}
  {"ok": false, "denied": true, "reason": "..."}     # denied: a check refused it
  {"ok": false, "denied": false, "reason": "..."}    # it couldn't be done

Finding Chrome: its DevTools listens on 127.0.0.1. The fill account can't read the
desktop user's profile folders, so it reads the TCP listeners on loopback owned by the
desktop user (/proc/net/tcp, tcp6; that user comes from the root-owned
/etc/metacomputer/fill.conf, and without it nothing is filled) and asks each for
/json/version, which Chrome's DevTools answers. For a named profile, it asks each browser
for its command line (SystemInfo.getInfo, then other routes) and reads --user-data-dir.
These are the listener's own answers: a program running as the desktop user could pose
as Chrome (SECURITY.md), which nothing here can rule out.

The checks use the browser's view, not the page's own scripts: frame origins come from
Page.getFrameTree and must match self.origin inside each frame's isolated world, and the
focused element is found frame by frame in isolated worlds (Page.createIsolatedWorld;
DOM.describeNode gives the frame behind a focused <iframe>), so page script can't redefine
document.activeElement, self.origin or an input's type. The value is typed into that very
element inside its own document (execCommand insertText from the isolated world), after
confirming the frames still hold the same documents (loaderId); a navigation in between
makes the call fail rather than type elsewhere. An overall deadline stops it lingering.

The value is never printed, logged or written to disk. Python 3 standard library only.
Options for the tests only (sshd runs it without arguments):
  --proc-net FILE (repeatable)  --desktop-uid N  --proc-root DIR  --deadline SECONDS
"""
import base64
import hashlib
import http.client
import json
import os
import pwd
import re
import signal
import socket
import struct
import sys
import urllib.parse

NAME_RE = re.compile(r"^[A-Za-z0-9._][A-Za-z0-9._-]{0,63}$")
WS_GUID = "258EAFA5-E914-47DA-95CA-C5AB0DC85B11"
CONF = "/etc/metacomputer/fill.conf"
TIMEOUT = 10
WORLD = "metacomputer-secret-fill"

# Which elements a field may go into.
FIELD_INPUT_TYPES = {
    "password": {"password"},
    "username": {"text", "email", "tel"},
    "otp": {"text", "tel", "number"},
}
TEXT_INPUT_TYPES = {"text", "email", "tel", "search", "url", "password", "number"}
FIELDS = ("password", "username", "otp", "text")
BROWSERS = ("Chrome", "HeadlessChrome", "Chromium")


class Denied(Exception):
    """A check refused the fill."""


class Failed(Exception):
    """The fill couldn't be done."""


# --- pure helpers (unit-tested on the Mac: tests/test_secret_fill.py) -----------------
def parse_origin(url):
    """'https://Example.com:443/a?b' -> 'https://example.com'. None when it has no http(s) origin."""
    if not isinstance(url, str):
        return None
    try:
        u = urllib.parse.urlsplit(url.strip())
        port = u.port
    except ValueError:
        return None
    scheme = u.scheme.lower()
    host = (u.hostname or "").lower()
    if scheme not in ("http", "https") or not host:
        return None
    if ":" in host:
        host = "[" + host + "]"
    default = 443 if scheme == "https" else 80
    return scheme + "://" + host + ("" if port in (None, default) else ":" + str(port))


def origin_allowed(origin, allowed):
    o = parse_origin(origin) if origin else None
    return bool(o) and o in {parse_origin(a) for a in allowed}


def field_fits(field, info):
    """(True, "") when the focused element suits the field, else (False, why)."""
    tag = str(info.get("tag") or "").lower()
    typ = str(info.get("type") or "").lower()
    what = "<" + tag + (" type=" + typ if typ and tag == "input" else "") + ">" if tag else "nothing"
    if tag in ("", "body", "html"):
        return False, "no field is focused in the page; click into the field first"
    if info.get("disabled") or info.get("readonly"):
        return False, "the focused field is read-only or disabled"
    if field == "text":
        if tag == "textarea" or (tag == "input" and typ in TEXT_INPUT_TYPES):
            return True, ""
        return False, "the focused element is " + what + ", not a text field"
    want = FIELD_INPUT_TYPES.get(field)
    if want is None:
        return False, "unknown field " + str(field)
    if tag == "input" and typ in want:
        return True, ""
    return False, ("the focused element is " + what + ", not a " + field + " field (needs <input type="
                   + "|".join(sorted(want)) + ">)")


def utf16_len(s):
    return len(s.encode("utf-16-le")) // 2


def loopback_hex(ip_hex):
    """True for 127.0.0.0/8, ::1 and ::ffff:127.x as /proc/net/tcp{,6} print them (host-order words)."""
    try:
        raw = bytes.fromhex(ip_hex)
    except ValueError:
        return False
    if len(raw) == 4:
        return raw[::-1][0] == 127
    if len(raw) == 16:
        a = b"".join(raw[i:i + 4][::-1] for i in range(0, 16, 4))
        return a == bytes(15) + b"\x01" or (a[:12] == bytes(10) + b"\xff\xff" and a[12] == 127)
    return False


def tcp_listeners(texts, uid):
    """Ports listening on loopback, from the text of /proc/net/tcp and tcp6, owned by uid (any when None)."""
    ports = []
    for text in texts:
        for line in text.splitlines()[1:]:
            f = line.split()
            if len(f) < 10 or f[3] != "0A":          # 0A = LISTEN
                continue
            if uid is not None and f[7] != str(uid):
                continue
            ip_hex, _, port_hex = f[1].partition(":")
            if not loopback_hex(ip_hex):
                continue
            try:
                port = int(port_hex, 16)
            except ValueError:
                continue
            if 0 < port < 65536 and port not in ports:
                ports.append(port)
    return ports


def is_devtools_version(v, port):
    """Chrome's DevTools /json/version answer for this port, else False."""
    if not isinstance(v, dict):
        return False
    browser = str(v.get("Browser", "")).split("/")[0]
    ws = str(v.get("webSocketDebuggerUrl", ""))
    return browser in BROWSERS and ws.startswith("ws://127.0.0.1:" + str(port) + "/devtools/browser/")


def user_data_dir(cmdline):
    """--user-data-dir from a /proc/PID/cmdline (NUL-separated; Chrome may rewrite it with spaces)."""
    args = cmdline.split(b"\0") if b"\0" in cmdline else cmdline.split()
    for a in args:
        a = a.decode("utf-8", "replace")
        if a.startswith("--user-data-dir="):
            return a.split("=", 1)[1]
    return None


def user_data_dir_from_string(command_line):
    """--user-data-dir from a command line as one string (SystemInfo.getInfo's commandLine)."""
    m = re.search(r'--user-data-dir=(?:"([^"]+)"|\'([^\']+)\'|(\S+))', command_line or "")
    return next((g for g in m.groups() if g), None) if m else None


def profile_name(udd):
    return os.path.basename(os.path.normpath(udd)) if udd else None


def ws_accept(key):
    return base64.b64encode(hashlib.sha1((key + WS_GUID).encode()).digest()).decode()


def ws_mask(payload, mask):
    if not payload:
        return b""
    n = len(payload)
    m = (mask * (n // 4 + 1))[:n]
    return (int.from_bytes(payload, "big") ^ int.from_bytes(m, "big")).to_bytes(n, "big")


def ws_encode_frame(opcode, payload, mask=None, fin=True):
    """A client frame (RFC 6455 5.2): masked with a random key unless one is given."""
    mask = os.urandom(4) if mask is None else mask
    b0 = (0x80 if fin else 0) | (opcode & 0x0F)
    n = len(payload)
    if n < 126:
        head = struct.pack("!BB", b0, 0x80 | n)
    elif n < 65536:
        head = struct.pack("!BBH", b0, 0x80 | 126, n)
    else:
        head = struct.pack("!BBQ", b0, 0x80 | 127, n)
    return head + mask + ws_mask(payload, mask)


def ws_decode_frame(buf):
    """(fin, opcode, payload, bytes used), or None when buf doesn't hold a whole frame yet."""
    if len(buf) < 2:
        return None
    b0, b1 = buf[0], buf[1]
    n, i = b1 & 0x7F, 2
    if n == 126:
        if len(buf) < 4:
            return None
        n, i = struct.unpack("!H", buf[2:4])[0], 4
    elif n == 127:
        if len(buf) < 10:
            return None
        n, i = struct.unpack("!Q", buf[2:10])[0], 10
    mask = None
    if b1 & 0x80:
        if len(buf) < i + 4:
            return None
        mask, i = buf[i:i + 4], i + 4
    if len(buf) < i + n:
        return None
    payload = buf[i:i + n]
    if mask:
        payload = ws_mask(payload, mask)
    return bool(b0 & 0x80), b0 & 0x0F, payload, i + n


def withheld(out, value):
    """True when any string in the result holds the value (any length)."""
    if not isinstance(value, str) or not value:
        return False
    for v in out.values():
        if isinstance(v, str) and (value in v or json.dumps(value)[1:-1] in v):
            return True
    return False


# --- a minimal WebSocket client and DevTools connection --------------------------------
class WebSocket:
    def __init__(self, url, timeout=TIMEOUT):
        u = urllib.parse.urlsplit(url)
        if u.scheme != "ws" or u.hostname != "127.0.0.1":
            raise Failed("unexpected DevTools address")
        self.sock = socket.create_connection(("127.0.0.1", u.port or 80), timeout=timeout)
        key = base64.b64encode(os.urandom(16)).decode()
        path = (u.path or "/") + ("?" + u.query if u.query else "")
        # No Origin header: Chrome accepts DevTools clients that don't send one.
        req = ("GET " + path + " HTTP/1.1\r\nHost: 127.0.0.1:" + str(u.port) + "\r\n"
               "Upgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: " + key + "\r\n"
               "Sec-WebSocket-Version: 13\r\n\r\n")
        self.sock.sendall(req.encode())
        head = b""
        while b"\r\n\r\n" not in head:
            chunk = self.sock.recv(4096)
            if not chunk:
                raise Failed("DevTools closed the connection during the handshake")
            head += chunk
            if len(head) > 65536:
                raise Failed("DevTools handshake too long")
        head, self.buf = head.split(b"\r\n\r\n", 1)
        lines = head.decode("latin-1").split("\r\n")
        if len(lines[0].split()) < 2 or lines[0].split()[1] != "101":
            raise Failed("DevTools refused the WebSocket")
        headers = {}
        for line in lines[1:]:
            k, _, v = line.partition(":")
            headers[k.strip().lower()] = v.strip()
        if headers.get("sec-websocket-accept") != ws_accept(key):
            raise Failed("bad WebSocket handshake from DevTools")

    def send_text(self, text):
        self.sock.sendall(ws_encode_frame(0x1, text.encode("utf-8")))

    def _frame(self):
        while True:
            f = ws_decode_frame(self.buf)
            if f:
                self.buf = self.buf[f[3]:]
                return f
            chunk = self.sock.recv(65536)
            if not chunk:
                raise Failed("DevTools closed the connection")
            self.buf += chunk
            if len(self.buf) > (64 << 20):
                raise Failed("DevTools message too large")

    def recv_text(self):
        parts, started = [], False
        while True:
            fin, op, payload, _ = self._frame()
            if op == 0x9:                       # ping -> pong
                self.sock.sendall(ws_encode_frame(0xA, payload))
                continue
            if op == 0xA:
                continue
            if op == 0x8:
                raise Failed("DevTools closed the connection")
            if op in (0x1, 0x2):
                parts, started = [payload], True
            elif op == 0x0 and started:
                parts.append(payload)
            else:
                continue
            if fin:
                return b"".join(parts).decode("utf-8", "replace")

    def close(self):
        try:
            self.sock.sendall(ws_encode_frame(0x8, b""))
        except OSError:
            pass
        try:
            self.sock.close()
        except OSError:
            pass


def _script_error(r):
    d = r.get("exceptionDetails") or {}
    desc = str((d.get("exception") or {}).get("description") or d.get("text") or "script error")
    return desc.splitlines()[0][:160]


class DevTools:
    def __init__(self, ws_url, timeout=TIMEOUT):
        self.ws = WebSocket(ws_url, timeout=timeout)
        self.next_id = 0

    def call(self, method, params=None, quiet=False):
        """Send a command and wait for its answer (events in between are skipped).
        quiet: never put the protocol's error text in a message (for calls that carry the value)."""
        self.next_id += 1
        mid = self.next_id
        self.ws.send_text(json.dumps({"id": mid, "method": method, "params": params or {}}))
        while True:
            msg = json.loads(self.ws.recv_text())
            if msg.get("id") != mid:
                continue
            if "error" in msg:
                if quiet:
                    raise Failed(method + " failed")
                raise Failed(method + " failed: " + str((msg["error"] or {}).get("message", ""))[:120])
            return msg.get("result") or {}

    def value(self, expression, ctx=None):
        p = {"expression": expression, "returnByValue": True}
        if ctx is not None:
            p["contextId"] = ctx
        r = self.call("Runtime.evaluate", p)
        if r.get("exceptionDetails"):
            raise Failed("the page refused a check: " + _script_error(r))
        return (r.get("result") or {}).get("value")

    def object(self, expression, ctx):
        r = self.call("Runtime.evaluate", {"expression": expression, "returnByValue": False, "contextId": ctx})
        if r.get("exceptionDetails"):
            raise Failed("the page refused a check: " + _script_error(r))
        res = r.get("result") or {}
        return res.get("objectId") if res.get("subtype") != "null" else None

    def on(self, object_id, function, args=None, quiet=False):
        """Run a function with `this` = the object, in the object's own (isolated) world.
        quiet: for calls that carry the value (no error text from the page or the protocol)."""
        p = {"objectId": object_id, "functionDeclaration": function, "returnByValue": True}
        if args is not None:
            p["arguments"] = [{"value": a} for a in args]
        r = self.call("Runtime.callFunctionOn", p, quiet=quiet)
        if r.get("exceptionDetails"):
            raise Failed("the page refused the fill" if quiet else "the page refused a check: " + _script_error(r))
        return (r.get("result") or {}).get("value")

    def close(self):
        self.ws.close()


# Run only in isolated worlds, where page script can't reach.
DEEP_ACTIVE = r"""/*mcomp:deep-active*/(function () {
  let el = document.activeElement;
  for (let i = 0; el && i < 32 && el.shadowRoot && el.shadowRoot.activeElement; i++) el = el.shadowRoot.activeElement;
  return (el && el !== document.body && el !== document.documentElement) ? el : null;
})()"""

DESCRIBE = r"""/*mcomp:describe*/function () {
  const tag = (this.tagName || '').toLowerCase();
  return { tag: tag, type: tag === 'input' ? String(this.type || '').toLowerCase() : '',
           readonly: !!this.readOnly, disabled: !!this.disabled, autocomplete: String(this.autocomplete || '') };
}"""

SELECT = r"""/*mcomp:select*/function () {
  try {
    if (typeof this.focus === 'function') this.focus();
    if (typeof this.select === 'function') this.select();
  } catch (e) {}
  return true;
}"""

VALUE_LENGTH = r"""/*mcomp:value-length*/function () { return (typeof this.value === 'string') ? this.value.length : -1; }"""

# Types the text into this very element, in one step inside its own document: it must
# still be the focused element there, and nothing can navigate between the check and the
# insertion (a navigation destroys this world and the call fails instead). execCommand's
# insertText fires the same beforeinput/input events as typing.
INSERT = r"""/*mcomp:insert*/function (text) {
  const doc = this.ownerDocument;
  let a = doc.activeElement;
  for (let i = 0; a && i < 32 && a.shadowRoot && a.shadowRoot.activeElement; i++) a = a.shadowRoot.activeElement;
  if (a !== this) return { done: false, focus: false };
  try { if (typeof this.select === 'function') this.select(); } catch (e) {}
  let ok = false;
  try { ok = doc.execCommand('insertText', false, text); } catch (e) { ok = false; }
  return { done: !!ok, focus: true };
}"""

IS_FOCUSED = r"""/*mcomp:is-focused*/function () {
  let a = this.ownerDocument.activeElement;
  for (let i = 0; a && i < 32 && a.shadowRoot && a.shadowRoot.activeElement; i++) a = a.shadowRoot.activeElement;
  return a === this;
}"""

FRAME_ORIGIN = "/*mcomp:frame-origin*/self.origin"


def focus_selector_js(selector):
    return ("/*mcomp:focus-selector*/(function (sel) { let l; try { l = document.querySelectorAll(sel); }"
            " catch (e) { return -1; } if (l.length !== 1) return l.length; l[0].focus(); return 1; })("
            + json.dumps(selector) + ")")


# --- finding the driver's Chrome ------------------------------------------------------
def desktop_uid():
    """The desktop user's uid, from the root-owned /etc/metacomputer/fill.conf (None: unknown,
    and run() then refuses: without it, any user's listener could pose as Chrome)."""
    try:
        with open(CONF) as f:
            for line in f:
                k, _, v = line.strip().partition("=")
                if k == "desktop_user" and v:
                    return pwd.getpwnam(v).pw_uid
    except (OSError, KeyError):
        pass
    return None


def http_json(port, path, timeout=1.5):
    conn = http.client.HTTPConnection("127.0.0.1", port, timeout=timeout)
    try:
        conn.request("GET", path, headers={"Host": "127.0.0.1:" + str(port)})
        r = conn.getresponse()
        if r.status != 200:
            return None
        return json.loads(r.read(1 << 20).decode("utf-8", "replace"))
    except (OSError, ValueError, http.client.HTTPException):
        return None
    finally:
        conn.close()


def devtools_endpoints(opts):
    """[(port, browser WebSocket URL)] for Chrome DevTools listeners on loopback."""
    texts = []
    for p in opts["proc_net"]:
        try:
            with open(p) as f:
                texts.append(f.read())
        except OSError:
            pass
    out = []
    for port in tcp_listeners(texts, opts["uid"]):
        v = http_json(port, "/json/version")
        if is_devtools_version(v, port):
            out.append((port, v["webSocketDebuggerUrl"]))
    return out


def _why(e):
    return (type(e).__name__ + (": " + str(e) if str(e) else ""))[:90]


def profile_of(browser_ws, proc_root):
    """(profile folder name or None, notes) for the Chrome behind this DevTools endpoint.
    All three routes are the browser's own answers (it could lie, like any program on
    that port; SECURITY.md). 1. SystemInfo.getInfo's commandLine. 2. SystemInfo.getProcessInfo's
    browser pid, then /proc/PID/cmdline. 3. Browser.getBrowserCommandLine (only with
    --enable-automation, which the driver doesn't pass). Notes say why a route gave nothing."""
    notes = []
    try:
        dt = DevTools(browser_ws, timeout=8)
    except (Failed, OSError) as e:
        return None, ["connect: " + _why(e)]
    try:
        try:
            udd = user_data_dir_from_string(str(dt.call("SystemInfo.getInfo").get("commandLine") or ""))
            if udd:
                return profile_name(udd), notes
            notes.append("getInfo: no --user-data-dir")
        except (Failed, OSError, ValueError) as e:
            notes.append("getInfo: " + _why(e))
        try:
            procs = dt.call("SystemInfo.getProcessInfo").get("processInfo") or []
            pid = next((int(p["id"]) for p in procs if isinstance(p, dict) and p.get("type") == "browser"), None)
            if pid is None:
                notes.append("getProcessInfo: no browser process listed")
            else:
                try:
                    with open(os.path.join(proc_root, str(pid), "cmdline"), "rb") as f:
                        udd = user_data_dir(f.read())
                    if udd:
                        return profile_name(udd), notes
                    notes.append("/proc/" + str(pid) + "/cmdline: no --user-data-dir")
                except OSError as e:
                    notes.append("/proc/" + str(pid) + "/cmdline: " + _why(e))
        except (Failed, OSError, ValueError, KeyError, TypeError) as e:
            notes.append("getProcessInfo: " + _why(e))
        try:
            args = dt.call("Browser.getBrowserCommandLine").get("arguments") or []
            udd = next((a.split("=", 1)[1] for a in args if isinstance(a, str) and a.startswith("--user-data-dir=")), None)
            if udd:
                return profile_name(udd), notes
            notes.append("getBrowserCommandLine: no --user-data-dir")
        except (Failed, OSError, ValueError) as e:
            notes.append("getBrowserCommandLine: " + _why(e))
    finally:
        dt.close()
    return None, notes


def page_targets(port):
    data = http_json(port, "/json/list", timeout=TIMEOUT)
    out = []
    for t in data if isinstance(data, list) else []:
        if isinstance(t, dict) and t.get("type") == "page":
            ws = t.get("webSocketDebuggerUrl") or ("ws://127.0.0.1:" + str(port) + "/devtools/page/" + str(t.get("id")))
            out.append({"url": str(t.get("url") or ""), "ws": ws})
    return out


def choose_target(candidates):
    """One tab among several on allowed sites: the focused one, else the visible one."""
    if len(candidates) == 1:
        return candidates[0]
    states = []
    for c in candidates:
        try:
            dt = DevTools(c["ws"])
            try:
                st = dt.value("({focus: document.hasFocus(), visible: document.visibilityState === 'visible'})") or {}
            finally:
                dt.close()
        except Failed:
            st = {}
        states.append((c, st if isinstance(st, dict) else {}))
    for key in ("focus", "visible"):
        hits = [c for c, st in states if st.get(key)]
        if len(hits) == 1:
            return hits[0]
    raise Denied(str(len(candidates)) + " tabs are open on the allowed sites; close the others or bring the right one to the front")


# --- the browser's view of the page -------------------------------------------------------
class PageChanged(Exception):
    """The document changed between the checks and the typing."""


class Page:
    def __init__(self, dt, origins):
        self.dt = dt
        self.origins = origins
        self.worlds = {}
        self.top, self.frames = self.read_tree()

    def read_tree(self):
        """(top frame id, {frame id: origin, url, parent, loaderId}) from Page.getFrameTree."""
        tree = self.dt.call("Page.getFrameTree").get("frameTree") or {}
        frames = {}

        def walk(node, parent):
            f = node.get("frame") or {}
            if f.get("id"):
                frames[f["id"]] = {"origin": f.get("securityOrigin"), "url": str(f.get("url") or ""),
                                   "parent": parent, "loader": f.get("loaderId")}
            for ch in node.get("childFrames") or []:
                walk(ch, f.get("id"))
        walk(tree, None)
        return (tree.get("frame") or {}).get("id"), frames

    def same_documents(self, path):
        """The frames on the path still hold the documents (loaderId) and origins first seen."""
        _, now = self.read_tree()
        for fid in path:
            a, b = self.frames.get(fid), now.get(fid)
            if not a or not b or a["loader"] != b["loader"] or a["origin"] != b["origin"]:
                return False
        return True

    def world(self, fid):
        if fid not in self.worlds:
            try:
                r = self.dt.call("Page.createIsolatedWorld", {"frameId": fid, "worldName": WORLD})
            except Failed:
                raise Denied("the focused field is inside a frame the fill can't look into (a frame from another site)")
            self.worlds[fid] = r.get("executionContextId")
        return self.worlds[fid]

    def origin(self, fid):
        """The frame's origin. The browser's frame tree and self.origin inside the frame's
        isolated world must agree. about:srcdoc and about:blank frames, which the tree shows
        as "://", inherit their parent's: the world's self.origin must equal it."""
        f = self.frames[fid]
        tree = parse_origin(f["origin"]) if f["origin"] and f["origin"] != "://" else None
        own = parse_origin(self.dt.value(FRAME_ORIGIN, self.world(fid)) or "")
        if tree:
            return tree if own == tree else None
        if f["url"].startswith("about:") and f["parent"]:
            parent = self.origin(f["parent"])
            if own and own == parent:
                return own
        return None

    def focused(self):
        """(frame path, frame origin, element object id, backendNodeId, description) of the focused element."""
        fid, path = self.top, []
        for _ in range(8):
            if fid not in self.frames:
                raise Denied("the focused field is inside a frame the fill can't look into")
            path.append(fid)
            origin = self.origin(fid)
            if origin not in self.origins:
                if fid == self.top:
                    raise Denied("the tab is on " + str(origin or "no confirmed site (the browser and the page disagree)")
                                 + ", which isn't allowed for this secret")
                raise Denied("the focused field is inside a frame from another site (" + str(origin or "no site")
                             + "), which isn't allowed for this secret")
            ctx = self.world(fid)
            el = self.dt.object(DEEP_ACTIVE, ctx)
            if not el:
                raise Denied("no field is focused in the page; click into the field first")
            node = self.dt.call("DOM.describeNode", {"objectId": el}).get("node") or {}
            if str(node.get("nodeName", "")).upper() in ("IFRAME", "FRAME"):
                fid = node.get("frameId")
                continue
            return path, origin, el, node.get("backendNodeId"), self.dt.on(el, DESCRIBE) or {}
        raise Denied("the field is inside too many nested frames")

    def type_into(self, path, el, value):
        """Type the value into this element of these documents. Returns "element" or "keyboard"."""
        if not self.same_documents(path):
            raise Denied("the page changed after the check; nothing was typed")
        try:
            r = self.dt.on(el, INSERT, args=[value], quiet=True) or {}
        except Failed:
            raise Failed("the page changed before the fill; nothing was typed")
        if not r.get("focus"):
            raise Denied("the field lost the focus before the fill; nothing was typed")
        if r.get("done"):
            return "element"
        # The page doesn't take execCommand: type through the keyboard route instead, right
        # after confirming the same element in the same documents still has the focus.
        if not self.same_documents(path) or self.dt.on(el, IS_FOCUSED) is not True:
            raise Denied("the page changed after the check; nothing was typed")
        self.dt.call("Input.insertText", {"text": value}, quiet=True)
        return "keyboard"


# --- the fill ----------------------------------------------------------------------
def run(req, opts):
    mode = req.get("mode")
    field = req.get("field")
    origins = [o for o in (parse_origin(x) for x in req.get("origins") or []) if o]
    if mode not in ("fill", "check") or field not in FIELDS or not origins:
        raise Failed("bad request")
    value = req.get("value") if mode == "fill" else None
    if mode == "fill" and (not isinstance(value, str) or not value):
        raise Failed("bad request")
    profile = req.get("profile") or None
    selector = req.get("selector") or None
    if profile is not None and (not isinstance(profile, str) or not NAME_RE.match(profile) or profile in (".", "..")):
        raise Denied("bad profile name")
    if opts["uid"] is None:
        raise Failed("can't tell which user runs the desktop (" + CONF + "); refusing")

    endpoints = devtools_endpoints(opts)
    if not endpoints:
        raise Failed("no Chrome with DevTools is running; fills need page-mode Chrome (browser_prepare)")
    if profile:
        named, seen = [], []
        for port, ws in endpoints:
            name, notes = profile_of(ws, opts["proc_root"])
            if name == profile:
                named.append((port, ws))
            else:
                seen.append(str(port) + ": " + ("profile " + name if name else "; ".join(notes) or "unknown"))
        if not named:
            raise Failed("no Chrome is running on profile " + profile + " (" + " | ".join(seen)[:400] + ")")
        endpoints = named
    candidates = []
    for port, _ in endpoints:
        candidates += [t for t in page_targets(port) if origin_allowed(t["url"], origins)]
    if not candidates:
        raise Denied("no open tab on " + ", ".join(origins) + " in the driver's Chrome; open the site first")
    target = choose_target(candidates)

    dt = DevTools(target["ws"])
    try:
        page = Page(dt, origins)
        if not page.top:
            raise Failed("the tab has no page")
        if selector:
            n = dt.value(focus_selector_js(str(selector)[:300]), page.world(page.top))
            if n == -1:
                raise Denied("the selector isn't valid CSS. It searches the page itself, not frames or shadow roots "
                             "(there is no syntax for those): click into such a field instead")
            if n != 1:
                raise Denied("the selector matches " + str(n) + " elements, not exactly one")
        try:
            dt.call("Emulation.setFocusEmulationEnabled", {"enabled": True})   # background windows
        except Failed:
            pass
        path, frame, el, node, info = page.focused()
        top = page.origin(page.top)
        ok, why = field_fits(field, info)
        if not ok:
            raise Denied(why)
        if mode == "check":
            return {"ok": True, "mode": "check", "field": field, "origin": top, "frame_origin": frame,
                    "element": info.get("tag") + ("[type=" + info.get("type") + "]" if info.get("type") else "")}
        route = page.type_into(path, el, value)
        changed = {"ok": False, "denied": False, "origin": top,
                   "reason": "the page changed during the fill; the value may have gone elsewhere (check the page)"}
        if not page.same_documents(path):
            return changed
        try:
            path2, _, el2, node2, _ = page.focused()
        except Denied:
            return changed
        if (path2, node2) != (path, node):
            return {"ok": False, "denied": False, "origin": top,
                    "reason": "the focus moved while filling; the text may have gone to another field (check the page)"}
        n = dt.on(el2, VALUE_LENGTH)
        want = utf16_len(value)
        if n != want:
            return {"ok": False, "denied": False, "origin": top,
                    "reason": "the field holds " + str(n) + " characters, expected " + str(want)
                              + " (a length limit, or the page changed it)"}
        return {"ok": True, "mode": "fill", "field": field, "origin": top, "frame_origin": frame, "chars": want, "route": route}
    finally:
        dt.close()


def options(argv):
    opts = {"proc_net": ["/proc/net/tcp", "/proc/net/tcp6"], "uid": None, "proc_root": "/proc", "deadline": 40}
    given_net, uid_given = [], False
    i = 0
    while i < len(argv):
        a = argv[i]
        v = argv[i + 1] if i + 1 < len(argv) else None
        if a == "--proc-net" and v:
            given_net.append(v)
        elif a == "--desktop-uid" and v:
            opts["uid"], uid_given = int(v), True
        elif a == "--proc-root" and v:
            opts["proc_root"] = v
        elif a == "--deadline" and v:
            opts["deadline"] = max(1, int(v))
        else:
            raise SystemExit("usage: secret-fill [--proc-net FILE] [--desktop-uid N] [--proc-root DIR] [--deadline S] < request")
        i += 2
    if given_net:
        opts["proc_net"] = given_net
    if not uid_given:
        opts["uid"] = desktop_uid()
    return opts


def out_of_time(signum, frame):
    raise Failed("secret-fill ran out of time")


def main(argv):
    value = None
    try:
        opts = options(argv)
        # An overall deadline: never linger with the value.
        signal.signal(signal.SIGALRM, out_of_time)
        signal.alarm(opts["deadline"])
        req = json.loads(sys.stdin.buffer.read(1 << 20).decode("utf-8"))
        if not isinstance(req, dict):
            raise ValueError
        value = req.get("value")
        out = run(req, opts)
    except Denied as e:
        out = {"ok": False, "denied": True, "reason": str(e)}
    except Failed as e:
        out = {"ok": False, "denied": False, "reason": str(e)}
    except (ValueError, UnicodeDecodeError):
        out = {"ok": False, "denied": False, "reason": "bad request"}
    except Exception as e:  # noqa: BLE001 - never a traceback (it could hold the value)
        out = {"ok": False, "denied": False, "reason": "guest error: " + type(e).__name__}
    signal.alarm(0)
    if withheld(out, value):
        out = {"ok": False, "denied": False, "reason": "result withheld (it contained the value)"}
    sys.stdout.write(json.dumps(out, ensure_ascii=True, separators=(",", ":")) + "\n")
    sys.stdout.flush()


if __name__ == "__main__":
    main(sys.argv[1:])
