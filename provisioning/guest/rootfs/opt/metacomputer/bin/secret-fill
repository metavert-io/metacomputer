#!/usr/bin/python3 -I
"""secret-fill: the VM side of `metacomputer secrets fill`.

It runs as the fill account (mcfill), and only this program can: sshd forces it for
that account (/etc/ssh/sshd_config.d/15-metacomputer-fill.conf), whose key only the
vault on the Mac holds. The account has no password, no shell rc files, a root-owned
home and no TTY or forwarding; this file is root-owned. So the desktop account, which
the agent can use, can't change the program, read its input or alter its environment.

Request on stdin (one JSON line):
  {"mode": "fill" | "check", "field": "password" | "username" | "otp" | "text",
   "origins": ["https://example.com"], "profile": NAME or null, "browser_pid": PID or null,
   "selector": CSS or null, "value": "..."}         # value only when mode is "fill"
  {"mode": "read", "what": "text" | "links", "origins": [...], "selector": CSS, ...}
                                                    # a relay's source: one element's text, or its links
  {"mode": "read", "what": "total", ...}            # a purchase's total: the element's rendered text only (innerText,
                                                    # never textContent), and whether the element is shown at all
  "top_origins": [...]                              # optional, any mode: the sites the tab itself may be on; "origins"
                                                    # then names the frames' sites too (a payment form's frame), and the
                                                    # answer says "top_checked": true
  {"mode": "open", "origins": [...], "link_origin": "https://example.com", "value": URL, ...}
                                                    # a one-time sign-in link, opened in the tab on the site
Result on stdout (one JSON line):
  {"ok": true, "mode": "fill", "field": "password", "origin": "https://example.com", "chars": 16}
  {"ok": true, "mode": "read", "origin": "...", "text": "..." | "links": [...]}   # bounded: 8192 characters, 20 links
  {"ok": false, "denied": true, "reason": "..."}     # denied: a check refused it
  {"ok": false, "denied": false, "reason": "..."}    # it couldn't be done

Finding Chrome: its DevTools listens on 127.0.0.1. The fill account can't read the
desktop user's profile folders, so it reads the TCP listeners on loopback owned by the
desktop user (/proc/net/tcp, tcp6; that user comes from the root-owned
/etc/metacomputer/fill.conf, and without it nothing is filled) and asks each for
/json/version, which Chrome's DevTools answers. For a named profile, it asks each browser
for its command line (SystemInfo.getInfo, then other routes) and reads --user-data-dir;
with browser_pid, it keeps the Chrome whose browser process has that id
(SystemInfo.getProcessInfo). These are the listener's own answers: a program running as
the desktop user could pose as Chrome (SECURITY.md), which nothing here can rule out.
Among what's left, exactly one tab may be on the allowed sites: two or more are refused,
never chosen between by focus or visibility (the pages' own answers).

The checks use the browser's view, not the page's own scripts: frame origins come from
Page.getFrameTree and must match self.origin inside each frame's isolated world, and the
focused element is found frame by frame in isolated worlds (Page.createIsolatedWorld;
DOM.describeNode gives the frame behind a focused <iframe>), so page script can't redefine
document.activeElement, self.origin or an input's type. The value is typed into that very
element inside its own document (execCommand insertText from the isolated world), after
confirming the frames still hold the same documents (loaderId); a navigation in between
makes the call fail rather than type elsewhere. An overall deadline stops it lingering.

The value is never printed, logged or written to disk. Python 3 standard library only.
Options for the tests only (sshd runs it without arguments):
  --proc-net FILE (repeatable)  --desktop-uid N  --proc-root DIR  --deadline SECONDS  --land-wait SECONDS (at most 8)
"""
import base64
import hashlib
import http.client
import json
import os
import pwd
import re
import signal
import socket
import struct
import sys
import time
import urllib.parse

NAME_RE = re.compile(r"^[A-Za-z0-9._][A-Za-z0-9._-]{0,63}$")
WS_GUID = "258EAFA5-E914-47DA-95CA-C5AB0DC85B11"
CONF = "/etc/metacomputer/fill.conf"
TIMEOUT = 10
WORLD = "metacomputer-secret-fill"

# Which elements a field may go into.
FIELD_INPUT_TYPES = {
    "password": {"password"},
    "username": {"text", "email", "tel"},
    "otp": {"text", "tel", "number"},
}
TEXT_INPUT_TYPES = {"text", "email", "tel", "search", "url", "password", "number"}
FIELDS = ("password", "username", "otp", "text")
BROWSERS = ("Chrome", "HeadlessChrome", "Chromium")


class Denied(Exception):
    """A check refused the fill."""


class Failed(Exception):
    """The fill couldn't be done."""


# --- pure helpers (unit-tested on the Mac: tests/test_secret_fill.py) -----------------
def parse_origin(url):
    """'https://Example.com:443/a?b' -> 'https://example.com'. None when it has no http(s) origin."""
    if not isinstance(url, str):
        return None
    try:
        u = urllib.parse.urlsplit(url.strip())
        port = u.port
    except ValueError:
        return None
    scheme = u.scheme.lower()
    host = (u.hostname or "").lower()
    if scheme not in ("http", "https") or not host:
        return None
    if ":" in host:
        host = "[" + host + "]"
    default = 443 if scheme == "https" else 80
    return scheme + "://" + host + ("" if port in (None, default) else ":" + str(port))


def origin_allowed(origin, allowed):
    o = parse_origin(origin) if origin else None
    return bool(o) and o in {parse_origin(a) for a in allowed}


def field_fits(field, info):
    """(True, "") when the focused element suits the field, else (False, why)."""
    tag = str(info.get("tag") or "").lower()
    typ = str(info.get("type") or "").lower()
    what = "<" + tag + (" type=" + typ if typ and tag == "input" else "") + ">" if tag else "nothing"
    if tag in ("", "body", "html"):
        return False, "no field is focused in the page; click into the field first"
    if info.get("disabled") or info.get("readonly"):
        return False, "the focused field is read-only or disabled"
    if field == "text":
        if tag == "textarea" or (tag == "input" and typ in TEXT_INPUT_TYPES):
            return True, ""
        return False, "the focused element is " + what + ", not a text field"
    want = FIELD_INPUT_TYPES.get(field)
    if want is None:
        return False, "unknown field " + str(field)
    if tag == "input" and typ in want:
        return True, ""
    return False, ("the focused element is " + what + ", not a " + field + " field (needs <input type="
                   + "|".join(sorted(want)) + ">)")


def utf16_len(s):
    return len(s.encode("utf-16-le")) // 2


def loopback_hex(ip_hex):
    """True for 127.0.0.0/8, ::1 and ::ffff:127.x as /proc/net/tcp{,6} print them (host-order words)."""
    try:
        raw = bytes.fromhex(ip_hex)
    except ValueError:
        return False
    if len(raw) == 4:
        return raw[::-1][0] == 127
    if len(raw) == 16:
        a = b"".join(raw[i:i + 4][::-1] for i in range(0, 16, 4))
        return a == bytes(15) + b"\x01" or (a[:12] == bytes(10) + b"\xff\xff" and a[12] == 127)
    return False


def tcp_listeners(texts, uid):
    """Ports listening on loopback, from the text of /proc/net/tcp and tcp6, owned by uid (any when None)."""
    ports = []
    for text in texts:
        for line in text.splitlines()[1:]:
            f = line.split()
            if len(f) < 10 or f[3] != "0A":          # 0A = LISTEN
                continue
            if uid is not None and f[7] != str(uid):
                continue
            ip_hex, _, port_hex = f[1].partition(":")
            if not loopback_hex(ip_hex):
                continue
            try:
                port = int(port_hex, 16)
            except ValueError:
                continue
            if 0 < port < 65536 and port not in ports:
                ports.append(port)
    return ports


def is_devtools_version(v, port):
    """Chrome's DevTools /json/version answer for this port, else False."""
    if not isinstance(v, dict):
        return False
    browser = str(v.get("Browser", "")).split("/")[0]
    ws = str(v.get("webSocketDebuggerUrl", ""))
    return browser in BROWSERS and ws.startswith("ws://127.0.0.1:" + str(port) + "/devtools/browser/")


def user_data_dir(cmdline):
    """--user-data-dir from a /proc/PID/cmdline (NUL-separated; Chrome may rewrite it with spaces)."""
    args = cmdline.split(b"\0") if b"\0" in cmdline else cmdline.split()
    for a in args:
        a = a.decode("utf-8", "replace")
        if a.startswith("--user-data-dir="):
            return a.split("=", 1)[1]
    return None


def user_data_dir_from_string(command_line):
    """--user-data-dir from a command line as one string (SystemInfo.getInfo's commandLine)."""
    m = re.search(r'--user-data-dir=(?:"([^"]+)"|\'([^\']+)\'|(\S+))', command_line or "")
    return next((g for g in m.groups() if g), None) if m else None


def profile_name(udd):
    return os.path.basename(os.path.normpath(udd)) if udd else None


def ws_accept(key):
    return base64.b64encode(hashlib.sha1((key + WS_GUID).encode()).digest()).decode()


def ws_mask(payload, mask):
    if not payload:
        return b""
    n = len(payload)
    m = (mask * (n // 4 + 1))[:n]
    return (int.from_bytes(payload, "big") ^ int.from_bytes(m, "big")).to_bytes(n, "big")


def ws_encode_frame(opcode, payload, mask=None, fin=True):
    """A client frame (RFC 6455 5.2): masked with a random key unless one is given."""
    mask = os.urandom(4) if mask is None else mask
    b0 = (0x80 if fin else 0) | (opcode & 0x0F)
    n = len(payload)
    if n < 126:
        head = struct.pack("!BB", b0, 0x80 | n)
    elif n < 65536:
        head = struct.pack("!BBH", b0, 0x80 | 126, n)
    else:
        head = struct.pack("!BBQ", b0, 0x80 | 127, n)
    return head + mask + ws_mask(payload, mask)


def ws_decode_frame(buf):
    """(fin, opcode, payload, bytes used), or None when buf doesn't hold a whole frame yet."""
    if len(buf) < 2:
        return None
    b0, b1 = buf[0], buf[1]
    n, i = b1 & 0x7F, 2
    if n == 126:
        if len(buf) < 4:
            return None
        n, i = struct.unpack("!H", buf[2:4])[0], 4
    elif n == 127:
        if len(buf) < 10:
            return None
        n, i = struct.unpack("!Q", buf[2:10])[0], 10
    mask = None
    if b1 & 0x80:
        if len(buf) < i + 4:
            return None
        mask, i = buf[i:i + 4], i + 4
    if len(buf) < i + n:
        return None
    payload = buf[i:i + n]
    if mask:
        payload = ws_mask(payload, mask)
    return bool(b0 & 0x80), b0 & 0x0F, payload, i + n


def withheld(out, value):
    """True when any string in the result holds the value (any length)."""
    if not isinstance(value, str) or not value:
        return False
    for v in out.values():
        if isinstance(v, str) and (value in v or json.dumps(value)[1:-1] in v):
            return True
    return False


# --- a minimal WebSocket client and DevTools connection --------------------------------
class WebSocket:
    def __init__(self, url, timeout=TIMEOUT):
        u = urllib.parse.urlsplit(url)
        if u.scheme != "ws" or u.hostname != "127.0.0.1":
            raise Failed("unexpected DevTools address")
        self.sock = socket.create_connection(("127.0.0.1", u.port or 80), timeout=timeout)
        key = base64.b64encode(os.urandom(16)).decode()
        path = (u.path or "/") + ("?" + u.query if u.query else "")
        # No Origin header: Chrome accepts DevTools clients that don't send one.
        req = ("GET " + path + " HTTP/1.1\r\nHost: 127.0.0.1:" + str(u.port) + "\r\n"
               "Upgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: " + key + "\r\n"
               "Sec-WebSocket-Version: 13\r\n\r\n")
        self.sock.sendall(req.encode())
        head = b""
        while b"\r\n\r\n" not in head:
            chunk = self.sock.recv(4096)
            if not chunk:
                raise Failed("DevTools closed the connection during the handshake")
            head += chunk
            if len(head) > 65536:
                raise Failed("DevTools handshake too long")
        head, self.buf = head.split(b"\r\n\r\n", 1)
        lines = head.decode("latin-1").split("\r\n")
        if len(lines[0].split()) < 2 or lines[0].split()[1] != "101":
            raise Failed("DevTools refused the WebSocket")
        headers = {}
        for line in lines[1:]:
            k, _, v = line.partition(":")
            headers[k.strip().lower()] = v.strip()
        if headers.get("sec-websocket-accept") != ws_accept(key):
            raise Failed("bad WebSocket handshake from DevTools")

    def send_text(self, text):
        self.sock.sendall(ws_encode_frame(0x1, text.encode("utf-8")))

    def _frame(self):
        while True:
            f = ws_decode_frame(self.buf)
            if f:
                self.buf = self.buf[f[3]:]
                return f
            chunk = self.sock.recv(65536)
            if not chunk:
                raise Failed("DevTools closed the connection")
            self.buf += chunk
            if len(self.buf) > (64 << 20):
                raise Failed("DevTools message too large")

    def recv_text(self):
        parts, started = [], False
        while True:
            fin, op, payload, _ = self._frame()
            if op == 0x9:                       # ping -> pong
                self.sock.sendall(ws_encode_frame(0xA, payload))
                continue
            if op == 0xA:
                continue
            if op == 0x8:
                raise Failed("DevTools closed the connection")
            if op in (0x1, 0x2):
                parts, started = [payload], True
            elif op == 0x0 and started:
                parts.append(payload)
            else:
                continue
            if fin:
                return b"".join(parts).decode("utf-8", "replace")

    def recv_text_within(self, seconds):
        """The next text message, or None when nothing came within `seconds` (what arrived so far is kept)."""
        old = self.sock.gettimeout()
        self.sock.settimeout(max(0.01, seconds))
        try:
            return self.recv_text()
        except (socket.timeout, TimeoutError):
            return None
        finally:
            self.sock.settimeout(old)

    def close(self):
        try:
            self.sock.sendall(ws_encode_frame(0x8, b""))
        except OSError:
            pass
        try:
            self.sock.close()
        except OSError:
            pass


def _script_error(r):
    d = r.get("exceptionDetails") or {}
    desc = str((d.get("exception") or {}).get("description") or d.get("text") or "script error")
    return desc.splitlines()[0][:160]


class DevTools:
    def __init__(self, ws_url, timeout=TIMEOUT):
        self.ws = WebSocket(ws_url, timeout=timeout)
        self.next_id = 0
        self.on_event = None        # called with each event that arrives while waiting (Fetch.requestPaused)

    def send(self, method, params=None):
        """A command whose answer isn't waited for (it's skipped when it comes)."""
        self.next_id += 1
        self.ws.send_text(json.dumps({"id": self.next_id, "method": method, "params": params or {}}))

    def _event(self, msg):
        if self.on_event is not None and isinstance(msg, dict) and "method" in msg and "id" not in msg:
            self.on_event(msg)

    def wait_events(self, seconds):
        """Handle the events that arrive within `seconds`."""
        end = time.monotonic() + seconds
        while True:
            left = end - time.monotonic()
            if left <= 0:
                return
            raw = self.ws.recv_text_within(left)
            if raw is None:
                return
            try:
                self._event(json.loads(raw))
            except ValueError:
                pass

    def call(self, method, params=None, quiet=False):
        """Send a command and wait for its answer (events in between go to on_event, else are skipped).
        quiet: never put the protocol's error text in a message (for calls that carry the value)."""
        self.next_id += 1
        mid = self.next_id
        self.ws.send_text(json.dumps({"id": mid, "method": method, "params": params or {}}))
        while True:
            msg = json.loads(self.ws.recv_text())
            if msg.get("id") != mid:
                self._event(msg)
                continue
            if "error" in msg:
                if quiet:
                    raise Failed(method + " failed")
                raise Failed(method + " failed: " + str((msg["error"] or {}).get("message", ""))[:120])
            return msg.get("result") or {}

    def value(self, expression, ctx=None):
        p = {"expression": expression, "returnByValue": True}
        if ctx is not None:
            p["contextId"] = ctx
        r = self.call("Runtime.evaluate", p)
        if r.get("exceptionDetails"):
            raise Failed("the page refused a check: " + _script_error(r))
        return (r.get("result") or {}).get("value")

    def object(self, expression, ctx):
        r = self.call("Runtime.evaluate", {"expression": expression, "returnByValue": False, "contextId": ctx})
        if r.get("exceptionDetails"):
            raise Failed("the page refused a check: " + _script_error(r))
        res = r.get("result") or {}
        return res.get("objectId") if res.get("subtype") != "null" else None

    def on(self, object_id, function, args=None, quiet=False):
        """Run a function with `this` = the object, in the object's own (isolated) world.
        quiet: for calls that carry the value (no error text from the page or the protocol)."""
        p = {"objectId": object_id, "functionDeclaration": function, "returnByValue": True}
        if args is not None:
            p["arguments"] = [{"value": a} for a in args]
        r = self.call("Runtime.callFunctionOn", p, quiet=quiet)
        if r.get("exceptionDetails"):
            raise Failed("the page refused the fill" if quiet else "the page refused a check: " + _script_error(r))
        return (r.get("result") or {}).get("value")

    def close(self):
        self.ws.close()


# Run only in isolated worlds, where page script can't reach.
DEEP_ACTIVE = r"""/*mcomp:deep-active*/(function () {
  let el = document.activeElement;
  for (let i = 0; el && i < 32 && el.shadowRoot && el.shadowRoot.activeElement; i++) el = el.shadowRoot.activeElement;
  return (el && el !== document.body && el !== document.documentElement) ? el : null;
})()"""

DESCRIBE = r"""/*mcomp:describe*/function () {
  const tag = (this.tagName || '').toLowerCase();
  return { tag: tag, type: tag === 'input' ? String(this.type || '').toLowerCase() : '',
           readonly: !!this.readOnly, disabled: !!this.disabled, autocomplete: String(this.autocomplete || '') };
}"""

SELECT = r"""/*mcomp:select*/function () {
  try {
    if (typeof this.focus === 'function') this.focus();
    if (typeof this.select === 'function') this.select();
  } catch (e) {}
  return true;
}"""

VALUE_LENGTH = r"""/*mcomp:value-length*/function () { return (typeof this.value === 'string') ? this.value.length : -1; }"""

# Types the text into this very element, in one step inside its own document: it must
# still be the focused element there, and nothing can navigate between the check and the
# insertion (a navigation destroys this world and the call fails instead). execCommand's
# insertText fires the same beforeinput/input events as typing.
INSERT = r"""/*mcomp:insert*/function (text) {
  const doc = this.ownerDocument;
  let a = doc.activeElement;
  for (let i = 0; a && i < 32 && a.shadowRoot && a.shadowRoot.activeElement; i++) a = a.shadowRoot.activeElement;
  if (a !== this) return { done: false, focus: false };
  try { if (typeof this.select === 'function') this.select(); } catch (e) {}
  let ok = false;
  try { ok = doc.execCommand('insertText', false, text); } catch (e) { ok = false; }
  return { done: !!ok, focus: true };
}"""

IS_FOCUSED = r"""/*mcomp:is-focused*/function () {
  let a = this.ownerDocument.activeElement;
  for (let i = 0; a && i < 32 && a.shadowRoot && a.shadowRoot.activeElement; i++) a = a.shadowRoot.activeElement;
  return a === this;
}"""

FRAME_ORIGIN = "/*mcomp:frame-origin*/self.origin"
READ_MAX = 8192
LINKS_MAX = 20
LINK_MAX = 2048


LAND_WAIT = 8            # seconds an opened link is watched: its navigations, and the page's own moves after it loads
def read_js(selector, what):
    """In the top frame's isolated world: the one element the selector matches, and its text (bounded) or its links."""
    return ("/*mcomp:read*/(function (sel, what) { let l; try { l = document.querySelectorAll(sel); } catch (e) { return {n: -1}; }"
            " if (l.length !== 1) return {n: l.length}; const el = l[0];"
            " if (what === 'links') { const as = (el.tagName === 'A' && el.href) ? [el] : Array.from(el.querySelectorAll('a[href]'));"
            "   return {n: 1, links: as.slice(0, " + str(LINKS_MAX) + ").map(a => String(a.href)).filter(h => h.length <= " + str(LINK_MAX) + ")}; }"
            " return {n: 1, text: String(el.innerText || el.textContent || '').slice(0, " + str(READ_MAX) + ")}; })("
            + json.dumps(selector) + ", " + json.dumps(what) + ")")


def total_js(selector):
    """In the top frame's isolated world: the one element the selector matches, its rendered text only (innerText leaves
    out what isn't rendered; no textContent fallback) and whether it's shown to a person: what's left of its box once the
    page and every clip on it and its ancestors (overflow, clip, clip-path) are applied together has an area, neither
    it nor any ancestor is hidden (display, visibility, content-visibility) or see-through (opacity, an opacity
    filter), and its text isn't transparent or too small to read. A clip this can't place exactly (another shape,
    unit or box, or a transform in the way) counts as hiding it. And, whatever the geometry says, the browser's own hit
    test must agree: points inside the text holding its digits, scrolled into view (every scroll put back after), must
    land on the element itself or what's inside it; covered, clipped, out of reach or pointer-events: none, it isn't
    shown."""
    return ("/*mcomp:total*/(function (sel) { let l; try { l = document.querySelectorAll(sel); } catch (e) { return {n: -1}; }"
            " if (l.length !== 1) return {n: l.length}; const el = l[0];"
            " const up = (e) => e.parentElement || ((e.getRootNode && e.getRootNode().host) || null);"
            # What of the element is shown is worked out as one region, in page coordinates: its box, cut by the page, by
            # every ancestor that clips (overflow on the axes it clips, so overflow-x alone leaves the height alone; paint
            # containment both; the root's or the body's overflow is the viewport's, which clips only where it can't be
            # scrolled: hidden or clip, to what's in view; an ancestor clips a fixed or absolute box only when it's in that
            # box's chain of containing blocks: for fixed, one with a transform, filter, perspective, containment or the
            # like; for absolute, a positioned one too), and by every clip-path on it or an ancestor, each
            # shape placed on that element's own box (border-box). A shape counts only when it can be placed exactly: an
            # inset (rounded corners cut as straight chamfers, inside the round ones), a simple polygon, a circle or ellipse
            # (as a 16-sided polygon inside it), lengths in px or %; at most one polygon that isn't convex. A clip-path with
            # any transform other than a translation on the chain (scale, rotation, zoom, a motion path), or an
            # overflow clip with a rotation or skew, can't be placed exactly: hidden. So is any other shape, unit or box.
            # What's left must have an area of at least 4 px and not be a sliver (area / perimeter at least 0.5). Then the
            # browser's own hit test (hit): the geometry is a list of rules a page could fall outside of, so the total is
            # scrolled into view (every scroll put back after) and points inside the text holding its digits (each text
            # node that renders: one with no box, or not visible, isn't in innerText either) must land on that text's own
            # element or one of its ancestors within the total; clipped away, covered (by a descendant too), out of view
            # or pointer-events: none, it's hidden.
            " const len = (v, ref) => { const m = /^(-?[0-9.]+)(px|%)$/.exec(v); return m ? (m[2] === '%' ? parseFloat(m[1]) * ref / 100 : parseFloat(m[1])) : NaN; };"
            " const cross = (o, a, b) => (a[0] - o[0]) * (b[1] - o[1]) - (a[1] - o[1]) * (b[0] - o[0]);"
            " const onSeg = (p, q, r) => Math.min(p[0], r[0]) - 1e-9 <= q[0] && q[0] <= Math.max(p[0], r[0]) + 1e-9 && Math.min(p[1], r[1]) - 1e-9 <= q[1] && q[1] <= Math.max(p[1], r[1]) + 1e-9;"
            " const meet = (p1, p2, p3, p4) => { const d1 = cross(p3, p4, p1), d2 = cross(p3, p4, p2), d3 = cross(p1, p2, p3), d4 = cross(p1, p2, p4);"
            "  if (((d1 > 0 && d2 < 0) || (d1 < 0 && d2 > 0)) && ((d3 > 0 && d4 < 0) || (d3 < 0 && d4 > 0))) return true;"
            "  return (Math.abs(d1) < 1e-9 && onSeg(p3, p1, p4)) || (Math.abs(d2) < 1e-9 && onSeg(p3, p2, p4)) || (Math.abs(d3) < 1e-9 && onSeg(p1, p3, p2)) || (Math.abs(d4) < 1e-9 && onSeg(p1, p4, p2)); };"
            " const simple = (xy) => { const n = xy.length; for (let i = 0; i < n; i++) { const a = xy[i], b = xy[(i + 1) % n]; if (Math.abs(a[0] - b[0]) < 1e-9 && Math.abs(a[1] - b[1]) < 1e-9) return false;"
            "   for (let j = i + 1; j < n; j++) { if ((j + 1) % n === i || (i + 1) % n === j) continue; if (meet(a, b, xy[j], xy[(j + 1) % n])) return false; } } return true; };"
            " const sarea = (P) => { let a = 0; for (let i = 0; i < P.length; i++) { const p = P[i], q = P[(i + 1) % P.length]; a += p[0] * q[1] - q[0] * p[1]; } return a / 2; };"
            " const perim = (P) => { let s = 0; for (let i = 0; i < P.length; i++) { const p = P[i], q = P[(i + 1) % P.length]; s += Math.hypot(q[0] - p[0], q[1] - p[1]); } return s; };"
            " const convex = (P) => { let sg = 0; for (let i = 0; i < P.length; i++) { const c = cross(P[i], P[(i + 1) % P.length], P[(i + 2) % P.length]); if (Math.abs(c) < 1e-9) continue;"
            "   if (!sg) sg = Math.sign(c); else if (Math.sign(c) !== sg) return false; } return sg !== 0; };"
            " const clipBy = (subj, win) => { const o = Math.sign(sarea(win)); if (!o) return []; let out = subj;"
            "   for (let k = 0; k < win.length && out.length; k++) { const a = win[k], b = win[(k + 1) % win.length], src = out; out = [];"
            "    const ins = (p) => o * cross(a, b, p) >= -1e-9;"
            "    const at = (p, q) => { const cp = cross(a, b, p), cq = cross(a, b, q), t = cp / (cp - cq); return [p[0] + t * (q[0] - p[0]), p[1] + t * (q[1] - p[1])]; };"
            "    for (let i = 0; i < src.length; i++) { const cur = src[i], prev = src[(i + src.length - 1) % src.length];"
            "     if (ins(cur)) { if (!ins(prev)) out.push(at(prev, cur)); out.push(cur); } else if (ins(prev)) out.push(at(prev, cur)); } }"
            "   return out.length >= 3 ? out : []; };"
            " const box = (x0, y0, x1, y1) => [[x0, y0], [x1, y0], [x1, y1], [x0, y1]];"
            " const shape = (cp, ox, oy, w, h) => {"
            "  const bx = /\\s+(border-box|padding-box|content-box|margin-box|fill-box|stroke-box|view-box)$/.exec(cp);"
            "  if (bx) { if (bx[1] !== 'border-box') return null; cp = cp.slice(0, bx.index); } let m;"
            "  if ((m = /^polygon\\((.*)\\)$/.exec(cp))) { const pts = m[1].replace(/^\\s*(nonzero|evenodd)\\s*,/, '').split(',').map(q => q.trim().split(/\\s+/));"
            "   if (pts.length < 3 || pts.length > 64 || pts.some(q => q.length !== 2)) return null; const xy = pts.map(q => [ox + len(q[0], w), oy + len(q[1], h)]);"
            "   if (xy.some(q => !isFinite(q[0]) || !isFinite(q[1])) || !simple(xy)) return null; return {pts: xy, convex: convex(xy)}; }"
            "  if ((m = /^inset\\((.*)\\)$/.exec(cp))) { const halves = m[1].split(/\\s+round\\s+/); const p = halves[0].trim().split(/\\s+/); let T, R, B, L;"
            "   if (p.length === 1) { T = R = B = L = p[0]; } else if (p.length === 2) { T = B = p[0]; R = L = p[1]; }"
            "   else if (p.length === 3) { T = p[0]; R = L = p[1]; B = p[2]; } else if (p.length === 4) { [T, R, B, L] = p; } else return null;"
            "   const t = Math.max(0, len(T, h)), r = Math.max(0, len(R, w)), b = Math.max(0, len(B, h)), l = Math.max(0, len(L, w));"
            "   const x0 = ox + l, y0 = oy + t, x1 = ox + w - r, y1 = oy + h - b; if (![x0, y0, x1, y1].every(isFinite) || x1 - x0 < 1 || y1 - y0 < 1) return null;"
            "   if (halves.length === 1) return {pts: box(x0, y0, x1, y1), convex: true};"
            "   const rad = halves[1].trim().split(/[\\s\\/]+/).filter(x => x); if (!rad.length) return null;"
            "   const rx = Math.min((x1 - x0) / 2, Math.max(...rad.map(v => len(v, w)))), ry = Math.min((y1 - y0) / 2, Math.max(...rad.map(v => len(v, h))));"
            "   if (!isFinite(rx) || !isFinite(ry)) return null;"
            "   return {pts: [[x0 + rx, y0], [x1 - rx, y0], [x1, y0 + ry], [x1, y1 - ry], [x1 - rx, y1], [x0 + rx, y1], [x0, y1 - ry], [x0, y0 + ry]], convex: true}; }"
            "  if ((m = /^(circle|ellipse)\\((.*)\\)$/.exec(cp))) { const halves = m[2].split(/\\s+at\\s+/); const r = halves[0].trim().split(/\\s+/).filter(x => x);"
            "   const at = (halves[1] || '50% 50%').trim().split(/\\s+/); if (r.length === 0 || r.length > 2 || at.length !== 2) return null;"
            "   const d = Math.sqrt((w * w + h * h) / 2); const rs = r.map((v, i) => len(v, m[1] === 'circle' ? d : (i ? h : w)));"
            "   const rx = rs[0], ry = rs.length > 1 ? rs[1] : rs[0], cx = ox + len(at[0], w), cy = oy + len(at[1], h);"
            "   if (![rx, ry, cx, cy].every(isFinite) || rx < 1 || ry < 1) return null; const pts = [];"
            "   for (let i = 0; i < 16; i++) { const th = i * Math.PI / 8; pts.push([cx + rx * Math.cos(th), cy + ry * Math.sin(th)]); }"
            "   return {pts: pts, convex: true}; }"
            "  return null; };"
            " const matrix = (cs) => { const t = cs.transform || 'none'; let ident = true, aligned = true, m;"
            "  if (t !== 'none') { if ((m = /^matrix\\(([^)]*)\\)$/.exec(t))) { const v = m[1].split(',').map(Number);"
            "    if (v.length !== 6 || !v.every(isFinite)) { ident = aligned = false; } else { if (Math.abs(v[1]) > 1e-9 || Math.abs(v[2]) > 1e-9) ident = aligned = false;"
            "     if (Math.abs(v[0] - 1) > 1e-9 || Math.abs(v[3] - 1) > 1e-9) ident = false; } } else ident = aligned = false; }"
            "  if ((cs.rotate || 'none') !== 'none' || ((cs.offsetPath || 'none') !== 'none')) ident = aligned = false;"
            "  if ((cs.scale || 'none') !== 'none') ident = false;"
            "  const tr = cs.translate || 'none'; if (tr !== 'none' && tr.trim().split(/\\s+/).length > 2) ident = aligned = false;"
            "  if (cs.zoom && cs.zoom !== '1' && cs.zoom !== 'normal') ident = false;"
            "  return [ident, aligned]; };"
            " const hit = () => {"
            "  const root = el.getRootNode && typeof el.getRootNode().elementFromPoint === 'function' ? el.getRootNode() : document;"
            "  const tw = document.createTreeWalker(el, NodeFilter.SHOW_TEXT); const nodes = [];"
            "  for (let n = tw.nextNode(); n; n = tw.nextNode()) { if (/[0-9]/.test(n.data)) nodes.push(n); if (nodes.length > 50) return false; }"
            "  if (!nodes.length) return false;"
            "  const saved = [[null, scrollX, scrollY]];"
            "  for (let e = up(el); e && e.nodeType === 1; e = up(e)) if (e.scrollTop || e.scrollLeft || e.scrollHeight > e.clientHeight || e.scrollWidth > e.clientWidth) saved.push([e, e.scrollLeft, e.scrollTop]);"
            "  let ok = true;"
            "  try {"
            "   el.scrollIntoView({block: 'center', inline: 'center', behavior: 'instant'});"
            "   let tested = 0;"
            "   for (const n of nodes) {"
            "    const pe = n.parentElement; if (!pe || getComputedStyle(pe).visibility !== 'visible') continue;"
            "    let i = 0, j = n.data.length; while (i < j && !/[0-9]/.test(n.data[i])) i++; while (j > i && !/[0-9]/.test(n.data[j - 1])) j--;"
            "    const rg = document.createRange(); rg.setStart(n, i); rg.setEnd(n, j);"
            "    const rs = Array.from(rg.getClientRects()).filter(q => q.width > 0 && q.height > 0);"
            "    if (!rs.length) continue;"
            "    tested++;"
            "    for (const q of rs) { for (const fx of [0.25, 0.5, 0.75]) {"
            "     const x = q.left + q.width * fx, y = q.top + q.height / 2;"
            "     const h = x >= 0 && y >= 0 && x < innerWidth && y < innerHeight ? root.elementFromPoint(x, y) : null;"
            "     if (!h || !h.contains(n) || !el.contains(h)) { ok = false; break; } } if (!ok) break; }"
            "    if (!ok) break;"
            "   }"
            "   if (!tested) ok = false;"
            "  } catch (e) { ok = false; } finally {"
            "   for (const [e, x, y] of saved.reverse()) { try { if (e) { e.scrollLeft = x; e.scrollTop = y; } else window.scrollTo({left: x, top: y, behavior: 'instant'}); } catch (e2) {} }"
            "  }"
            "  return ok;"
            " };"
            " const shown = (function () {"
            "  if (el.getClientRects().length === 0) return false;"
            "  const r = el.getBoundingClientRect(); if (r.width < 2 || r.height < 2) return false;"
            "  const de = document.documentElement; const W = Math.max(de.scrollWidth, innerWidth), H = Math.max(de.scrollHeight, innerHeight);"
            "  const wins = [box(0, 0, W, H)]; let concave = null, clips = false, overflows = false, ident = true, aligned = true;"
            "  const dcs = getComputedStyle(de), bd = document.body, fromBody = !!bd && dcs.overflowX === 'visible' && dcs.overflowY === 'visible';"
            "  const vp = fromBody ? getComputedStyle(bd) : dcs, shut = (v) => v === 'hidden' || v === 'clip', far = 1e9;"
            "  if (shut(vp.overflowX) || shut(vp.overflowY)) { overflows = true; wins.push(box(shut(vp.overflowX) ? scrollX : -far, shut(vp.overflowY) ? scrollY : -far,"
            "   shut(vp.overflowX) ? scrollX + innerWidth : far, shut(vp.overflowY) ? scrollY + innerHeight : far)); }"
            "  const fixedCB = (cs) => ['transform', 'translate', 'rotate', 'scale', 'perspective', 'filter', 'backdropFilter'].some(p => (cs[p] || 'none') !== 'none')"
            "   || cs.transformStyle === 'preserve-3d' || /paint|layout|strict|content|size/.test(cs.contain || '')"
            "   || /transform|perspective|filter|translate|rotate|scale|contain|backdrop|preserve/.test(cs.willChange || '')"
            "   || (cs.containerType || 'normal') !== 'normal' || cs.contentVisibility === 'auto';"
            "  const needOf = (cs) => cs.position === 'absolute' ? 'abs' : cs.position === 'fixed' ? 'fixed' : null;"
            "  let need = null;"
            "  for (let e = el; e && e.nodeType === 1; e = up(e)) {"
            "   const cs = getComputedStyle(e);"
            "   const cb = e === el || need === null || (need === 'abs' ? cs.position !== 'static' || fixedCB(cs) : fixedCB(cs));"
            "   if (cb) need = needOf(cs);"
            "   if (cs.display === 'none' || cs.visibility === 'hidden' || cs.visibility === 'collapse' || cs.contentVisibility === 'hidden') return false;"
            "   if (parseFloat(cs.opacity || '1') < 0.1) return false;"
            "   if (/opacity\\(\\s*0*(\\.0*)?%?\\s*\\)/.test(cs.filter || '')) return false;"
            "   if (/rect\\(\\s*0(px)?[\\s,]+0(px)?[\\s,]+0(px)?[\\s,]+0(px)?\\s*\\)/.test(cs.clip || '')) return false;"
            "   const mx = matrix(cs); ident = ident && mx[0]; aligned = aligned && mx[1];"
            "   const eb = e.getBoundingClientRect(); const cp = cs.clipPath || 'none';"
            "   if (cp !== 'none') { clips = true; const s = shape(cp, eb.left + scrollX, eb.top + scrollY, eb.width, eb.height); if (!s) return false;"
            "    if (s.convex) wins.push(s.pts); else { if (concave) return false; concave = s.pts; } }"
            "   if (e !== el && cb && e !== de && !(fromBody && e === bd)) { const pc = /paint|strict|content/.test(cs.contain || '');"
            "    const cx = pc || cs.overflowX !== 'visible', cy = pc || cs.overflowY !== 'visible';"
            "    if (cx || cy) { overflows = true; wins.push(box(cx ? eb.left + scrollX : -far, cy ? eb.top + scrollY : -far, cx ? eb.right + scrollX : far, cy ? eb.bottom + scrollY : far)); } } }"
            "  if ((clips && !ident) || (overflows && !aligned)) return false;"
            "  let V = box(r.left + scrollX, r.top + scrollY, r.right + scrollX, r.bottom + scrollY);"
            "  for (const w of wins) { V = clipBy(V, w); if (!V.length) return false; }"
            "  if (concave) { V = clipBy(concave, V); if (!V.length) return false; }"
            "  const a = Math.abs(sarea(V)); if (!(a >= 4 && a / perim(V) >= 0.5)) return false;"
            "  const cs = getComputedStyle(el); if (parseFloat(cs.fontSize || '16') < 6) return false;"
            "  if (cs.color === 'transparent' || /rgba\\([^)]*,\\s*0(\\.0*)?\\s*\\)$/.test(cs.color)) return false;"
            "  return hit(); })();"
            " return {n: 1, text: String(el.innerText || '').slice(0, " + str(READ_MAX) + "), visible: shown}; })("
            + json.dumps(selector) + ")")


def focus_selector_js(selector):
    return ("/*mcomp:focus-selector*/(function (sel) { let l; try { l = document.querySelectorAll(sel); }"
            " catch (e) { return -1; } if (l.length !== 1) return l.length; l[0].focus(); return 1; })("
            + json.dumps(selector) + ")")


# --- finding the driver's Chrome ------------------------------------------------------
def desktop_uid():
    """The desktop user's uid, from the root-owned /etc/metacomputer/fill.conf (None: unknown,
    and run() then refuses: without it, any user's listener could pose as Chrome)."""
    try:
        with open(CONF) as f:
            for line in f:
                k, _, v = line.strip().partition("=")
                if k == "desktop_user" and v:
                    return pwd.getpwnam(v).pw_uid
    except (OSError, KeyError):
        pass
    return None


def http_json(port, path, timeout=1.5):
    conn = http.client.HTTPConnection("127.0.0.1", port, timeout=timeout)
    try:
        conn.request("GET", path, headers={"Host": "127.0.0.1:" + str(port)})
        r = conn.getresponse()
        if r.status != 200:
            return None
        return json.loads(r.read(1 << 20).decode("utf-8", "replace"))
    except (OSError, ValueError, http.client.HTTPException):
        return None
    finally:
        conn.close()


def devtools_endpoints(opts):
    """[(port, browser WebSocket URL)] for Chrome DevTools listeners on loopback."""
    texts = []
    for p in opts["proc_net"]:
        try:
            with open(p) as f:
                texts.append(f.read())
        except OSError:
            pass
    out = []
    for port in tcp_listeners(texts, opts["uid"]):
        v = http_json(port, "/json/version")
        if is_devtools_version(v, port):
            out.append((port, v["webSocketDebuggerUrl"]))
    return out


def _why(e):
    return (type(e).__name__ + (": " + str(e) if str(e) else ""))[:90]


def profile_of(browser_ws, proc_root):
    """(profile folder name or None, notes) for the Chrome behind this DevTools endpoint.
    All three routes are the browser's own answers (it could lie, like any program on
    that port; SECURITY.md). 1. SystemInfo.getInfo's commandLine. 2. SystemInfo.getProcessInfo's
    browser pid, then /proc/PID/cmdline. 3. Browser.getBrowserCommandLine (only with
    --enable-automation, which the driver doesn't pass). Notes say why a route gave nothing."""
    notes = []
    try:
        dt = DevTools(browser_ws, timeout=8)
    except (Failed, OSError) as e:
        return None, ["connect: " + _why(e)]
    try:
        try:
            udd = user_data_dir_from_string(str(dt.call("SystemInfo.getInfo").get("commandLine") or ""))
            if udd:
                return profile_name(udd), notes
            notes.append("getInfo: no --user-data-dir")
        except (Failed, OSError, ValueError) as e:
            notes.append("getInfo: " + _why(e))
        try:
            procs = dt.call("SystemInfo.getProcessInfo").get("processInfo") or []
            pid = next((int(p["id"]) for p in procs if isinstance(p, dict) and p.get("type") == "browser"), None)
            if pid is None:
                notes.append("getProcessInfo: no browser process listed")
            else:
                try:
                    with open(os.path.join(proc_root, str(pid), "cmdline"), "rb") as f:
                        udd = user_data_dir(f.read())
                    if udd:
                        return profile_name(udd), notes
                    notes.append("/proc/" + str(pid) + "/cmdline: no --user-data-dir")
                except OSError as e:
                    notes.append("/proc/" + str(pid) + "/cmdline: " + _why(e))
        except (Failed, OSError, ValueError, KeyError, TypeError) as e:
            notes.append("getProcessInfo: " + _why(e))
        try:
            args = dt.call("Browser.getBrowserCommandLine").get("arguments") or []
            udd = next((a.split("=", 1)[1] for a in args if isinstance(a, str) and a.startswith("--user-data-dir=")), None)
            if udd:
                return profile_name(udd), notes
            notes.append("getBrowserCommandLine: no --user-data-dir")
        except (Failed, OSError, ValueError) as e:
            notes.append("getBrowserCommandLine: " + _why(e))
    finally:
        dt.close()
    return None, notes


def page_targets(port):
    data = http_json(port, "/json/list", timeout=TIMEOUT)
    out = []
    for t in data if isinstance(data, list) else []:
        if isinstance(t, dict) and t.get("type") == "page":
            ws = t.get("webSocketDebuggerUrl") or ("ws://127.0.0.1:" + str(port) + "/devtools/page/" + str(t.get("id")))
            out.append({"url": str(t.get("url") or ""), "ws": ws})
    return out


def choose_target(candidates, where=""):
    """The one tab on the allowed sites. Two or more are refused outright: which one is focused or visible is the
    pages' own answer (and nothing ties it to the tab that was checked), so it never decides where a value goes."""
    if len(candidates) == 1:
        return candidates[0]
    raise Denied(str(len(candidates)) + " tabs are open on the allowed sites" + where
                 + "; a fill goes only to a tab that's alone on its site: close the others")


def browser_pid_of(browser_ws):
    """The browser process id this DevTools endpoint reports (SystemInfo.getProcessInfo), or None."""
    try:
        dt = DevTools(browser_ws, timeout=8)
    except (Failed, OSError):
        return None
    try:
        procs = dt.call("SystemInfo.getProcessInfo").get("processInfo") or []
        return next((int(p["id"]) for p in procs if isinstance(p, dict) and p.get("type") == "browser"), None)
    except (Failed, OSError, ValueError, KeyError, TypeError):
        return None
    finally:
        dt.close()


# --- the browser's view of the page -------------------------------------------------------
class PageChanged(Exception):
    """The document changed between the checks and the typing."""


class Page:
    def __init__(self, dt, origins, top_origins=None):
        self.dt = dt
        self.origins = origins
        self.top_origins = top_origins or origins      # the sites the tab itself may be on (a frame's may be more)
        self.worlds = {}
        self.top, self.frames = self.read_tree()

    def read_tree(self):
        """(top frame id, {frame id: origin, url, parent, loaderId}) from Page.getFrameTree."""
        tree = self.dt.call("Page.getFrameTree").get("frameTree") or {}
        frames = {}

        def walk(node, parent):
            f = node.get("frame") or {}
            if f.get("id"):
                frames[f["id"]] = {"origin": f.get("securityOrigin"), "url": str(f.get("url") or ""),
                                   "parent": parent, "loader": f.get("loaderId")}
            for ch in node.get("childFrames") or []:
                walk(ch, f.get("id"))
        walk(tree, None)
        return (tree.get("frame") or {}).get("id"), frames

    def same_documents(self, path):
        """The frames on the path still hold the documents (loaderId) and origins first seen."""
        _, now = self.read_tree()
        for fid in path:
            a, b = self.frames.get(fid), now.get(fid)
            if not a or not b or a["loader"] != b["loader"] or a["origin"] != b["origin"]:
                return False
        return True

    def world(self, fid):
        if fid not in self.worlds:
            try:
                r = self.dt.call("Page.createIsolatedWorld", {"frameId": fid, "worldName": WORLD})
            except Failed:
                raise Denied("the focused field is inside a frame the fill can't look into (a frame from another site)")
            self.worlds[fid] = r.get("executionContextId")
        return self.worlds[fid]

    def origin(self, fid):
        """The frame's origin. The browser's frame tree and self.origin inside the frame's
        isolated world must agree. about:srcdoc and about:blank frames, which the tree shows
        as "://", inherit their parent's: the world's self.origin must equal it."""
        f = self.frames[fid]
        tree = parse_origin(f["origin"]) if f["origin"] and f["origin"] != "://" else None
        own = parse_origin(self.dt.value(FRAME_ORIGIN, self.world(fid)) or "")
        if tree:
            return tree if own == tree else None
        if f["url"].startswith("about:") and f["parent"]:
            parent = self.origin(f["parent"])
            if own and own == parent:
                return own
        return None

    def focused(self):
        """(frame path, frame origin, element object id, backendNodeId, description) of the focused element."""
        fid, path = self.top, []
        for _ in range(8):
            if fid not in self.frames:
                raise Denied("the focused field is inside a frame the fill can't look into")
            path.append(fid)
            origin = self.origin(fid)
            if origin not in (self.top_origins if fid == self.top else self.origins):
                if fid == self.top:
                    raise Denied("the tab is on " + str(origin or "no confirmed site (the browser and the page disagree)")
                                 + ", which isn't allowed for this secret")
                raise Denied("the focused field is inside a frame from another site (" + str(origin or "no site")
                             + "), which isn't allowed for this secret")
            ctx = self.world(fid)
            el = self.dt.object(DEEP_ACTIVE, ctx)
            if not el:
                raise Denied("no field is focused in the page; click into the field first")
            node = self.dt.call("DOM.describeNode", {"objectId": el}).get("node") or {}
            if str(node.get("nodeName", "")).upper() in ("IFRAME", "FRAME"):
                fid = node.get("frameId")
                continue
            return path, origin, el, node.get("backendNodeId"), self.dt.on(el, DESCRIBE) or {}
        raise Denied("the field is inside too many nested frames")

    def type_into(self, path, el, value):
        """Type the value into this element of these documents. Returns "element" or "keyboard"."""
        if not self.same_documents(path):
            raise Denied("the page changed after the check; nothing was typed")
        try:
            r = self.dt.on(el, INSERT, args=[value], quiet=True) or {}
        except Failed:
            raise Failed("the page changed before the fill; nothing was typed")
        if not r.get("focus"):
            raise Denied("the field lost the focus before the fill; nothing was typed")
        if r.get("done"):
            return "element"
        # The page doesn't take execCommand: type through the keyboard route instead, right
        # after confirming the same element in the same documents still has the focus.
        if not self.same_documents(path) or self.dt.on(el, IS_FOCUSED) is not True:
            raise Denied("the page changed after the check; nothing was typed")
        self.dt.call("Input.insertText", {"text": value}, quiet=True)
        return "keyboard"


# --- the fill ----------------------------------------------------------------------
def run(req, opts):
    mode = req.get("mode")
    field = req.get("field")
    origins = [o for o in (parse_origin(x) for x in req.get("origins") or []) if o]
    if mode not in ("fill", "check", "read", "open") or field not in FIELDS or not origins:
        raise Failed("bad request")
    # top_origins: where the tab itself may be; a payment frame's site (in origins only) is never a top-level destination.
    top_given = "top_origins" in req
    tops = [o for o in (parse_origin(x) for x in req.get("top_origins") or []) if o] if top_given else origins
    if top_given and (not tops or any(o not in origins for o in tops) or not isinstance(req.get("top_origins"), list)
                      or len(tops) != len(req["top_origins"])):
        raise Failed("bad request")
    value = req.get("value") if mode in ("fill", "open") else None
    if mode in ("fill", "open") and (not isinstance(value, str) or not value):
        raise Failed("bad request")
    if mode == "read" and (req.get("what") not in ("text", "links", "total") or not isinstance(req.get("selector"), str) or not req.get("selector")):
        raise Failed("bad request")
    if mode == "open" and (parse_origin(value) is None or parse_origin(value) != parse_origin(req.get("link_origin") or "")
                           or not re.match(r"^https?://", value) or len(value) > LINK_MAX):
        raise Denied("the link isn't one this request allows")
    profile = req.get("profile") or None
    selector = req.get("selector") or None
    if profile is not None and (not isinstance(profile, str) or not NAME_RE.match(profile) or profile in (".", "..")):
        raise Denied("bad profile name")
    browser_pid = req.get("browser_pid")
    if browser_pid is not None and (not isinstance(browser_pid, int) or isinstance(browser_pid, bool) or browser_pid <= 1):
        raise Denied("bad browser pid")
    if opts["uid"] is None:
        raise Failed("can't tell which user runs the desktop (" + CONF + "); refusing")

    endpoints = devtools_endpoints(opts)
    if not endpoints:
        raise Failed("no Chrome with DevTools is running; fills need page-mode Chrome (browser_prepare)")
    if profile:
        named, seen = [], []
        for port, ws in endpoints:
            name, notes = profile_of(ws, opts["proc_root"])
            if name == profile:
                named.append((port, ws))
            else:
                seen.append(str(port) + ": " + ("profile " + name if name else "; ".join(notes) or "unknown"))
        if not named:
            raise Failed("no Chrome is running on profile " + profile + " (" + " | ".join(seen)[:400] + ")")
        endpoints = named
    if browser_pid is not None:
        # The Chrome that was checked, by the browser process id it reports (as its own answer, like the profile).
        mine = [(port, ws) for port, ws in endpoints if browser_pid_of(ws) == browser_pid]
        if not mine:
            raise Failed("no Chrome with browser process " + str(browser_pid) + " has DevTools open"
                         + (" on profile " + profile if profile else ""))
        endpoints = mine
    candidates = []
    for port, _ in endpoints:
        candidates += [t for t in page_targets(port) if origin_allowed(t["url"], tops)]
    if not candidates:
        raise Denied("no open tab on " + ", ".join(tops) + " in the driver's Chrome; open the site first")
    target = choose_target(candidates, " in that Chrome" if browser_pid is not None else (" in profile " + profile if profile else ""))

    dt = DevTools(target["ws"])
    try:
        page = Page(dt, origins, tops)
        if not page.top:
            raise Failed("the tab has no page")
        if mode in ("read", "open"):
            top = page.origin(page.top)
            if top not in tops:
                raise Denied("the tab is on " + str(top or "no confirmed site (the browser and the page disagree)")
                             + ", which isn't allowed here")
            if mode == "open":
                if not page.same_documents([page.top]):
                    raise Denied("the page changed after the check; nothing was opened")
                start = page.frames[page.top]["loader"]
                finals = [o for o in (parse_origin(x) for x in req.get("final_origins") or []) if o] or origins
                stopped, seen_off = [], []

                # Every request for the tab's own page (the link, each redirect hop, a later move by the page's script)
                # is paused before it's sent, by the browser (Fetch, document requests): one to a site the vault didn't
                # name is failed there, so the browser never visits it. Frames' own documents go on.
                def on_event(msg):
                    if msg.get("method") != "Fetch.requestPaused":
                        return
                    p = msg.get("params") or {}
                    url = str((p.get("request") or {}).get("url") or "")
                    if p.get("frameId") == page.top and parse_origin(url) not in finals:
                        stopped.append(True)
                        dt.send("Fetch.failRequest", {"requestId": p.get("requestId"), "errorReason": "BlockedByClient"})
                    else:
                        dt.send("Fetch.continueRequest", {"requestId": p.get("requestId")})
                dt.on_event = on_event
                dt.call("Fetch.enable", {"patterns": [{"urlPattern": "*", "resourceType": "Document", "requestStage": "Request"}]})
                broke = None
                try:
                    r = dt.call("Page.navigate", {"url": value, "frameId": page.top}, quiet=True)
                    if r.get("errorText") and not stopped:
                        raise Failed("navigation failed")
                    # The whole window, however soon the page looks settled: a script that moves it two seconds later is
                    # stopped too. The frame tree is read as it goes: a site outside the list that shows there anyway (a
                    # navigation the interception didn't see) refuses afterwards.
                    end, last = time.monotonic() + opts["land_wait"], None
                    while time.monotonic() < end:
                        f = (dt.call("Page.getFrameTree").get("frameTree") or {}).get("frame") or {}
                        o = f.get("securityOrigin")
                        o = parse_origin(o) if o and o != "://" else None
                        if f.get("loaderId") and f.get("loaderId") != start and o is not None and o not in finals:
                            seen_off.append(True)
                        last = (f.get("loaderId"), o)
                        dt.wait_events(min(0.25, max(0.01, end - time.monotonic())))
                except (Failed, OSError, ValueError, KeyError, TypeError, AttributeError) as e:
                    # Something went wrong while watching. Fail closed before the interception ends (turning it off would
                    # let the browser go on with whatever is paused): every paused request is failed, loading stops.
                    broke = e

                    def fail_all(msg):
                        if msg.get("method") == "Fetch.requestPaused":
                            stopped.append(True)
                            dt.send("Fetch.failRequest", {"requestId": (msg.get("params") or {}).get("requestId"),
                                                          "errorReason": "BlockedByClient"})
                    dt.on_event = fail_all
                    try:
                        dt.send("Page.stopLoading")
                        dt.wait_events(0.5)
                    except (Failed, OSError, ValueError):
                        pass
                finally:
                    # Requests paused while Fetch is being turned off are still decided by the handler in force.
                    try:
                        dt.call("Fetch.disable")
                    except (Failed, OSError, ValueError):
                        pass
                    dt.on_event = None
                if broke is not None:
                    if isinstance(broke, Failed) and str(broke) == "navigation failed":
                        raise broke
                    raise Failed("the link's page couldn't be watched to the end; its loading was stopped and anything paused "
                                 "was refused, and nothing more was done (check the page)")
                if stopped:
                    return {"ok": False, "denied": False,
                            "reason": "the link tried to take the tab to another site (not shown); that was stopped before it "
                                      "was visited, and nothing more was done (check the page)"}
                if seen_off or (last and last[1] not in finals):
                    return {"ok": False, "denied": False,
                            "reason": "the link led to another site (not shown); nothing more was done (check the page)"}
                if not last or not last[0] or last[0] == start:
                    raise Failed("the tab didn't settle on the link's page in time; check the page")
                return {"ok": True, "mode": "open", "field": field, "origin": last[1]}
            js = total_js(str(req["selector"])[:300]) if req["what"] == "total" else read_js(str(req["selector"])[:300], req["what"])
            got = dt.value(js, page.world(page.top)) or {}
            n = got.get("n") if isinstance(got, dict) else None
            if n == -1:
                raise Denied("the selector isn't valid CSS. It searches the page itself, not frames or shadow roots")
            if n == 0:
                raise Denied("the selector matches no element (the element is in a frame? open what it shows in its own tab)")
            if n != 1:
                raise Denied("the selector matches " + str(n) + " elements, not exactly one")
            if req["what"] == "links":
                links = [h for h in (got.get("links") or []) if isinstance(h, str) and len(h) <= LINK_MAX][:LINKS_MAX]
                return {"ok": True, "mode": "read", "origin": top, "links": links}
            text = got.get("text")
            out = {"ok": True, "mode": "read", "origin": top, "text": text[:READ_MAX] if isinstance(text, str) else ""}
            if req["what"] == "total":
                out["visible"] = got.get("visible") is True
            return out
        if selector:
            n = dt.value(focus_selector_js(str(selector)[:300]), page.world(page.top))
            if n == -1:
                raise Denied("the selector isn't valid CSS. It searches the page itself, not frames or shadow roots "
                             "(there is no syntax for those): click into such a field instead")
            if n != 1:
                raise Denied("the selector matches " + str(n) + " elements, not exactly one")
        try:
            dt.call("Emulation.setFocusEmulationEnabled", {"enabled": True})   # background windows
        except Failed:
            pass
        path, frame, el, node, info = page.focused()
        top = page.origin(page.top)
        ok, why = field_fits(field, info)
        if not ok:
            raise Denied(why)
        if mode == "check":
            return {"ok": True, "mode": "check", "field": field, "origin": top, "frame_origin": frame,
                    "element": info.get("tag") + ("[type=" + info.get("type") + "]" if info.get("type") else "")}
        route = page.type_into(path, el, value)
        changed = {"ok": False, "denied": False, "origin": top,
                   "reason": "the page changed during the fill; the value may have gone elsewhere (check the page)"}
        if not page.same_documents(path):
            return changed
        try:
            path2, _, el2, node2, _ = page.focused()
        except Denied:
            return changed
        if (path2, node2) != (path, node):
            return {"ok": False, "denied": False, "origin": top,
                    "reason": "the focus moved while filling; the text may have gone to another field (check the page)"}
        n = dt.on(el2, VALUE_LENGTH)
        want = utf16_len(value)
        if n != want:
            return {"ok": False, "denied": False, "origin": top,
                    "reason": "the field holds " + str(n) + " characters, expected " + str(want)
                              + " (a length limit, or the page changed it)"}
        return {"ok": True, "mode": "fill", "field": field, "origin": top, "frame_origin": frame, "chars": want, "route": route}
    finally:
        dt.close()


def options(argv):
    opts = {"proc_net": ["/proc/net/tcp", "/proc/net/tcp6"], "uid": None, "proc_root": "/proc", "deadline": 40, "land_wait": LAND_WAIT}
    given_net, uid_given = [], False
    usage = "usage: secret-fill [--proc-net FILE]... [--desktop-uid N] [--proc-root DIR] [--deadline S] [--land-wait S] < request"
    # metacomputer's command-line rules (lib/strictargs.py; this runs in the VM on its own): -h or --help shows the
    # usage; each option once (--proc-net may repeat), its value never an option; anything else is refused (exit 2),
    # before the request is read.
    if argv in (["-h"], ["--help"]):
        print(usage)
        sys.exit(0)
    seen = set()
    for j in range(0, len(argv), 2):
        a, v = argv[j], argv[j + 1] if j + 1 < len(argv) else None
        if a not in ("--proc-net", "--desktop-uid", "--proc-root", "--deadline", "--land-wait") or v is None \
                or v.startswith("-") or (a in seen and a != "--proc-net"):
            print(usage, file=sys.stderr)
            sys.exit(2)
        seen.add(a)
    if os.environ.get("MCOMP_PARSE_ONLY") == "1":   # tests/test_help.py's valid forms: taken, nothing done
        print("parse-only: secret-fill: taken " + json.dumps({"flags": [], "values": ["--desktop-uid", "--proc-root", "--deadline", "--land-wait"], "words": 0, "max_words": 0}))
        sys.exit(99)        # parse only: nothing was done (never 0: a check run this way refuses)
    i = 0
    while i < len(argv):
        a = argv[i]
        v = argv[i + 1] if i + 1 < len(argv) else None
        if a == "--proc-net" and v:
            given_net.append(v)
        elif a == "--desktop-uid" and v:
            opts["uid"], uid_given = int(v), True
        elif a == "--proc-root" and v:
            opts["proc_root"] = v
        elif a == "--deadline" and v:
            opts["deadline"] = max(1, int(v))
        elif a == "--land-wait" and v:
            opts["land_wait"] = max(1, min(LAND_WAIT, int(v)))
        else:
            raise SystemExit("usage: secret-fill [--proc-net FILE] [--desktop-uid N] [--proc-root DIR] [--deadline S] [--land-wait S] < request")
        i += 2
    if given_net:
        opts["proc_net"] = given_net
    if not uid_given:
        opts["uid"] = desktop_uid()
    return opts


def out_of_time(signum, frame):
    raise Failed("secret-fill ran out of time")


def main(argv):
    value = None
    try:
        opts = options(argv)
        # An overall deadline: never linger with the value.
        signal.signal(signal.SIGALRM, out_of_time)
        signal.alarm(opts["deadline"])
        req = json.loads(sys.stdin.buffer.read(1 << 20).decode("utf-8"))
        if not isinstance(req, dict):
            raise ValueError
        value = req.get("value")
        out = run(req, opts)
        # The tab itself was held to top_origins (run refuses a request whose top_origins it can't apply).
        if "top_origins" in req and out.get("ok") is True:
            out["top_checked"] = True
    except Denied as e:
        out = {"ok": False, "denied": True, "reason": str(e)}
    except Failed as e:
        out = {"ok": False, "denied": False, "reason": str(e)}
    except (ValueError, UnicodeDecodeError):
        out = {"ok": False, "denied": False, "reason": "bad request"}
    except Exception as e:  # noqa: BLE001 - never a traceback (it could hold the value)
        out = {"ok": False, "denied": False, "reason": "guest error: " + type(e).__name__}
    signal.alarm(0)
    if withheld(out, value):
        out = {"ok": False, "denied": False, "reason": "result withheld (it contained the value)"}
    sys.stdout.write(json.dumps(out, ensure_ascii=True, separators=(",", ":")) + "\n")
    sys.stdout.flush()


if __name__ == "__main__":
    main(sys.argv[1:])
