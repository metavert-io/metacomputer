#!/bin/sh
# driver-mcp: the forced command behind the host's MCP SSH key.
# Runs Cua Driver's MCP server over stdio against the automation user's XFCE
# session. stdout carries JSON-RPC only; diagnostics go to stderr.
RUN="/run/user/$(id -u)/metacomputer"
i=0
while [ ! -s "$RUN/session.env" ] && [ "$i" -lt 90 ]; do sleep 1; i=$((i + 1)); done
if [ ! -s "$RUN/session.env" ]; then
  echo "metacomputer: the desktop session is not up (no $RUN/session.env)" >&2
  exit 1
fi
set -a
. "$RUN/session.env"
set +a
export CUA_DRIVER_RS_TELEMETRY_ENABLED=0 CUA_TELEMETRY_ENABLED=0 CUA_DRIVER_RS_UPDATE_CHECK=0
exec /usr/local/bin/cua-driver mcp
