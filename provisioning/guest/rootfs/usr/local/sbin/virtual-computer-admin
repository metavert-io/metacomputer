#!/bin/sh
# virtual-computer-admin: the only command the cuaadmin account may run with sudo
# after provisioning (see /etc/sudoers.d/90-virtual-computer). Each verb is fixed; no
# argument reaches a shell.
set -eu
PATH=/usr/sbin:/usr/bin:/sbin:/bin
case "${1:-}" in
  restart-desktop) systemctl restart lightdm ;;
  reboot)          systemctl reboot ;;
  poweroff)        systemctl poweroff ;;
  status)          systemctl is-system-running || true; systemctl --failed --no-pager --no-legend || true ;;
  logs)
    N="${2:-200}"
    case "$N" in ''|*[!0-9]*) echo "logs: N must be a number" >&2; exit 2 ;; esac
    journalctl --no-pager -b -n "$N" ;;
  provision-log)   cat /var/log/virtual-computer-provision.log ;;
  updates)         apt-get -q update && unattended-upgrade -v ;;
  firewall)        ufw status verbose ;;
  *) echo "usage: virtual-computer-admin restart-desktop|reboot|poweroff|status|logs [N]|provision-log|updates|firewall" >&2; exit 2 ;;
esac
