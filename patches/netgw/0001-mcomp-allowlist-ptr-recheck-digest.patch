index 03aaaa1..ed0724c 100644
--- a/libs/cua/netgw/internal/policy/store.go
+++ b/libs/cua/netgw/internal/policy/store.go
@@ -2,6 +2,8 @@ package policy
 
 import (
 	"bytes"
