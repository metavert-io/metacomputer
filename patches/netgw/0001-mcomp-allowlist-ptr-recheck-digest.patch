+	"encoding/hex"
 	"os"
 	"sync"
 	"sync/atomic"
@@ -109,3 +111,12 @@ func (s *Store) Watch(interval time.Duration, kick <-chan struct{}, stop <-chan
 		}
 	}
 }
+
+// Digest is the sha256 (hex) of the rules file as last loaded (mcomp patch):
+// the host compares it with the file it wrote to know the gateway took it.
+func (s *Store) Digest() string {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	sum := sha256.Sum256(s.last)
+	return hex.EncodeToString(sum[:])
+}
