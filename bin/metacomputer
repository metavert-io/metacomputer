#!/bin/bash
# metacomputer: lifecycle for a disposable Ubuntu 24.04 ARM64 XFCE desktop (Lume VM)
# that Claude Code operates through Cua Driver's MCP server.
#
# Usage: metacomputer [--vm NAME] COMMAND [ARGS]     (short alias: mcomp)
#
#   --vm NAME                      act on the VM NAME (its settings: config/vms/NAME.env); MCOMP_VM=NAME does the
#                                  same. Without it: config/local.env's VM (MCOMP_CONFIG=FILE: that file's)
#   vm list [--json]               this checkout's VMs (settings files and the runner): state, disk, ports, baseline
#   vm create NAME [--ssh-port P --vnc-port P] [--no-build] [--yes]
#                                  a VM of its own: writes config/vms/NAME.env (ports, keys, folders, vault) and builds it
#   vm delete NAME [--confirm NAME] [--force] [--delete-vault] [--delete-volumes]
#                                  delete a VM, its baseline and config/vms/NAME.env, after you type its name
#                                  (--yes doesn't count); volumes and the vault folder stay unless their flag asks
#   start [--no-volumes] | stop [--force] | restart | status [--json] | reset [--yes] [--discard-unsynced]
#   who | release                  who is using the virtual computer / hand it over
#   where                          project, config, skill and results folders
#   call [--session NAME] TOOL ['JSON']
#                                  one Cua Driver tool call through the hub; with --session, element
#                                  tokens and driver state carry over to the next call with that name
#   hub [status [--json] | start | stop]   the hub: one connection per VM shared by every client
#   inspect [system|windows|processes|ports|files|browser] [--minutes N] [--json]
#                                  read-only snapshot of the VM (no GUI, changes nothing)
#   browser [default firefox|chrome | mode human|page|hybrid | profiles [--delete NAME]]
#   input-reset [--check]          remove the driver's leftover virtual input devices
#                                  (while one exists, Chrome ignores the keyboard); prints the count
#   desktop-restart                log the desktop out and in again (closes every app)
#   rename GUEST_PATH NEW_NAME     rename a file in the VM (a download saved under its id)
#   web compare|responsive|a11y|open-untrusted URL [...]   browser checks, no model needed
#   test [A B C D E F ...]         run the GUI smoke suite (records each test)
#   task start SLUG [--no-sync] | finish NAME   one folder per task (guest + host), artifacts listed; finished recording
#                                  turns copied to the Mac while it's open (TASK_SYNC_INTERVAL)
#   put HOST_PATH... [--to GUEST_DIR] [--overwrite]
#                                  copy files into the VM (default ~/Inbox), each checked by SHA-256; a
#                                  name that's taken lands as "name (1).ext" unless --overwrite
#   get GUEST_PATH [HOST_DIR] [--task NAME]    copy files out of the VM
#   shot [HOST_PATH] [--task NAME] screenshot of the whole VM desktop to the Mac
#   contact-sheet MP4 [OUT.png]    12 frames of a recording in one image
#   record start [NAME] [FPS] | stop | status | moments FILE
#                                  desktop recording (RECORD_FPS, RECORD_QUALITY, RECORD_TO, RECORD_DIR);
#                                  streamed to the Mac as it records unless RECORD_TO=guest
#   recordings [--sync] [N]
#   checkpoint NAME [--replace] [--with-volumes] | checkpoint --delete NAME [--yes] | checkpoints | restore NAME [--yes] [--discard-unsynced]
#   volume create NAME --size 20G [--dir PATH] | create NAME --folder PATH | list [--json] | delete NAME [--yes]
#          | resize NAME --size 40G
#                                  disk volumes (kept outside the VM) and Mac folders (shared, read-only unless
#                                  :rw), attached with VOLUMES=name[:mountpoint][:rw]
#   volume create NAME --s3 --bucket B --endpoint URL [--region R] [--prefix P] [--dir PATH]
#          | keys NAME (your own terminal) | test NAME | sync NAME [--force] [--resync]
#                                  S3 volumes: a folder kept in step with a bucket (rclone bisync, on the Mac)
#   refdisk create NAME --from FOLDER [--dir PATH] | list [--json] | delete NAME [--yes]
#                                  read-only reference disks, attached with REFDISKS=name[:mountpoint]
#   view [--open | --tailnet]      how to watch / take over the desktop (VNC); --open: Screen Sharing on this Mac,
#                                  the password on the clipboard for 45 s; --tailnet: how to publish it (you run it)
#   sh -c CMD | --file SCRIPT | -  [--cwd DIR] [--timeout S] [--max-output B] [--read-only] [--json] [--raw] [-- ARGS]
#                                  run bash in the VM as the desktop user, with the desktop's environment;
#                                  exit status = the script's (124 timeout, 125 refused, 255 couldn't run)
#   claude [start] [--token NAME] [--ttl 1h] [--model M] [--skip-permissions] [--session NAME] [--show] [-- ARGS]
#          | send TEXT [--wait] | read [--lines N] | wait | keys KEY... | show | status | renew [--ttl D]
#          | stop [--revoke]
#                                  Claude Code inside the VM, in tmux, signed in through the vault's proxy with a
#                                  short-lived token (the key stays on the Mac); driven with send/read
#   ssh [ops|admin] [CMD...]       shell into the guest
#   notify "TEXT" [--why login|captcha|2fa|dialog|approval|other] [--action "what to do"]
#                                  tell the user Claude is blocked on them (through the event sinks)
#   handoff --why captcha|login|2fa|other --say "what to do" [--timeout 15m] [--json]
#                                  hand the computer to the user and wait (Claude's actions pause meanwhile);
#                                  exit 0 done, 4 cancelled, 124 time limit
#   handoff done [--note TEXT] | cancel [--note TEXT] | wait | status   (done: the user, in their own terminal)
#   events [status | sink add|list|show|test|remove | tail [N] | emit FAMILY TYPE --message TEXT
#          | drain | watcher start|stop|status]
#                                  the optional event stream: webhook, OTLP, syslog-TLS, ntfy (docs/events.md)
#   mcp-lazy                       on-demand MCP bridge (what Claude Code sessions use; through the hub)
#   mcp                            the same as mcp-lazy; with MCOMP_DIRECT_BRIDGE=1 the hub's own SSH
#                                  connection to the driver (the hub; the transport tests)
#   setup [--no-chrome] [--no-build] [--yes]
#                                  finish or repair the setup (./install.sh; finished steps are skipped).
#                                  From the Claude Code plugin with no checkout yet: download it and set
#                                  everything up (get.sh; says what it will do and asks first)
#   build [--replace]              build the VM + baseline from scratch
#   baseline [--yes] [--discard-unsynced]  re-snapshot the current VM as the baseline
#   logs [N]                       tail host + guest logs
#   security [apply] [--json]      the optional hardening: action log, SSH certificates, bounded driver;
#                                  and the shell channel (VM_SHELL, SHELL_LOG)
#   actions [list [--days N] | show [FILE|latest] [--json] | verify [FILE...|--all] [--key PUB]]
#                                  the signed action log (ACTION_LOG=on in config/local.env)
#   secrets init | set NAME ... [--replace] | delete NAME | bind [VM] | session policy|delete NAME
#           | policy NAME [--approval session|each] [--answer-timeout 30m] | unlock [--for 30m] [--confirm each] [--touch-id]
#           | rekey | recover | rotate-session-key | approve ID [--passphrase] | rule add ... --for 8h
#           | import-passwords --browser chrome|--csv FILE | import-session --browser chrome --site HOST --name N --to-profile P
#           | audit-sink add|remove|show|test|list   the vault (in your own terminal; SECURITY.md "Secrets and logins")
#   secrets list | fill NAME --field password|username|otp|text [--profile P] | status | audit
#           | fill NAME --field password|username|otp --human [--window-id N]   (a human-mode browser: Firefox)
#           | login NAME --password-selector CSS [--username-selector CSS] | requests | deny ID | rule list|remove | lock
#           | session save NAME --profile P | session load NAME
#           | token NAME [--ttl 15m] | token renew ID|--all [--ttl 15m] | tokens | revoke ID|--all
#           | ask --site S --kind code|link --why TEXT [--into TAB/FIELD | --human] [--wait 5m] | give ID (stdin only)
#           | code --site S (--into TAB/FIELD | --human) < value | relay --from TAB/ELEMENT --to TAB/FIELD --site S
#           | fill --request ID | rule add code|relay ...   one-time codes and sign-in links (SECURITY.md)
#                                  use it from a session, without seeing values
#   learn report [--since 7d] [--project PATH] [--json] [--draft-with-claude] | review | list
#         | approve ID... | reject ID... | remove ID... | edit ID | add | bench --config TEST_ENV
#                                  mine your own sessions for repeated mistakes; approved lessons reach
#                                  every new session's instructions as advice (docs/learn.md)
# stop, reset, restore, baseline and test refuse while another session is
# using the computer (metacomputer who); --override proceeds anyway (ask first).
set -uo pipefail
# The Claude Code plugin's copy of this file (in Claude Code's plugin folder, when the plugin was
# installed from GitHub) has no settings, VM keys or tools: it runs the checkout ./install.sh set up,
# $MCOMP_HOME or else ~/.local/bin/metacomputer. Keep this first, before anything reads config.
mc_plugins="${CLAUDE_CODE_PLUGIN_CACHE_DIR:-${CLAUDE_CONFIG_DIR:-$HOME/.claude}/plugins}"
mc_in_plugins() { case "$1" in "$(readlink -f "$mc_plugins" 2>/dev/null || echo "$mc_plugins")"/*|"$HOME/.claude/plugins/"*) return 0 ;; esac; return 1; }
mc_self="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
if mc_in_plugins "$mc_self"; then
  for mc_to in ${MCOMP_HOME:+"$MCOMP_HOME/bin/metacomputer"} "$HOME/.local/bin/metacomputer"; do
    mc_to="$(readlink -f "$mc_to" 2>/dev/null)" || continue
    [ -f "$mc_to" ] && [ -x "$mc_to" ] && [ "$mc_to" != "$mc_self" ] && ! mc_in_plugins "$mc_to" && exec "$mc_to" "$@"
  done
  # No checkout yet. Only `setup` runs anything: /bin/bash with the get.sh that came in this plugin copy
  # (its root, beside bin/), which explains what it will do and asks first (--confirm). Only the options
  # below pass through; no setting or variable can point it at another script or repository.
  if [ "${1:-}" = setup ]; then
    shift; mc_args=(--confirm)
    while [ $# -gt 0 ]; do
      case "$1" in
        --dir) [ $# -ge 2 ] || { echo "metacomputer setup: --dir needs a folder" >&2; exit 2; }; mc_args+=(--dir "$2"); shift ;;
        --no-chrome|--no-build|--yes|-y|--dry-run|--help|-h) mc_args+=("$1") ;;
        *) echo "metacomputer setup: unknown option $1 (setup takes --dir DIR, --no-chrome, --no-build, --yes, --dry-run)" >&2; exit 2 ;;
      esac
      shift
    done
    mc_root="$(dirname "$(dirname "$mc_self")")"
    mc_get="$(readlink -f "$mc_root/get.sh" 2>/dev/null)"
    if [ -n "$mc_get" ] && [ "$mc_get" = "$mc_root/get.sh" ] && [ -f "$mc_get" ] && mc_in_plugins "$mc_get"; then
      exec /bin/bash "$mc_get" "${mc_args[@]}"
    fi
    printf '%s\n' "metacomputer setup: this plugin copy has no get.sh of its own (update the plugin: claude plugin update metacomputer@metacomputer)." \
      "Or set it up in Terminal: curl -fsSL https://raw.githubusercontent.com/metavert-io/metacomputer/main/get.sh | bash" >&2
    exit 1
  fi
  printf '%s\n' "metacomputer: this is the Claude Code plugin's copy, and this Mac has no metacomputer set up yet." \
    "Set it up from here (it says what it will do and asks first; macOS on Apple silicon; it builds the VM):" \
    "  $mc_self setup" \
    "or in Terminal: curl -fsSL https://raw.githubusercontent.com/metavert-io/metacomputer/main/get.sh | bash" \
    "or point MCOMP_HOME at an existing checkout." >&2
  exit 1
fi
SELF="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
LIB="$(dirname "$SELF")/../scripts/lib.sh"
# --vm NAME before the command picks the VM (scripts/lib.sh: config/vms/NAME.env; MCOMP_VM=NAME does the same).
MCOMP_VM_ARG=""
while [ $# -gt 0 ]; do
  case "$1" in
    --vm) [ $# -ge 2 ] && [ -n "$2" ] || { echo "metacomputer: --vm needs a VM name (metacomputer vm list)" >&2; exit 2; }
          MCOMP_VM_ARG="$2"; shift 2 ;;
    --vm=*) MCOMP_VM_ARG="${1#--vm=}"; [ -n "$MCOMP_VM_ARG" ] || { echo "metacomputer: --vm needs a VM name" >&2; exit 2; }; shift ;;
    *) break ;;
  esac
done
# shellcheck source=../scripts/lib.sh
. "$LIB"
# A caller that confirmed a VM (learn bench, the benchmark) names it in MCOMP_EXPECT_VM, and the hub pins the VM it
# serves (MCOMP_EXPECT_VM, _SSH_PORT, _HOSTKEY, from when it started): settings that now name another VM (they are
# shell code, and can change, or their file can be gone) stop every command here, before anything touches a VM.
mc_hint=""
[ -z "${MCOMP_HUB_PID:-}" ] || mc_hint=". This hub serves only the VM it started with (metacomputer hub stop ends it)"
if [ -n "${MCOMP_EXPECT_VM:-}" ] && [ "$MCOMP_EXPECT_VM" != "$VM_NAME" ]; then
  if [ -n "${MC_MISSING_CONFIG:-}" ]; then
    echo "metacomputer: the settings file for the VM '$MCOMP_EXPECT_VM' ($MC_MISSING_CONFIG) is gone, and without it the settings name '$VM_NAME'; refusing$mc_hint" >&2
  else
    echo "metacomputer: the settings now name the VM '$VM_NAME', not '$MCOMP_EXPECT_VM' as confirmed (MCOMP_EXPECT_VM); refusing$mc_hint" >&2
  fi
  exit 1
fi
if [ -n "${MCOMP_EXPECT_SSH_PORT:-}" ] && [ "$MCOMP_EXPECT_SSH_PORT" != "$SSH_PORT" ]; then
  echo "metacomputer: the settings now give $VM_NAME the SSH port $SSH_PORT, not $MCOMP_EXPECT_SSH_PORT as when this started (MCOMP_EXPECT_SSH_PORT); refusing$mc_hint" >&2
  exit 1
fi
if [ -n "${MCOMP_EXPECT_HOSTKEY:-}" ] && [ "$(grep -F "[127.0.0.1]:$SSH_PORT " "$KNOWN_HOSTS" 2>/dev/null | head -1)" != "$MCOMP_EXPECT_HOSTKEY" ]; then
  echo "metacomputer: $VM_NAME's pinned host key (known_hosts in its SSH_DIR) isn't the one it had when this started (MCOMP_EXPECT_HOSTKEY); refusing$mc_hint" >&2
  exit 1
fi
unset mc_hint

cmd="${1:-help}"; [ $# -gt 0 ] && shift
# Which VM: a checkout with no settings of its own refuses rather than guess (scripts/lib.sh vm_target_check), except
# for commands that act on no VM. Commands that change a VM, and the vault's, say which VM (and vault) first.
case "$cmd" in help|-h|--help|where|setup|vm|events|notify|learn|actions) ;; *) vm_target_check ;; esac
case "$cmd" in
  start|stop|restart|reset|restore|baseline|checkpoint|build|desktop-restart|test) vm_notice ;;
  security) [ "${1:-}" != apply ] || vm_notice ;;
  secrets) vm_notice vault ;;
  claude) case "${1:-}" in read|wait|status|_probe|_keeper|-h|--help|help) ;; *) vm_notice vault ;; esac ;;   # its token is the vault's
esac

# --- EVENTS HOOK (secrets) ---------------------------------------------------------
# `metacomputer secrets` comes from another branch. When it exits 3 ("vault locked"),
# needs_you.vault_locked goes to the event stream, however its dispatch line is
# written (an EXIT trap, so the merge needs no edit here). Subcommands that exec the
# vault directly (list, status, unlock, ...) never come back to run it; the paths
# Claude uses to fill (fill, session save|load) do. The vault's own events ("approval
# waiting", ...) come through the spool (architecture.md, "Event spool").
if [ "$cmd" = secrets ]; then trap 'rc=$?; trap - EXIT; events_hook_secrets_exit "$rc"; exit "$rc"' EXIT; fi

confirm() { # PROMPT
  [ "${ASSUME_YES:-0}" = 1 ] && return 0
  [ -t 0 ] || die "$1 — refusing without a terminal; re-run with --yes"
  printf '%s [y/N] ' "$1"; read -r a; [ "$a" = y ] || [ "$a" = Y ] || die "cancelled"
}

# --override / --yes / --discard-unsynced anywhere in the arguments; the rest stays in REST.
OVERRIDE=0
DISCARD_UNSYNCED=0
parse_flags() {
  REST=()
  for a in "$@"; do
    case "$a" in --override) OVERRIDE=1 ;; --yes) ASSUME_YES=1 ;; --discard-unsynced) DISCARD_UNSYNCED=1 ;; *) REST+=("$a") ;; esac
  done
}

# One controller at a time: refuse while another session is using the computer.
owners_check() {
  [ "$OVERRIDE" = 1 ] && return 0
  local rc=0; "$PY" "$LAB_ROOT/lib/owners.py" check || rc=$?
  [ $rc = 4 ] && die "the user has the computer (metacomputer handoff): wait until they run 'metacomputer handoff done' or 'cancel'"
  [ $rc = 0 ] || die "another session is using the virtual computer (metacomputer who). Ask before taking over; then re-run with --override, or run 'metacomputer release' first"
}

# For a command that acts on the desktop from here (not through the hub): this VM's dispatch lock (lib/owners.py,
# dispatch()) taken shared on descriptor 6, then one last look for a handoff. While the user has the computer
# (metacomputer handoff) it stops with exit 4; otherwise the lock stays held until this command and what it runs
# end (they inherit descriptor 6), so no handoff opens meanwhile: opening one takes the lock exclusively.
handoff_hold() {
  [ "${HANDOFF_HELD:-}" = 1 ] && return 0   # once per command: opening it again would let go of it meanwhile
  local f="$RUN_DIR/owners/.dispatch"
  { mkdir -p "$RUN_DIR/owners" && ( umask 077; : >> "$f" ) && [ -f "$f" ] && [ ! -L "$f" ]; } 2>/dev/null \
    || die "couldn't open this VM's dispatch lock ($f)"
  exec 6>>"$f" || die "couldn't open this VM's dispatch lock ($f)"
  "$PY" "$LAB_ROOT/lib/handoff.py" guard --hold-fd 6 || exit 4
  HANDOFF_HELD=1
}
# The lifecycle commands (stop, reset, restore, baseline, desktop-restart): after any question, right before they
# change anything, and held until they're done; --override (you agreed) goes ahead as it does for another session.
handoff_hold_unless_override() { [ "$OVERRIDE" = 1 ] || handoff_hold; }

guest_path() { # PATH -> absolute guest path; refuses shell metacharacters
  local p="$1"
  case "$p" in "~") p="/home/$GUEST_USER" ;; "~/"*) p="/home/$GUEST_USER/${p#\~/}" ;; /*) ;; *) p="/home/$GUEST_USER/$p" ;; esac
  [[ "$p" =~ ^[A-Za-z0-9._/@+,:=\ -]+$ ]] || die "unsupported characters in guest path: $1"
  printf '%s' "$p"
}

abs_host_path() { case "$1" in /*) printf '%s' "$1" ;; *) printf '%s' "$PWD/$1" ;; esac; }
# A tar stream from the VM on stdin -> plain files and folders under DEST (lib/guest_import.py).
# Stops past the VM's disk size or when the Mac would have less than IMPORT_MIN_FREE_GB free beside the space
# other operations have claimed (lib/storage.py's claims: a recording being converted to MP4, an S3 sync).
guest_import() { # DEST [--quiet]
  MCOMP_IMPORT_MAX_BYTES="${VM_DISK_BYTES:-}" MCOMP_IMPORT_MIN_FREE_GB="${IMPORT_MIN_FREE_GB:-10}" \
    "$PY" "$LAB_ROOT/lib/guest_import.py" "$@"
}

need_running() { vm_running "$VM_NAME" || die "the virtual computer is off (metacomputer start)"; }

do_start() { # [--no-volumes]
  local novol=0 a
  for a in "$@"; do case "$a" in --no-volumes) novol=1 ;; *) die "usage: metacomputer start [--no-volumes]" ;; esac; done
  # The VM's lock (held already by reset, restore and baseline, which start it): never during a build, a delete
  # (`vm delete` holds it through its prompt) or another change of it.
  vm_lock_or_die "metacomputer start"
  vm_exists "$VM_NAME" || die "no VM '$VM_NAME' — run: metacomputer build"
  say "starting $VM_NAME"
  if vm_running "$VM_NAME" && ! netgw_alive; then
    warn "VM running without its gateway; restarting it cleanly"; vm_stop "$VM_NAME" --force; storage_release --quiet
  fi
  if vm_running "$VM_NAME"; then
    [ "$novol" = 1 ] && warn "already running: --no-volumes applies at the next start"
  else
    storage_prepare "$novol"
  fi
  vm_start "$VM_NAME"
  storage_started
  ok "VM running (gateway policy: config/netgw-rules.json)"
  wait_ssh ops 240 || { storage_abort; die "guest SSH did not come up (see logs/lume-$VM_NAME.log)"; }
  ok "SSH (127.0.0.1:$SSH_PORT, pinned host key)"
  sync_guest_options
  storage_attach
  wait_session 240 || die "XFCE session not ready (metacomputer ssh admin; sudo metacomputer-admin logs)"
  ok "XFCE session ready"
  mcp_probe >/dev/null && ok "Cua Driver MCP answers" || warn "Cua Driver MCP did not answer (metacomputer status)"
  emit_event lifecycle started info "The virtual computer $VM_NAME started" ""
  events_watcher_start
  say "ready. Live view: metacomputer view"
}

# --- storage (lib/storage.py, docs/storage.md): volumes and reference disks ------------
# Attached at `lume run` (no hot-plug), so: check and lock before the VM starts, mount once SSH
# is up, release after it stops. A problem before the VM starts refuses the start; one after it
# started stops it again, so the VM never runs with half its storage.
storage_py() { ( export_options; MCOMP_LAB_ROOT="$LAB_ROOT" "$PY" "$LAB_ROOT/lib/storage.py" "$@" ); }
storage_prepare() { # NOVOL(0|1): sets STORAGE_RUN_ARGS, or dies
  STORAGE_RUN_ARGS=()
  if [ "${1:-0}" = 1 ]; then storage_py prepare --pid $$ --no-volumes || exit 1
  else storage_py prepare --pid $$ || exit 1; fi
  local f="$RUN_DIR/storage-args" line
  if [ -s "$f" ]; then
    while IFS= read -r line; do STORAGE_RUN_ARGS+=("$line"); done < "$f"
  fi
  if [ "${1:-0}" = 1 ] && [ -n "${VOLUMES:-}${REFDISKS:-}" ]; then ok "--no-volumes: nothing of VOLUMES or REFDISKS is attached"; fi
  return 0
}
storage_started() { # the VM's process holds the locks; every attached path must still be what was checked
  [ -s "$RUN_DIR/storage-state.json" ] && [ -s "$RUN_DIR/lume.pid" ] || return 0
  storage_py started --pid "$(cat "$RUN_DIR/lume.pid")" && return 0
  storage_abort
  die "not started: its storage changed between the checks and the VM's start (above)"
}
storage_release() { storage_py release "$@" || true; }
storage_abort() { # the VM started but its storage can't be mounted or protected: stop it, release everything
  # Powered off from the Mac (vm_kill), never by asking the guest: a guest that stalls a shutdown request
  # would otherwise keep running with storage that isn't protected.
  [ -s "$RUN_DIR/storage-state.json" ] || return 0
  warn "stopping $VM_NAME again (powered off from the Mac), so it doesn't run without its storage"
  vm_kill "$VM_NAME"
  storage_release --quiet
}
storage_attach() { # the VM's answers are read with a size cap and a deadline (lib/storage.py guest_call)
  [ -s "$RUN_DIR/storage-plan.json" ] || return 0
  ssh_base admin
  storage_py attach --transport $(( ${#SSH_ARGS[@]} + 2 )) ssh -T "${SSH_ARGS[@]}"
  case $? in
    0) ;;
    3) storage_abort
       die "this VM can't mount storage: it was built before storage support. Rebuild it (metacomputer build --replace; volumes are kept), or start it with --no-volumes" ;;
    *) storage_abort
       die "not started: the VM couldn't mount its storage (above). Fix it, or start with --no-volumes" ;;
  esac
}

# --- the event watcher (docs/events.md): only while a sink is configured --------
# A detached process like the gateway (never a LaunchAgent): every 30 s it drains
# the spool, retries backlogs and reads new lines of netgw-blocked.jsonl; every
# 5 min a cheap health probe (metacomputer _health). start starts it, stop stops it.
events_watcher_pid() {
  local p; p="$(cat "$RUN_DIR/events-watcher.pid" 2>/dev/null)"
  [ -n "$p" ] && kill -0 "$p" 2>/dev/null && ps -o command= -p "$p" 2>/dev/null | grep -q 'events.py watch' && echo "$p"
  return 0
}
events_watcher_start() {
  "$PY" "$LAB_ROOT/lib/events.py" needs-watcher 2>/dev/null || return 0   # sinks, or announcements to deliver
  [ -n "$(events_watcher_pid)" ] && return 0
  ( umask 077; : >> "$LOG_DIR/events-watcher.log" ); chmod 600 "$LOG_DIR/events-watcher.log" 2>/dev/null
  ( export_options; daemonize "$LOG_DIR/events-watcher.log" "$PY" "$LAB_ROOT/lib/events.py" watch )
  local i=0; while [ -z "$(events_watcher_pid)" ] && [ $i -lt 20 ]; do sleep 0.25; i=$((i + 1)); done
  if [ -n "$(events_watcher_pid)" ]; then ok "event watcher running (metacomputer events status)"
  else warn "the event watcher did not start (see $LOG_DIR/events-watcher.log)"; fi
}
events_watcher_stop() {
  local p i=0 target; p="$(events_watcher_pid)"
  if [ -n "$p" ]; then
    # The watcher leads its own process group (daemonize), so signal the group: a health probe it
    # started (metacomputer _health and its ssh) stops with it.
    target="$p"; [ "$(ps -o pgid= -p "$p" 2>/dev/null | tr -d ' ')" = "$p" ] && target="-$p"
    kill -TERM -- "$target" 2>/dev/null
    while kill -0 "$p" 2>/dev/null && [ $i -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
    kill -0 "$p" 2>/dev/null && kill -9 -- "$target" 2>/dev/null
  fi
  rm -f "$RUN_DIR/events-watcher.pid"
}
do_events_watcher() { # start|stop|status
  case "${1:-status}" in
    start)  "$PY" "$LAB_ROOT/lib/events.py" needs-watcher || die "no event sinks configured, and no announcement to deliver"
            events_watcher_start ;;
    stop)   events_watcher_stop; ok "event watcher stopped" ;;
    status) local p; p="$(events_watcher_pid)"
            if [ -n "$p" ]; then echo "event watcher running (pid $p; log $LOG_DIR/events-watcher.log)"; else echo "event watcher not running"; fi ;;
    *) die "usage: metacomputer events watcher start|stop|status" ;;
  esac
}

do_health() { # internal (the event watcher): VM, gateway, SSH, guest-status, desktop recording; no MCP, no GUI work
  local vm_state gw=false ssh_ok=false gs="{}" rec_status="" rec_mode="" rec_name="" rec_pid=""
  vm_state="$(vm_exists "$VM_NAME" && vm_status "$VM_NAME" || echo missing)"
  netgw_alive && gw=true
  if [ -s "$RUN_DIR/manual-recording" ]; then
    rec_mode="$(sed -n 's/^mode=//p' "$RUN_DIR/manual-recording")"; rec_name="$(sed -n 's/^name=//p' "$RUN_DIR/manual-recording")"
    rec_pid="$(sed -n 's/^pid=//p' "$RUN_DIR/manual-recording")"
  fi
  if [ "$vm_state" = running ] && $gw && gssh ops true >/dev/null 2>&1; then
    ssh_ok=true
    gs="$(gssh ops /opt/metacomputer/bin/guest-status 2>/dev/null || echo '{}')"
    [ -n "$rec_name" ] && rec_status="$(vm_answer 4096 15 /opt/metacomputer/bin/desktop-record status 2>/dev/null)"
  fi
  local pid_alive=""; [ -n "$rec_pid" ] && { kill -0 "$rec_pid" 2>/dev/null && pid_alive=1 || pid_alive=0; }
  "$PY" - "$vm_state" "$gw" "$ssh_ok" "$gs" "$rec_name" "$rec_mode" "$rec_status" "$pid_alive" <<'EOF'
import json, sys
vm, gw, ssh, gs, name, mode, rstat, pid_alive = sys.argv[1:]
try:
    gs = json.loads(gs or "{}")
except ValueError:
    gs = {}
rec = {"expected": bool(name), "name": name or None, "mode": mode or None, "running": None}
if name and ssh == "true":
    rec["running"] = rstat.startswith("recording") and (mode != "host" or pid_alive != "0")
# The VM chooses everything guest-status says, and may hold a value from the vault: a number or a string of its
# could spell one (a doctor "exit code" of int.from_bytes(password)). So only fixed categories leave here: yes/no
# for the desktop's parts, the doctor's result as ok/failed/unknown, free disk as ok/low/unknown. Never its values.
def is_int(v):
    return isinstance(v, int) and not isinstance(v, bool)
def number(v):
    return isinstance(v, (int, float)) and not isinstance(v, bool) and v == v and abs(v) != float("inf")
guest = {}
if isinstance(gs, dict) and gs:
    rc = gs.get("driver_doctor_rc")
    disk = gs.get("disk_free_gb")
    guest = {k: gs.get(k) is True for k in ("ready", "xorg_running", "xfce_session_running", "atspi_bus")}
    guest["driver_doctor"] = None if rc is None else ("ok" if is_int(rc) and rc == 0 else "failed" if is_int(rc) else "unknown")
    guest["disk"] = ("unknown" if not number(disk) or disk < 0 else "low" if disk < 3 else "ok")
print(json.dumps({"vm": vm, "gateway": gw == "true", "ssh": ssh == "true", "guest": guest, "recording": rec}))
EOF
}

# Text the VM wrote, on its way to this terminal: escaped there (lib/termsafe.py), exact in a pipe or file.
term_safe() { if [ -t 1 ]; then "$PY" "$LAB_ROOT/lib/termsafe.py"; else cat; fi; }
esc_text() { printf '%s' "$1" | "$PY" "$LAB_ROOT/lib/termsafe.py"; }   # one value from the VM, for a message
mcp_probe() { ( export_options; "$PY" "$LAB_ROOT/lib/mcomp_sdk.py" probe ); }   # through the hub, like every client

# --- the hub (lib/mcp_hub.py): one process per VM holds the connection to the driver -----
hub_stop() { ( export_options; "$PY" "$LAB_ROOT/lib/mcp_hub.py" stop --quiet ) || true; }
do_hub() { # [status [--json|--brief] | start | stop | env --json]
  export_options
  case "${1:-status}" in
    env)    "$PY" -c 'import json, os; print(json.dumps({k: v for k, v in os.environ.items() if k.startswith("MCOMP_")}))' ;;
    status|start|stop) exec "$PY" "$LAB_ROOT/lib/mcp_hub.py" "$@" ;;
    serve)  exec "$PY" "$LAB_ROOT/lib/mcp_hub.py" serve ;;
    *) die "usage: metacomputer hub [status [--json|--brief] | start | stop]" ;;
  esac
}

do_stop() { # [--force] (immediate power-off) [--override] (even if another session is using it)
  parse_flags "$@"
  local force=""; for a in ${REST[@]+"${REST[@]}"}; do [ "$a" = --force ] && force=--force; done
  vm_exists "$VM_NAME" || die "no VM '$VM_NAME'"
  if vm_running "$VM_NAME"; then
    owners_check
    handoff_hold_unless_override
    events_watcher_stop   # first, so its health probe doesn't report the shutdown as a problem
    hub_stop
    say "stopping $VM_NAME (graceful, then forced after 90 s)"
    if [ -s "$RUN_DIR/manual-recording" ]; then
      say "finishing the desktop recording first"
      # In a subshell: a recording that can't be saved ends with die, which must not end the stop too.
      ( do_record stop ) || warn "could not finish the recording (metacomputer record stop)"
    fi
    vm_answer 64 15 'pgrep -x ffmpeg >/dev/null && echo busy' 2>/dev/null | grep -q busy && warn "a recording was running; stop it first with 'metacomputer record stop' to keep it"
    vm_stop "$VM_NAME" "$force"
    storage_release
    emit_event lifecycle stopped info "The virtual computer $VM_NAME stopped" "" "forced=$([ -n "$force" ] && echo yes || echo no)"
  else
    if [ -s "$RUN_DIR/manual-recording" ]; then
      # The VM went away while recording (a crash, a power-off): what was streamed is saved now.
      say "finishing the desktop recording first"
      ( do_record stop ) || warn "could not finish the recording (metacomputer record stop)"
    fi
    netgw_stop
    events_watcher_stop
    hub_stop
    storage_release --quiet
  fi
  ok "stopped"
}

do_security() { # [apply] [--json]: the optional hardening (SECURITY.md) as configured and as the VM has it
  local json=0 apply=0 a; for a in "$@"; do case "$a" in --json) json=1 ;; apply) apply=1 ;; *) die "usage: metacomputer security [apply] [--json]" ;; esac; done
  local vm_ssh="" vm_drv=""
  if vm_running "$VM_NAME" && gssh admin true >/dev/null 2>&1; then
    [ "$apply" = 1 ] && sync_guest_options all
    vm_ssh="$(guest_option ssh-auth)"; vm_drv="$(guest_option driver-policy)"
  elif [ "$apply" = 1 ]; then
    die "the virtual computer is off; start it (start applies these settings too)"
  fi
  local req="" req_err=""
  if [ "${DRIVER_MODE:-standard}" = bounded ]; then
    req_err="$(export_options; "$PY" "$LAB_ROOT/lib/driver_profiles.py" render 2>&1 >/dev/null)" || true
  fi
  export_options
  local stg; stg="$(storage_py status --json 2>/dev/null || echo '{}')"
  record_env
  [ -z "${VAULT_DIR:-}" ] || export MCOMP_VAULT_DIR="$VAULT_DIR"   # this VM's vault (its approvals line below)
  "$PY" - "$json" "$vm_ssh" "$vm_drv" "$req_err" "$(ca_pub)" "$LOG_DIR/actions" "$LAB_ROOT/lib" "$stg" "$VAULT_BIN" <<'EOF'
import json, os, subprocess, sys
js, vm_ssh, vm_drv, req_err, ca_pub, logdir, libdir, stg, vault_bin = sys.argv[1:]
sys.path.insert(0, libdir)
import storage
import vm_shell
try:
    stg = json.loads(stg or "{}")
except ValueError:
    stg = {}
e = os.environ.get
log_on = e("MCOMP_ACTION_LOG") == "on"
key = e("MCOMP_ACTION_LOG_KEY", "")
def fp(pub):
    if not os.path.exists(pub):
        return None
    r = subprocess.run(["ssh-keygen", "-l", "-f", pub], capture_output=True, text=True)
    return (r.stdout.split() or [None, None])[1]
out = {
  "action_log": {"setting": e("MCOMP_ACTION_LOG", "off"), "text": e("MCOMP_ACTION_LOG_TEXT", "redact"), "dir": logdir,
                 "signing_key": key, "key_fingerprint": fp(key if key.endswith(".pub") else key + ".pub")},
  "ssh_auth": {"setting": e("MCOMP_SSH_AUTH", "key"), "vm": vm_ssh or None, "ca_fingerprint": fp(ca_pub)},
  "driver": {"setting": e("MCOMP_DRIVER_MODE", "standard"),
             "profile": (e("MCOMP_DRIVER_MANIFEST") and "manifest: " + e("MCOMP_DRIVER_MANIFEST")) or e("MCOMP_DRIVER_PROFILE"),
             "origins": e("MCOMP_DRIVER_ORIGINS", "").split(), "expires": e("MCOMP_DRIVER_EXPIRES"), "idle": e("MCOMP_DRIVER_IDLE"),
             "vm_policy": vm_drv or None, "problem": req_err.strip() or None},
  "shell": vm_shell.describe_settings(),
  "storage": storage.security_summary(stg),
}
try:
    import learn_store
    out["lessons"] = learn_store.summary()
except Exception:
    out["lessons"] = None
# The vault's approvals: presence mode (Touch ID / login password / passphrase for every approval) or typed answers.
vs = None
if os.access(vault_bin, os.X_OK):
    try:
        r = subprocess.run([vault_bin, "status", "--json"], capture_output=True, text=True, timeout=20)
        vs = json.loads(r.stdout) if r.returncode == 0 else None
    except (OSError, ValueError, subprocess.TimeoutExpired):
        vs = None
if vs is not None:
    on = vs.get("presence", vs.get("presence_default"))
    out["vault"] = {"approvals": ("presence" if on else "typed") if on is not None else None, "why": vs.get("presence_why"),
                    "unlocked": vs.get("unlocked"), "decided": "presence" in vs}
import recording
out["recordings"] = recording.settings_summary()
if js == "1":
    print(json.dumps(out, indent=2)); sys.exit(0)
def y(b): return "\033[33m" + b + "\033[0m"
a, s, d = out["action_log"], out["ssh_auth"], out["driver"]
from termsafe import escape_for_terminal as _esc   # what the VM reports about itself, escaped on the terminal
s["vm"] = _esc(s["vm"]) if s["vm"] else s["vm"]
d["vm_policy"] = _esc(d["vm_policy"]) if d["vm_policy"] else d["vm_policy"]
print("Optional hardening (all off by default, which is Cua's own behavior; SECURITY.md)")
print(f"  action log   {y('on') if log_on else 'off'}" + (f"   text {a['text']}, signed with {a['key_fingerprint'] or 'a key made on first use'}; "
      f"metacomputer actions verify" if log_on else "   ACTION_LOG=on: a signed, hash-chained record of every tool call"))
vm = f"   VM: {s['vm']}" if s["vm"] else ""
print(f"  SSH          {y('certificates') if s['setting'] == 'cert' else 'static keys'}{vm}"
      + (f"   CA {s['ca_fingerprint'] or '(made at next start)'}, each certificate valid {e('MCOMP_SSH_CERT_TTL', '5m')}" if s["setting"] == "cert" else
         "   SSH_AUTH=cert: a short-lived certificate per connection"))
if d["setting"] == "bounded":
    extra = f"   profile {d['profile']}" + (f" ({' '.join(d['origins'])})" if d["origins"] else "") + f", lasts {d['expires']}, idle {d['idle']}"
else:
    extra = "   DRIVER_MODE=bounded: Cua Driver runs only what a manifest lists"
vmd = f"   VM: {d['vm_policy']}" if d["vm_policy"] else ""
print(f"  driver       {y('bounded') if d['setting'] == 'bounded' else 'standard'}{vmd}{extra}")
if d["problem"]:
    print(f"  ! {d['problem']}")
if (s["vm"] and s["vm"] != s["setting"]) or (d["vm_policy"] and d["vm_policy"] != d["setting"]):
    print("  ! the VM doesn't match the config yet: metacomputer security apply (start does it too)")
sh = out["shell"]
print("Shell channel (metacomputer sh: bash in the VM; docs/shell.md)")
if sh["effective"] == "on":
    logged = (f"each run in the action log (text {sh['text']})" if sh["logged"] else
              "runs aren't logged (SHELL_LOG=off)" if sh["log"] == "off" else "runs aren't logged (the action log is off)")
    print(f"  shell        on   {sh['why']}; {logged}")
else:
    print(f"  shell        {y('off')}  {sh['why']}: metacomputer sh refuses"
          + ("; VM_SHELL=on allows it in bounded mode" if sh["setting"] == "auto" else ""))
for pr in sh["problems"]:
    print(f"  ! {pr}")
if out["lessons"] is not None:
    lo = out["lessons"]
    print("Lessons (metacomputer learn: notes you approved, sent to the model as advice; no guard reads them; docs/learn.md)")
    print(f"  lessons      {_esc(learn_store.status_line(dict(lo, problem=None, warning=None))) if not lo.get('problem') else 'none sent'}"
          "   (metacomputer learn list)")
    for pr in (lo.get("problem"), lo.get("warning")):
        if pr:
            print(f"  ! {_esc(pr)}")
for line in storage.describe_security(out["storage"]):
    print(line)
for line in recording.security_lines(out["recordings"]):
    print(line)
v = out.get("vault")
if v and v["approvals"]:
    print("Secrets vault approvals (SECURITY.md, \"Approving from elsewhere\")")
    print(f"  approvals    {'presence mode' if v['approvals'] == 'presence' else y('typed')}   {_esc(str(v['why']))}"
          + ("" if v["decided"] else "; by default here (`metacomputer secrets presence on|off|auto` or an unlock flag changes it)"))
EOF
}

do_status() {
  local json=0; [ "${1:-}" = "--json" ] && json=1
  local vm_state lease ssh_ok=false gs="{}" mcp="{}" hs="" layout=current
  vm_state="$(vm_exists "$VM_NAME" && vm_status "$VM_NAME" || echo missing)"
  local base_state; base_state="$(vm_exists "$BASELINE_NAME" && echo present || echo missing)"
  local gw=false fwd=""
  netgw_alive && gw=true
  fwd="$(lsof -nP -iTCP:"$SSH_PORT" -sTCP:LISTEN 2>/dev/null | awk 'NR>1{print $9}' | sort -u | tr '\n' ' ')"
  lease=""
  if [ "$vm_state" = running ] && $gw; then
    lease="$(netgw_control "lease $(vm_mac "$VM_NAME")")"
    if gssh ops true >/dev/null 2>&1; then
      ssh_ok=true
      # VMs built by earlier versions keep their helpers in /opt/cua-lab or /opt/virtual-computer.
      gssh ops 'test -x /opt/metacomputer/bin/guest-status || { test ! -d /opt/cua-lab && test ! -d /opt/virtual-computer; }' >/dev/null 2>&1 || layout=old
      gs="$(gssh ops /opt/metacomputer/bin/guest-status 2>/dev/null || echo '{}')"
      mcp="$(mcp_probe 2>/dev/null)" || true   # a failed probe still prints its JSON line (ok: false)
      # What the VM actually has from the host: virtio console port names (the
      # SPICE clipboard port), virtio device ids (0x0019 = sound) and virtiofs
      # tags (the Rosetta share is tagged "rosetta").
      hs="$(gssh ops 'cat /sys/class/virtio-ports/*/name 2>/dev/null; echo ---; cat /sys/bus/virtio/devices/*/device 2>/dev/null; echo ---; cat /sys/fs/virtiofs/*/tag 2>/dev/null' 2>/dev/null || true)"
    fi
  fi
  export_options
  local ev; ev="$("$PY" "$LAB_ROOT/lib/events.py" status --json 2>/dev/null || echo '{}')"
  local hub; hub="$("$PY" "$LAB_ROOT/lib/mcp_hub.py" status --json 2>/dev/null || echo '{}')"
  local stg; stg="$(storage_py status --json 2>/dev/null || echo '{}')"
  record_env
  "$PY" - "$json" "$vm_state" "$base_state" "$gw" "$fwd" "$lease" "$ssh_ok" "$gs" "$mcp" "${hs:-}" "$LUME" "$layout" "$ev" "$LAB_ROOT/lib" "$hub" "$stg" <<'EOF'
import json, math, os, re, sys
js, vm, base, gw, fwd, lease, sshok, gs, mcp, hs, lume, layout, ev, lib, hub, stg = sys.argv[1:]
def parsed(text):   # the VM side's JSON: anything that isn't an object is no report
    try:
        v = json.loads(text or "{}")
    except (ValueError, RecursionError):
        return {}
    return v if isinstance(v, dict) else {}
gs = parsed(gs); mcp = parsed(mcp); stg = parsed(stg)
try:
    hub = json.loads(hub or "{}")
except ValueError:
    hub = {}
try:
    ev = json.loads(ev or "{}")
except ValueError:
    ev = {}
sharing = None
if hs:
    parts = (hs.split("---") + ["", "", ""])[:3]
    ports, devices, tags = (p.split() for p in parts)
    # Rosetta is a virtiofs device (0x001a); so is the share for folder volumes, when there is one.
    shares = 1 if any(i.get("kind") in ("folder", "s3") for i in (stg or {}).get("items", [])) else 0
    sharing = {"clipboard": "com.redhat.spice.0" in ports, "audio": "0x0019" in devices,
               "rosetta": "rosetta" in tags or (devices.count("0x001a") > shares and not tags)}
out = {"vm": vm, "baseline": base, "gateway": gw == "true", "forwards_on": fwd.split(),
       "lease": lease, "ssh": sshok == "true", "guest": gs, "mcp": mcp,
       "host_sharing": sharing, "lume": lume, "guest_layout": layout,
       "options": {"action_log": os.environ.get("MCOMP_ACTION_LOG", "off"), "ssh_auth": os.environ.get("MCOMP_SSH_AUTH", "key"),
                   "driver_mode": os.environ.get("MCOMP_DRIVER_MODE", "standard"),
                   "driver_profile": os.environ.get("MCOMP_DRIVER_PROFILE", "") if os.environ.get("MCOMP_DRIVER_MODE") == "bounded" else None},
       "events": {k: ev.get(k) for k in ("sinks", "names", "watcher", "backlog", "failing")} if ev else None,
       "hub": hub or None,
       "storage": dict(stg, guest=gs.get("storage") if isinstance(gs.get("storage"), dict) else None) if stg else None}
sys.path.insert(0, lib)
try:
    import learn_store
    out["lessons"] = learn_store.summary()
except Exception:
    out["lessons"] = None
out["ready"] = bool(out["ssh"] and gs.get("ready") and mcp.get("ok"))
import recording
out["recordings"] = recording.settings_summary()
if js == "1":
    print(json.dumps(out, indent=2)); sys.exit(0 if out["ready"] else 1)
# The guest's status, the driver's handshake and the lease come from the VM side: every string is shown escaped.
sys.path.insert(0, lib)
from termsafe import escape_for_terminal as _esc
def esc_all(o, depth=0):
    if isinstance(o, str):
        return _esc(o)
    if isinstance(o, dict) and depth < 8:
        return {_esc(str(k)): esc_all(v, depth + 1) for k, v in o.items()}    # keys too: a value may be a dict
    if isinstance(o, list) and depth < 8:
        return [esc_all(v, depth + 1) for v in o]
    return o if isinstance(o, (int, float, bool, type(None))) else _esc(repr(o))
gs, mcp, lease, fwd = esc_all(gs), esc_all(mcp), _esc(lease), _esc(fwd)
def m(b): return "\033[32m✓\033[0m" if b else "\033[31m✗\033[0m"
print(f"VM            {vm}    baseline: {base}")
print(f"gateway       {m(out['gateway'])} cua-netgw   forwards listening on: {fwd or '-'}   lease: {lease or '-'}")
print(f"ssh           {m(out['ssh'])}")
if layout == "old":
    print("guest         \033[33mbuilt by an earlier version (older layout)\033[0m: rebuild it with "
          "'metacomputer build --replace' (or start a new VM under another VM_NAME)")
if gs:
    print(f"desktop       {m(gs.get('xorg_running'))} Xorg  {m(gs.get('xfce_session_running'))} XFCE  "
          f"{m(gs.get('session_env_published'))} session env  resolution {gs.get('resolution')}")
    print(f"accessibility {m(gs.get('atspi_bus'))} AT-SPI bus  {m(gs.get('toolkit_accessibility'))} toolkit-accessibility")
    print(f"active window {gs.get('active_window_title')!r}   windows: {len(gs.get('windows', []))}")
    print(f"driver        {gs.get('driver_version')}   doctor rc={gs.get('driver_doctor_rc')}   uinput {m(gs.get('uinput_writable'))}")
    print(f"live view     {m(gs.get('x11vnc_running'))} x11vnc (metacomputer view)")
    sf = gs.get("secrets_fill") or {}
    if sf.get("present"):
        print(f"secrets       {m(sf.get('script_root_owned') and sf.get('keys_root_owned') and sf.get('home_root_owned'))} "
              "fill account (mcfill) for metacomputer secrets")
    else:
        print("secrets       no fill account: built before secrets support (rebuild to use metacomputer secrets)")
    sp = gs.get("secrets_proxy") or {}
    if sp.get("present"):
        print(f"api proxy     {m(sp.get('keys_root_owned'))} proxy account (mcproxy) for metacomputer secrets tokens")
    elif sf.get("present"):
        print("api proxy     no proxy account: built before API tokens (rebuild to use metacomputer secrets token)")
    sk = gs.get("ssh_keys") if isinstance(gs.get("ssh_keys"), dict) else {}
    if sk.get("outside_home") is True:
        print(f"ssh keys      {m(True)} root-owned, outside the home folder: wiping it can't lock this Mac out")
    else:
        print("ssh keys      \033[33min the home folder\033[0m (built before root-owned key lists): something that wipes it "
              "cuts SSH off until reset; rebuild to change that")
    if gs.get("virtual_audio"):
        print("sound         virtual sound card: plays into nothing, recordings include it")
    def num(v):    # a number from the guest's report, shown as one; anything else (or past 10^15) is '?'
        if isinstance(v, str) and re.fullmatch(r"-?[0-9]{1,12}(\.[0-9]{1,6})?", v):
            v = float(v)
        if isinstance(v, bool) or not isinstance(v, (int, float)):
            return "?"
        if isinstance(v, int):                       # compared as an int: a 400-digit one never becomes a float
            return str(v) if -10 ** 15 < v < 10 ** 15 else "?"
        return f"{v:g}" if math.isfinite(v) and abs(v) < 1e15 else "?"
    la = gs.get("loadavg")
    load = " ".join(num(x) for x in la) if isinstance(la, list) and 0 < len(la) <= 3 else "?"
    up = num(gs.get("uptime_s", 0))
    print(_esc(f"guest         up {up.split('.')[0]} s, load {load}, {num(gs.get('mem_available_mb'))} MB free, "
               f"{num(gs.get('disk_free_gb'))} GB disk free" + ("  REBOOT REQUIRED (updates)" if gs.get('reboot_required') else "")))
if mcp:
    print(f"mcp           {m(mcp.get('ok'))} {mcp.get('server', '')} {mcp.get('protocol', '')}  tools={mcp.get('tools', 0)}  ({mcp.get('ms', '?')} ms)")
if hub.get("running"):
    sys.path.insert(0, lib)
    import mcp_hub
    print(f"hub           {mcp_hub.describe_status(hub.get('hub'), brief=True)}   (metacomputer hub)")
elif hub:
    print("hub           " + ("off (MCP_HUB=off: each client connects on its own)" if hub.get("mode") == "off"
                             else "not running (it starts with the first call)"))
if sharing is not None:
    def onoff(k): return ("\033[33mon\033[0m" if sharing[k] else "off")
    runner = os.path.basename(lume) + (", mcomp-vm's former name" if os.path.basename(lume) == "lume-secure" else "")
    print(f"host sharing  clipboard {onoff('clipboard')}  audio {onoff('audio')}  rosetta {onoff('rosetta')}"
          f"   (seen from inside the VM; Lume: {runner})")
o = out["options"]
if o["action_log"] == "on" or o["ssh_auth"] == "cert" or o["driver_mode"] == "bounded":
    parts = (["action log on"] if o["action_log"] == "on" else []) + (["SSH certificates"] if o["ssh_auth"] == "cert" else []) \
        + ([f"driver bounded ({o['driver_profile'] or 'manifest'})"] if o["driver_mode"] == "bounded" else [])
    print(f"hardening     {' · '.join(parts)}   (metacomputer security)")
if ev.get("sinks"):
    sys.path.insert(0, lib)
    import events
    print(f"events        {events.status_line(ev)}   (metacomputer events)")
if out["lessons"] is not None:
    print(f"lessons       {_esc(learn_store.status_line(out['lessons']))}   (metacomputer learn list)")
if stg:
    sys.path.insert(0, lib)
    import storage
    for line in storage.describe_status(stg, gs.get("storage") if isinstance(gs.get("storage"), dict) else None, vm == "running"):
        print(line)
print(recording.status_line(out["recordings"]))
print(f"READY         {m(out['ready'])}")
sys.exit(0 if out["ready"] else 1)
EOF
}

# A caller that confirmed what a reset replaces (learn bench, the benchmark) names it in MCOMP_EXPECT_VM,
# MCOMP_EXPECT_BASELINE and MCOMP_EXPECT_CONFIG_SHA. Checked here, in the process that replaces the VM, with the
# VM and baseline names it is about to use, and again right before the copy: any mismatch refuses.
expect_guard() {
  local why="" sha
  if [ -n "${MCOMP_EXPECT_VM:-}" ] && [ "$MCOMP_EXPECT_VM" != "$VM_NAME" ]; then
    why="the VM is '$VM_NAME', not '$MCOMP_EXPECT_VM' as confirmed"
  elif [ -n "${MCOMP_EXPECT_BASELINE:-}" ] && [ "$MCOMP_EXPECT_BASELINE" != "$BASELINE_NAME" ]; then
    why="the baseline is '$BASELINE_NAME', not '$MCOMP_EXPECT_BASELINE' as confirmed"
  elif [ -n "${MCOMP_EXPECT_CONFIG_SHA:-}" ]; then
    sha="$(shasum -a 256 < "$LOCAL_CONFIG" 2>/dev/null | cut -d' ' -f1)"
    [ "$sha" = "$MCOMP_EXPECT_CONFIG_SHA" ] || why="the settings file $LOCAL_CONFIG changed since it was confirmed (sha256 ${sha:0:12}, confirmed ${MCOMP_EXPECT_CONFIG_SHA:0:12})"
  fi
  [ -z "$why" ] || die "refusing to replace the VM: $why"
}

restore_from() { # SOURCE_VM LABEL EVENT_TYPE: replace the working VM with a copy of SOURCE_VM, then start it
  local src="$1" label="$2" evtype="${3:-restored}"
  vm_lock_or_die "restoring $VM_NAME"   # held already by its callers (vm_change_lock: the identity rule checked)
  expect_guard
  if [ -s "$RUN_DIR/manual-recording" ]; then
    # A reset often follows a run that went wrong; the recording of it is saved before the VM goes, whether or
    # not the VM is still running (a streamed one is on this Mac either way).
    say "finishing the desktop recording first"
    ( do_record stop ) || warn "could not finish the recording (metacomputer record stop)"
  fi
  if vm_exists "$VM_NAME" && vm_running "$VM_NAME"; then
    sync_or_stop "$evtype"   # stops here, before anything is deleted, unless the copy is whole
    events_watcher_stop   # start brings it back; meanwhile the replacement isn't a health problem
    vm_stop "$VM_NAME"
    storage_release --quiet
  elif vm_exists "$VM_NAME"; then
    warn "the VM is stopped, so recordings still inside it (~/metacomputer-runs) aren't copied before it's replaced"
  fi
  if [ -n "${RESTORE_VOLUMES:-}" ]; then
    storage_py checkpoint restore "$RESTORE_VOLUMES" || die "the volumes couldn't be rolled back; the VM wasn't replaced"
  fi
  expect_guard   # again, right before the working VM is deleted and replaced
  if vm_exists "$VM_NAME"; then runner_delete "$VM_NAME" >/dev/null || die "$VM_NAME wasn't deleted (above); it wasn't replaced"; fi
  say "cloning $src -> $VM_NAME"
  "$LUME" clone "$src" "$VM_NAME" >/dev/null || die "lume clone failed"
  ok "restored from $label"
  emit_event lifecycle "$evtype" info "The virtual computer $VM_NAME was replaced by $label" "" "from=$src"
  do_start
}

do_reset() {
  parse_flags "$@"
  vm_change_lock "metacomputer reset"
  expect_guard
  vm_exists "$BASELINE_NAME" || die "no baseline '$BASELINE_NAME' to restore from"
  owners_check
  confirm "Replace the working VM '$VM_NAME' with a fresh copy of '$BASELINE_NAME'? (host recordings and results are kept$(unsynced_note))"
  handoff_hold_unless_override
  restore_from "$BASELINE_NAME" baseline reset
}

CKPT_PREFIX="$VM_NAME-ckpt-"
ckpt_name() { [[ "${1:-}" =~ ^[a-z0-9][a-z0-9-]{0,39}$ ]] || die "checkpoint names: lowercase letters, digits and dashes (max 40)"; }

do_checkpoint() { # NAME [--replace] [--with-volumes] | --delete NAME [--yes]
  parse_flags "$@"
  set -- ${REST[@]+"${REST[@]}"}
  vm_change_lock "metacomputer checkpoint"
  if [ "${1:-}" = "--delete" ]; then
    ckpt_name "${2:-}"; vm_exists "$CKPT_PREFIX$2" || die "no checkpoint '$2' (metacomputer checkpoints)"
    local vols; vols="$(storage_py checkpoint list "$2" 2>/dev/null)"
    confirm "Delete checkpoint '$2'${vols:+ (and its snapshot of volumes: $vols)}?"
    runner_delete "$CKPT_PREFIX$2" >/dev/null || die "checkpoint '$2' wasn't deleted (above)"
    storage_py checkpoint delete "$2" || warn "could not delete the volume snapshots of checkpoint '$2'"
    emit_event lifecycle checkpoint info "Checkpoint '$2' of $VM_NAME deleted" "" "name=$2" "change=deleted"
    ok "checkpoint '$2' deleted"; return 0
  fi
  local name="" replace=0 withvol=0 a
  for a in "$@"; do
    case "$a" in --replace) replace=1 ;; --with-volumes) withvol=1 ;; -*) die "usage: metacomputer checkpoint NAME [--replace] [--with-volumes]" ;; *) name="$a" ;; esac
  done
  ckpt_name "$name"
  vm_exists "$VM_NAME" || die "no VM '$VM_NAME'"
  vm_running "$VM_NAME" && die "a checkpoint is taken from the stopped computer: run 'metacomputer stop' first"
  if vm_exists "$CKPT_PREFIX$name"; then
    [ $replace = 1 ] || die "checkpoint '$name' exists (add --replace to overwrite it)"
    runner_delete "$CKPT_PREFIX$name" >/dev/null || die "checkpoint '$name' wasn't deleted (above); it wasn't replaced"
    storage_py checkpoint delete "$name" || true
  fi
  "$LUME" clone "$VM_NAME" "$CKPT_PREFIX$name" >/dev/null || die "lume clone failed"
  if [ $withvol = 1 ] && ! storage_py checkpoint save "$name"; then
    runner_delete "$CKPT_PREFIX$name" >/dev/null 2>&1
    die "checkpoint '$name' not saved: its volumes couldn't be snapshotted (above)"
  fi
  emit_event lifecycle checkpoint info "Checkpoint '$name' of $VM_NAME saved" "" "name=$name" "change=saved"
  ok "checkpoint '$name' saved$([ $withvol = 1 ] && echo ' with its volumes') (restore with: metacomputer restore $name)"
}

do_checkpoints() {
  local names n vols
  names="$("$LUME" ls --format json 2>/dev/null | "$PY" -c 'import json, sys
pre = sys.argv[1]; print("\n".join(sorted(v["name"][len(pre):] for v in json.load(sys.stdin) if v["name"].startswith(pre))))' "$CKPT_PREFIX")"
  [ -n "$names" ] || { echo "no checkpoints (metacomputer checkpoint NAME, with the computer stopped)"; return 0; }
  while IFS= read -r n; do
    vols="$(storage_py checkpoint list "$n" 2>/dev/null)"
    echo "$n${vols:+   (with volumes: $vols)}"
  done <<< "$names"
}

do_restore() { # NAME [--yes] [--override]
  parse_flags "$@"
  local name="${REST[0]:-}"; ckpt_name "$name"
  vm_change_lock "metacomputer restore $name"
  vm_exists "$CKPT_PREFIX$name" || die "no checkpoint '$name' (metacomputer checkpoints)"
  owners_check
  local vols; vols="$(storage_py checkpoint list "$name" 2>/dev/null)"
  confirm "Replace the working VM '$VM_NAME' with checkpoint '$name'? Its current state is discarded${vols:+, and volumes $vols go back to the checkpoint too} (host recordings and results are kept$(unsynced_note))"
  handoff_hold_unless_override
  RESTORE_VOLUMES="${vols:+$name}" restore_from "$CKPT_PREFIX$name" "checkpoint '$name'" restored
}

do_baseline() {
  parse_flags "$@"
  vm_change_lock "metacomputer baseline"
  owners_check
  confirm "Replace the baseline '$BASELINE_NAME' with the current state of '$VM_NAME'?"
  handoff_hold_unless_override
  local was_running=0; vm_running "$VM_NAME" && was_running=1
  # The baseline mustn't carry recordings, so they're copied and then deleted in the VM: only once the copy is whole.
  [ $was_running = 1 ] && { sync_or_stop baseline; events_watcher_stop; gssh ops 'rm -rf ~/metacomputer-runs/*' >/dev/null || true; vm_stop "$VM_NAME"; storage_release --quiet; }
  local keep="$BASELINE_NAME-prev"
  if vm_exists "$BASELINE_NAME"; then
    if vm_exists "$keep"; then runner_delete "$keep" >/dev/null || die "$keep wasn't deleted (above); the baseline wasn't replaced"; fi
    "$LUME" clone "$BASELINE_NAME" "$keep" >/dev/null || die "couldn't keep the baseline as $keep; it wasn't replaced"
    runner_delete "$BASELINE_NAME" >/dev/null || die "$BASELINE_NAME wasn't deleted (above); it wasn't replaced (the copy $keep stays)"
    ok "previous baseline kept as $keep"
  fi
  "$LUME" clone "$VM_NAME" "$BASELINE_NAME" >/dev/null || die "clone failed"
  emit_event lifecycle baseline info "The baseline $BASELINE_NAME was replaced by the current state of $VM_NAME" ""
  ok "baseline updated"
  [ $was_running = 1 ] && do_start
}

record_dir() { # the folder on the Mac for recordings (RECORD_DIR); made if only the last part is missing
  local d="${RECORD_DIR:-$LAB_ROOT/recordings/manual}"
  if [ ! -d "$d" ]; then
    # Only the last folder is created: a missing parent usually means a drive that isn't connected.
    [ -d "$(dirname "$d")" ] || die "RECORD_DIR $d: its parent folder doesn't exist (is the drive connected?)"
    mkdir "$d" || die "cannot create RECORD_DIR $d"
  fi
  printf '%s' "$d"
}

# The VM's short answers (the recorder's replies, a task folder's listing), read with a byte limit and a deadline
# (lib/recording.py capture): a VM that sends without end or never answers can't grow or stall the command. Prints
# the answer only when it fits; otherwise nothing, and a non-zero status.
vm_answer() { # MAX_BYTES TIMEOUT_S REMOTE_COMMAND...
  local max="$1" t="$2"; shift 2
  ssh_base ops
  "$PY" "$LAB_ROOT/lib/recording.py" capture --max-bytes "$max" --timeout "$t" -- ssh -T "${SSH_ARGS[@]}" "$@"
}
# A video file in the VM (RECORD_TO=guest) to a new file on the Mac, held to what the VM's disk can hold, to the
# free-space reserve (beside what other operations have claimed) and to deadlines: the VM going quiet for
# MCOMP_RECORD_WAIT seconds (60), or an hour in all, ends it (lib/recording.py save). Its stderr arrives escaped
# and capped.
vm_copy_video() { # GUEST_PATH OUT
  ssh_base ops
  "$PY" "$LAB_ROOT/lib/recording.py" save "$2" --min-free-gb "${IMPORT_MIN_FREE_GB:-10}" \
    --max-bytes "${VM_DISK_BYTES:-0}" --idle-timeout "${MCOMP_RECORD_WAIT:-60}" --timeout 3600 \
    -- ssh -T "${SSH_ARGS[@]}" "cat '$1'" 2> >("$PY" "$LAB_ROOT/lib/termsafe.py" --max 1048576 >&2)
}

# A tar stream from the VM (REMOTE_COMMAND over SSH) into DEST through guest_import (task finish, recordings
# --sync). It ends only when the VM has sent nothing for MCOMP_SYNC_IDLE seconds (120): a copy that keeps moving is
# never cut off, however large or slow. A VM that sends a byte now and then keeps it going until you stop it.
vm_tar_copy() { # DEST REMOTE_COMMAND [guest_import options...]
  local dest="$1" cmd="$2"; shift 2
  ssh_base ops
  guest_import "$dest" "$@" --idle-timeout "${MCOMP_SYNC_IDLE:-120}" -- ssh -T "${SSH_ARGS[@]}" "$cmd"
}

# Before reset, restore or baseline deletes the guest's ~/metacomputer-runs: copy it, and stop here (before
# anything is deleted) unless the copy is whole: the copy came through (recordings --sync), and the VM's own
# listing names no file this Mac doesn't have at that size (a copy can leave a file out), both checks every time:
# a listing that can't be had (the VM unreachable, or the listing over 4 MB) is never whole. A folder that's missing
# or empty is whole. Otherwise what's missing is listed, and it goes on only with --discard-unsynced, or when the
# person at the terminal types 'discard' at a prompt that names the loss; --yes never does.
sync_or_stop() { # WHAT (reset, restored, baseline)
  local what="$1" listing whole=0 rc=0 report
  [ "$what" = restored ] && what=restore
  say "saving guest recordings to the host first"
  do_recordings --sync >/dev/null && whole=1
  mkdir -p "$RUN_DIR"; listing="$(mktemp "$RUN_DIR/unsynced.XXXXXX")" || die "stopped before $what: nothing was deleted (cannot write in $RUN_DIR)"
  if ! vm_answer 4194304 60 'cd ~/metacomputer-runs 2>/dev/null || exit 0; find . -type f -printf "%s\t%P\0"' > "$listing" 2>/dev/null; then
    rm -f "$listing"
    listing="$listing.unavailable"      # recording.py says the VM couldn't be asked: never whole, even after a copy
  fi
  report="$("$PY" "$LAB_ROOT/lib/recording.py" unsynced "$LAB_ROOT/recordings/guest-runs" "$listing" 2>&1)" || rc=$?
  rm -f "${listing%.unavailable}"
  [ $whole = 1 ] && [ $rc = 0 ] && return 0
  warn "the recordings in the VM (~/metacomputer-runs) weren't copied in full, and $what would delete them"
  [ -z "$report" ] || printf '%s\n' "$report" >&2
  if [ "${DISCARD_UNSYNCED:-0}" = 1 ]; then
    warn "going on without them (--discard-unsynced)"; return 0
  fi
  if [ -t 0 ] && [ -t 2 ]; then
    local a=""
    printf '%s' "Go on with $what and lose what wasn't copied? Type 'discard' to go on, anything else to stop: " >&2
    read -r a || a=""
    [ "$a" = discard ] && { warn "going on without them"; return 0; }
  fi
  die "stopped before $what: nothing was deleted. Try the copy again (metacomputer recordings --sync), or run metacomputer $what again with --discard-unsynced to go on without what wasn't copied"
}
# For reset's and restore's prompt: a VM that isn't running can't be asked for its recordings.
unsynced_note() {
  vm_exists "$VM_NAME" && ! vm_running "$VM_NAME" \
    && printf '; the VM is stopped, so recordings still inside it are not copied: start it and run metacomputer recordings --sync first to keep them'
  return 0
}

record_env() { # what status and security show about recordings (lib/recording.py settings_summary)
  local now=""; [ -s "$RUN_DIR/manual-recording" ] && now="$(sed -n 's/^name=//p' "$RUN_DIR/manual-recording")"
  export MCOMP_RECORD_TO="${RECORD_TO:-host}" MCOMP_RECORDING_NOW="$now" MCOMP_TASK_SYNC_INTERVAL="${TASK_SYNC_INTERVAL:-15}"
}

record_sidecar() { # MP4 NAME STARTED ENDED FPS QUALITY MODE [--ended-early]
  "$PY" "$LAB_ROOT/lib/recording.py" sidecar "$1" --name "$2" --started "$3" --ended "$4" --fps "$5" \
    --quality "$6" --mode "$7" ${8:+"$8"} --vm "$VM_NAME" --actions-dir "$LOG_DIR/actions" >/dev/null \
    || warn "could not write the description file for $1"
}

do_record() {
  local sub="${1:-status}"; shift || true
  local state="$RUN_DIR/manual-recording"
  case "$sub" in
    start)
      need_running
      local name="${1:-manual-$(date +%Y%m%d-%H%M%S)}" fps="${2:-${RECORD_FPS:-20}}" quality="${RECORD_QUALITY:-standard}"
      local mode="${RECORD_TO:-host}" audio="${RECORD_AUDIO:-auto}" dir started
      [[ "$name" =~ ^[A-Za-z0-9._-]+$ ]] || die "recording names use letters, digits, . _ - only"
      case "$quality" in standard|high) ;; *) die "RECORD_QUALITY must be standard or high" ;; esac
      case "$audio" in auto|off) ;; *) die "RECORD_AUDIO must be auto or off" ;; esac
      case "$mode" in host|guest) ;; *) die "RECORD_TO must be host or guest" ;; esac
      if [ -s "$state" ] && [ "$(sed -n 's/^mode=//p' "$state")" = host ]; then
        # A streamed recording whose Mac side has ended (the VM crashed or was stopped without record stop) is
        # saved now rather than blocking this one.
        local opid; opid="$(sed -n 's/^pid=//p' "$state")"
        if [ -n "$opid" ] && ! kill -0 "$opid" 2>/dev/null; then
          say "saving the earlier recording '$(sed -n 's/^name=//p' "$state")' first (its stream had ended)"
          ( do_record stop ) || warn "could not save it (its .mkv, if any, stays in $(sed -n 's/^dir=//p' "$state" 2>/dev/null))"
          rm -f "$state"
        fi
      fi
      [ -s "$state" ] && die "already recording ($(sed -n 's/^name=//p' "$state")); metacomputer record stop first"
      dir="$(record_dir)" || exit 1
      [ -e "$dir/$name.mp4" ] || [ -e "$dir/$name.mkv" ] && die "$dir/$name.mp4 already exists; pick another name"
      started="$("$PY" -c 'import time; print(f"{time.time():.2f}")')"
      if [ "$mode" = host ]; then
        # The VM encodes and streams; this Mac saves it as it arrives (detached, so it
        # outlives this command). stop ends ffmpeg in the VM, which ends the stream.
        daemonize "$dir/$name.stream.log" "$SELF" _record-pipe "$name" "$fps" "$quality" "$dir/$name.mkv" "$audio"
        local pid=$! i=0
        while [ $i -lt 20 ]; do
          vm_answer 4096 15 /opt/metacomputer/bin/desktop-record status 2>/dev/null | grep -q "^recording stream:$name\$" && break
          kill -0 "$pid" 2>/dev/null || break
          sleep 0.5; i=$((i + 1))
        done
        if ! vm_answer 4096 15 /opt/metacomputer/bin/desktop-record status 2>/dev/null | grep -q "^recording stream:$name\$"; then
          kill "$pid" 2>/dev/null; sleep 1
          "$PY" "$LAB_ROOT/lib/termsafe.py" < "$dir/$name.stream.log" >&2 2>/dev/null; rm -f "$dir/$name.mkv"
          die "could not start streaming the recording"
        fi
        printf 'name=%s\nmode=host\ndir=%s\npid=%s\nstarted=%s\nfps=%s\nquality=%s\n' \
          "$name" "$dir" "$pid" "$started" "$fps" "$quality" > "$state"
        ok "recording the guest desktop as '$name' (${fps} fps, $quality), streaming to $dir/ — run your task, then: metacomputer record stop"
      else
        # Kept for whoever wants it, but until stop copies it the video is a file in the VM's home, which
        # anything running there can delete (a script that wiped ~ mid-recording took one with it).
        warn "RECORD_TO=guest: this video stays in the VM until 'metacomputer record stop' copies it, so anything running there can delete it first (wiping ~ does). For a task you don't trust, use RECORD_TO=host, the default: it streams to this Mac as it records."
        # The recorder's words go out escaped as they come (term_safe caps them on a terminal), never held in a
        # variable: a recorder that writes without end can't grow this shell. Its own exit status decides, within
        # MCOMP_RECORD_WAIT seconds (60): a VM that never answers is cut off (run_until).
        local wait_s="${MCOMP_RECORD_WAIT:-60}" src
        run_until $((SECONDS + wait_s)) gssh ops "/opt/metacomputer/bin/desktop-record start '$name' $fps $quality $audio" | term_safe
        src="${PIPESTATUS[0]}"
        [ "$src" != 124 ] || die "could not start recording: the VM's recorder didn't answer within $wait_s s (if it started anyway, metacomputer record stop copies what it made)"
        [ "$src" = 0 ] || die "could not start recording"
        printf 'name=%s\nmode=guest\ndir=%s\nstarted=%s\nfps=%s\nquality=%s\n' \
          "$name" "$dir" "$started" "$fps" "$quality" > "$state"
        ok "recording the guest desktop as '$name' (${fps} fps, $quality) — run your task, then: metacomputer record stop"
      fi ;;
    stop)
      local name mode dir pid started fps quality ended path i=0 out early=""
      rec_fail() { # WHY MESSAGE [REASON]: tell the event stream (a fixed sentence and a fixed category: nothing the
                   # VM said or chose, which could spell a value it was given), then stop with the message
        local reason="${3:-other}"
        case "$reason" in no_stream|no_room|not_converted|recorder_answer|copy_failed) ;; *) reason=other ;; esac
        emit_event task recording_failed error "Recording '$name' failed: $1" "metacomputer record status" \
          "name=$name" "mode=$mode" "reason=$reason"
        rm -f "$state"; die "$2"
      }
      if [ ! -s "$state" ]; then
        # A recording started some other way (or before this version): stop it and copy it.
        path="$(vm_answer 4096 60 /opt/metacomputer/bin/desktop-record stop)" || die "stop failed"
        case "$path" in "not recording") ok "not recording"; return 0 ;; stream:*) die "a streamed recording was running without this Mac's record of it; it stopped (see RECORD_DIR for a .mkv)" ;; esac
        # The path comes from the VM: the recorder's own folder and a plain name only, never written through a link.
        case "$path" in "$GUEST_RUN_DIR/manual/"*.mp4) ;; *) die "the VM's recorder named an unexpected file; it stays in the VM" ;; esac
        name="$(basename "$path" .mp4)"; dir="$(record_dir)" || exit 1
        [[ "$name" =~ ^[A-Za-z0-9_][A-Za-z0-9._-]*$ ]] || die "the VM's recorder named an unexpected file; it stays in the VM"
        [ -e "$dir/$name.mp4" ] || [ -L "$dir/$name.mp4" ] && die "$dir/$name.mp4 already exists; the video stays in the VM"
        vm_copy_video "$GUEST_RUN_DIR/manual/$name.mp4" "$dir/$name.mp4" \
          || { [ -s "$dir/$name.mp4" ] || rm -f "$dir/$name.mp4"; die "copy failed (whatever arrived is kept; the video stays in the VM)"; }
        ok "saved $dir/$name.mp4 ($(du -h "$dir/$name.mp4" | cut -f1))"; return 0
      fi
      name="$(sed -n 's/^name=//p' "$state")"; mode="$(sed -n 's/^mode=//p' "$state")"; dir="$(sed -n 's/^dir=//p' "$state")"
      pid="$(sed -n 's/^pid=//p' "$state")"; started="$(sed -n 's/^started=//p' "$state")"
      fps="$(sed -n 's/^fps=//p' "$state")"; quality="$(sed -n 's/^quality=//p' "$state")"
      # A stream whose Mac side ended before this stop: the VM stopped sending (its recorder ended or was
      # stopped, the VM went away) or this Mac's disk reached its reserve. What arrived is saved all the same.
      if [ "$mode" = host ] && [ -n "$pid" ] && ! kill -0 "$pid" 2>/dev/null; then early=--ended-early; fi
      path="$(vm_answer 4096 60 /opt/metacomputer/bin/desktop-record stop 2>/dev/null)" || path="(VM unreachable)"
      ended="$("$PY" -c 'import time; print(f"{time.time():.2f}")')"
      out="$dir/$name.mp4"
      if [ "$mode" = host ]; then
        # The stream ends when the VM's recorder finishes. A VM that can't be reached to stop it (on a VM built
        # before root-owned key lists, wiping the home folder removes the SSH key too) gets no 30 s: the stream
        # is cut here and now.
        local waits=60; [ "$path" = "(VM unreachable)" ] && waits=2
        while [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null && [ $i -lt $waits ]; do sleep 0.5; i=$((i + 1)); done
        [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null && kill "$pid" 2>/dev/null
        [ -s "$dir/$name.mkv" ] || rec_fail "the stream saved nothing" "the stream saved nothing (see $dir/$name.stream.log)" no_stream
        # Same video, in an MP4 that players and editors open at once (no re-encoding), made only if the copy
        # leaves this Mac its reserve, and held to a size limit (lib/recording.py finalize). Otherwise the .mkv,
        # which plays as it is, stays.
        local frc=0
        "$PY" "$LAB_ROOT/lib/recording.py" finalize "$dir/$name.mkv" "$out" --min-free-gb "${IMPORT_MIN_FREE_GB:-10}" || frc=$?
        case "$frc" in
          0) rm -f "$dir/$name.mkv"; [ -s "$dir/$name.stream.log" ] || rm -f "$dir/$name.stream.log" ;;
          3) rec_fail "there wasn't room to convert it to MP4 (the .mkv is kept)" "not converted to MP4: there isn't room above IMPORT_MIN_FREE_GB; $dir/$name.mkv is kept and plays as it is" no_room ;;
          *) rec_fail "it couldn't be converted to MP4 (the .mkv is kept)" "could not convert $dir/$name.mkv to MP4; the .mkv is kept and plays as it is" not_converted ;;
        esac
      else
        [ "$path" = "$GUEST_RUN_DIR/manual/$name.mp4" ] \
          || rec_fail "the VM's recorder didn't hand over a video" "the VM's recorder said: $(esc_text "$path")" recorder_answer
        vm_copy_video "$GUEST_RUN_DIR/manual/$name.mp4" "$out" || { [ -s "$out" ] || rm -f "$out"
          rec_fail "copying it from the VM failed (it stays in the VM)" "copy failed (whatever arrived is kept; the file stays in the VM: $(esc_text "$path"))" copy_failed; }
      fi
      rm -f "$state"
      record_sidecar "$out" "$name" "$started" "$ended" "$fps" "$quality" "$mode" "$early"
      ( export_options; "$PY" "$LAB_ROOT/lib/events.py" _recording "$out" ) >/dev/null 2>&1 || true
      ok "saved $out ($(du -h "$out" | cut -f1)); its description: ${out%.mp4}.json"
      [ "$mode" != host ] || [ "$path" != "(VM unreachable)" ] || [ -n "$early" ] \
        || warn "the VM couldn't be reached to stop its recorder (metacomputer status says why; on a VM built before root-owned key lists, wiping its home folder takes the SSH key with it until metacomputer reset), so the stream was cut on this Mac. What arrived is saved."
      [ -z "$early" ] || warn "the stream had ended before this stop: the VM stopped sending (its recorder ended or was stopped, or the VM went away), or this Mac's free space reached IMPORT_MIN_FREE_GB. The video covers what arrived until then$([ -s "$dir/$name.stream.log" ] && echo "; see $dir/$name.stream.log")." ;;
    status)
      if [ -s "$state" ]; then
        echo "recording $(sed -n 's/^name=//p' "$state") ($(sed -n 's/^mode=//p' "$state"), to $(sed -n 's/^dir=//p' "$state"))"
      else
        # Streamed escaped as it comes, within MCOMP_RECORD_WAIT seconds (60): a VM that never answers is cut off.
        run_until $((SECONDS + ${MCOMP_RECORD_WAIT:-60})) gssh ops /opt/metacomputer/bin/desktop-record status | term_safe
        [ "${PIPESTATUS[0]}" != 124 ] || die "the VM's recorder didn't answer within ${MCOMP_RECORD_WAIT:-60} s"
      fi ;;
    moments)
      local f="${1:-}"; [ -n "$f" ] || die "usage: metacomputer record moments RECORDING.mp4|.json"
      "$PY" "$LAB_ROOT/lib/recording.py" moments "${f%.mp4}.json" ;;
    *) die "usage: metacomputer record start [NAME] [FPS] | stop | status | moments FILE" ;;
  esac
}

do_record_pipe() { # NAME FPS QUALITY OUT.mkv [AUDIO] (internal: the detached half of RECORD_TO=host)
  ssh_base ops
  # lib/recording.py save writes the stream to OUT as it arrives (a new file, never through a link) and ends it
  # before this Mac's free space falls below IMPORT_MIN_FREE_GB, since the VM decides how much it sends. It runs
  # ssh itself and ends it when it's stopped. The VM's stderr goes to the stream log escaped and capped (1 MB).
  # Space other operations have claimed (a recording being converted to MP4, an S3 sync) counts against the reserve.
  exec "$PY" "$LAB_ROOT/lib/recording.py" save "$4" --min-free-gb "${IMPORT_MIN_FREE_GB:-10}" -- \
    ssh -T "${SSH_ARGS[@]}" "/opt/metacomputer/bin/desktop-record stream '$1' $2 $3 ${5:-off}" \
    2> >("$PY" "$LAB_ROOT/lib/termsafe.py" --max 1048576 >&2)
}

do_recordings() {
  local sync=0 n=20
  for a in "$@"; do case "$a" in --sync) sync=1 ;; [0-9]*) n="$a" ;; esac; done
  if [ $sync = 1 ]; then
    # Returns 0 only when the copy is whole (a folder that's missing or empty is whole: a wiped home has nothing
    # to copy), non-zero otherwise without exiting: reset, restore and baseline decide (sync_or_stop).
    vm_running "$VM_NAME" || { warn "VM is not running; nothing to sync"; return 1; }
    local dest="$LAB_ROOT/recordings/guest-runs"; mkdir -p "$dest"
    # Plain files and folders only: links and special files from the VM are left out (lib/guest_import.py).
    # No ~/metacomputer-runs (a wiped home) is nothing to copy, not a failure: an empty archive and a note.
    vm_tar_copy "$dest" 'if cd ~/metacomputer-runs 2>/dev/null; then tar -cf - . 2>/dev/null; else echo "no ~/metacomputer-runs in the VM: nothing to copy" >&2; tar -cf - -T /dev/null; fi' \
      || { warn "could not sync ~/metacomputer-runs from the guest"; return 1; }
    ok "guest ~/metacomputer-runs synced to recordings/guest-runs/"
  fi
  "$PY" - "$LAB_ROOT/recordings" "$n" "${RECORD_DIR:-}" <<'EOF'
import json, os, subprocess, sys, time
root, n, extra = sys.argv[1], int(sys.argv[2]), sys.argv[3]
sys.path.insert(0, os.path.join(os.path.dirname(root), "lib"))
from termsafe import escape_for_terminal as esc
vids, roots = [], [root]
if extra and os.path.isdir(extra) and not os.path.realpath(extra).startswith(os.path.realpath(root) + os.sep):
    roots.append(extra)   # RECORD_DIR outside this checkout
for d, _, fs in (w for r in roots for w in os.walk(r)):
    for f in fs:
        p = os.path.join(d, f)
        if f.endswith(".mp4") and not os.path.islink(p) and os.path.isfile(p):
            vids.append((os.path.getmtime(p), p))
vids.sort(reverse=True)
if not vids:
    print("no recordings yet"); sys.exit(0)
for mt, p in vids[:n]:
    side = p[:-4] + ".json"; task = ""
    if os.path.isfile(side) and not os.path.islink(side):
        try:
            j = json.load(open(side)); task = str(j.get("task") or j.get("test") or j.get("kind") or "")
            if j.get("result"): task += f" [{j['result']}]"
        except Exception: pass
    dur = subprocess.run(["ffprobe", "-v", "error", "-show_entries", "format=duration", "-of", "csv=p=0", p],
                         capture_output=True, text=True).stdout.strip()
    try: dur = f"{float(dur):6.1f}s"
    except ValueError: dur = "   ?  "
    print(f"{time.strftime('%Y-%m-%d %H:%M', time.localtime(mt))}  {dur}  {os.path.getsize(p)/2**20:6.1f} MB  "
          f"{esc(os.path.relpath(p, os.path.dirname(root)) if p.startswith(root + os.sep) else p)}  {esc(task)}")
EOF
}

do_inspect() { # [system|windows|processes|ports|files ...] [--minutes N] [--top N] [--json]
  local args=() json=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) json=1 ;;
      --minutes|--top) [[ "${2:-}" =~ ^[0-9]{1,5}$ ]] || die "$1 needs a number"; args+=("$1" "$2"); shift ;;
      system|windows|processes|ports|files|browser|all) args+=("$1") ;;
      *) die "usage: metacomputer inspect [system|windows|processes|ports|files|browser ...] [--minutes N] [--top N] [--json]" ;;
    esac
    shift
  done
  need_running
  local out
  out="$(gssh ops "python3 -I - ${args[*]+${args[*]}}" < "$LAB_ROOT/lib/guest_inspect.py")" \
    || die "inspect failed (is the guest up? metacomputer status)"
  # Either way the VM's words reach this terminal written by the Mac: ASCII-only JSON, or the escaped summary.
  if [ "$json" = 1 ]; then printf '%s' "$out" | "$PY" "$LAB_ROOT/lib/guest_inspect.py" --json-out
  else printf '%s' "$out" | "$PY" "$LAB_ROOT/lib/guest_inspect.py" --render; fi
}

browser_get() { # KEY DEFAULT: the value after config/defaults.env + config/local.env
  local v; eval "v=\"\${$1:-}\""; printf '%s' "${v:-$2}"
}
browser_set() { # KEY VALUE: written to this machine's config (config/local.env)
  local tmp; tmp="$(mktemp)"
  { if [ -f "$LOCAL_CONFIG" ]; then grep -v "^$1=" "$LOCAL_CONFIG"; else echo "# This Mac's settings for metacomputer (see config/local.env.example)"; fi
    echo "$1=$2"; } > "$tmp"
  mv "$tmp" "$LOCAL_CONFIG"
}
do_browser() { # [default firefox|chrome | mode human|page|hybrid | profiles [--delete NAME [--yes]] | --json]
  case "${1:-}" in
    ""|--json)
      local b m; b="$(browser_get BROWSER firefox)"; m="$(browser_get MODE human)"
      if [ "${1:-}" = --json ]; then printf '{"browser":"%s","mode":"%s"}\n' "$b" "$m"
      else
        echo "default browser: $b   (firefox | chrome)"
        echo "default mode:    $m   (human | page | hybrid; page and hybrid need chrome)"
        echo "Words in a request override these. Change with: metacomputer browser default chrome | metacomputer browser mode page"
      fi ;;
    default) case "${2:-}" in firefox|chrome) browser_set BROWSER "$2"; echo "default browser: $2" ;;
                              *) die "usage: metacomputer browser default firefox|chrome" ;; esac ;;
    mode)    case "${2:-}" in human|page|hybrid) browser_set MODE "$2"; echo "default mode: $2" ;;
                              *) die "usage: metacomputer browser mode human|page|hybrid" ;; esac ;;
    profiles)
      need_running
      if [ "${2:-}" = --delete ]; then
        local name="${3:-}"; shift 3 2>/dev/null || true
        [[ "$name" =~ ^[A-Za-z0-9._-]{1,64}$ ]] || die "usage: metacomputer browser profiles --delete NAME [--yes]"
        parse_flags "$@"
        local dir="/home/$GUEST_USER/.local/state/cua-driver/browser-profiles/$name"
        gssh ops "test -d '$dir'" >/dev/null || die "no driver profile named $name (metacomputer browser profiles)"
        # [-] keeps pgrep from matching this very ssh command line
        gssh ops "pgrep -u \"\$(id -u)\" -f -- '[-]-user-data-dir=$dir' >/dev/null" >/dev/null && die "profile $name is in use by a running Chrome; close it first"
        confirm "Delete the Chrome profile '$name' in the VM (its cookies and sign-ins go with it)?"
        gssh ops "rm -rf -- '$dir'" >/dev/null && echo "deleted profile $name"
      else
        gssh ops "python3 -I - browser" < "$LAB_ROOT/lib/guest_inspect.py" | "$PY" "$LAB_ROOT/lib/guest_inspect.py" --render-profiles
      fi ;;
    *) die "usage: metacomputer browser [default firefox|chrome | mode human|page|hybrid | profiles [--delete NAME]]" ;;
  esac
}

do_rename() { # GUEST_PATH NEW_NAME: rename a file in the VM (e.g. a download saved under its id)
  [ $# -eq 2 ] || die "usage: metacomputer rename GUEST_PATH NEW_NAME"
  need_running
  local src new; src="$(guest_path "$1")" || exit 1; new="$2"
  [[ "$new" =~ ^[A-Za-z0-9][A-Za-z0-9._()+\ -]{0,127}$ ]] || die "new name: letters, digits, spaces and ._()+- only, no folders"
  local dst; dst="$(dirname "$src")/$new"
  gssh ops "test -e $(printf %q "$src") && ! test -e $(printf %q "$dst") && mv -- $(printf %q "$src") $(printf %q "$dst")" \
    >/dev/null || die "could not rename (missing source, or $new already exists)"
  echo "$dst"
}

do_input_reset() { # [--check]: remove the driver's leftover virtual input devices (Chrome's keyboard)
  need_running
  [ "${1:-}" = --check ] || handoff_hold   # removing them acts on the desktop: not while the user has it
  local n; n="$(gssh ops "/opt/metacomputer/bin/input-reset ${1:-}")" || die "input reset failed (xinput missing? rebuild the VM)"
  printf '%s\n' "$n" | term_safe
}

do_desktop_restart() { # [--override]: log the desktop session out and back in (closes every app)
  parse_flags "$@"; owners_check; need_running
  handoff_hold_unless_override
  say "restarting the desktop session (every open app closes)"
  gssh admin 'sudo /usr/local/sbin/metacomputer-admin restart-desktop' >/dev/null 2>&1 || true
  sleep 5
  wait_session 120 || die "the desktop session did not come back (metacomputer status)"
  ok "desktop session ready"
}

do_sh() { # bash in the VM as the desktop user, over the ops connection (lib/vm_shell.py, docs/shell.md)
  export_options
  local state=off; vm_running "$VM_NAME" && state=running
  ssh_base ops
  MCOMP_VM_STATE="$state" exec "$PY" "$LAB_ROOT/lib/vm_shell.py" --transport $(( ${#SSH_ARGS[@]} + 2 )) ssh -T "${SSH_ARGS[@]}" "$@"
}

# Claude Code inside the VM (lib/vm_claude.py): each step goes through the shell channel's guarded runner;
# the token comes from `metacomputer secrets token` (this file, run again as MCOMP_SELF) through a pipe.
do_claude() {
  export_options
  local state=off; vm_running "$VM_NAME" && state=running
  ssh_base ops
  MCOMP_VM_STATE="$state" MCOMP_SELF="$SELF" exec "$PY" "$LAB_ROOT/lib/vm_claude.py" \
    --transport $(( ${#SSH_ARGS[@]} + 2 )) ssh -T "${SSH_ARGS[@]}" "$@"
}

do_who() {
  local st; st="$(vm_exists "$VM_NAME" && vm_status "$VM_NAME" || echo missing)"
  if [ "${1:-}" = "--json" ]; then exec "$PY" "$LAB_ROOT/lib/owners.py" who --json; fi
  echo "virtual computer: $st"
  if [ "$st" = running ]; then
    gssh ops 'pgrep -u "$(id -u)" -x ffmpeg >/dev/null && echo "recording: yes (a screen recording is running)" || echo "recording: no"' 2>/dev/null | term_safe
  fi
  "$PY" "$LAB_ROOT/lib/owners.py" who
}

do_put() { # HOST_PATH... [--to GUEST_DIR] [--overwrite]   (lib/guest_put.py: SHA-256 checked, never overwrites unless asked)
  [ $# -gt 0 ] || die "usage: metacomputer put HOST_PATH... [--to GUEST_DIR] [--overwrite]"
  need_running
  ssh_base ops
  MCOMP_GUEST_USER="$GUEST_USER" exec "$PY" "$LAB_ROOT/lib/guest_put.py" --transport $(( ${#SSH_ARGS[@]} + 2 )) ssh -T "${SSH_ARGS[@]}" "$@"
}

do_get() { # GUEST_PATH [HOST_DIR] [--task NAME]
  local src="" dest="" task=""
  while [ $# -gt 0 ]; do
    case "$1" in --task) task="${2:-}"; shift 2 ;; *) if [ -z "$src" ]; then src="$1"; else dest="$1"; fi; shift ;; esac
  done
  [ -n "$src" ] || die "usage: metacomputer get GUEST_PATH [HOST_DIR] [--task NAME]"
  need_running
  src="$(guest_path "$src")" || exit 1
  if [ -z "$dest" ]; then
    if [ -n "$task" ]; then dest="$LAB_ROOT/results/$task/files"; else dest="$LAB_ROOT/results/files/$(date +%Y%m%d-%H%M%S)"; fi
  fi
  dest="$(abs_host_path "$dest")"; mkdir -p "$dest"
  # Plain files and folders only: links and special files from the VM are left out, and
  # nothing is written through a link (lib/guest_import.py).
  gssh ops "tar -C $(printf %q "$(dirname "$src")") -cf - $(printf %q "$(basename "$src")")" \
    | guest_import "$dest" || die "could not copy $src from the guest"
  echo "$dest/$(basename "$src")"
}

do_shot() { # [HOST_PATH] [--task NAME]
  local out="" task="" dir
  while [ $# -gt 0 ]; do
    case "$1" in --task) task="${2:-}"; shift 2 ;; *) out="$1"; shift ;; esac
  done
  need_running
  if [ -z "$out" ]; then
    dir="$LAB_ROOT/screenshots/manual"; [ -n "$task" ] && dir="$LAB_ROOT/results/$task/screenshots"
    out="$dir/shot-$(date +%Y%m%d-%H%M%S).png"
  fi
  out="$(abs_host_path "$out")"; mkdir -p "$(dirname "$out")"
  gssh ops '/opt/metacomputer/bin/session-run import -window root png:-' > "$out" 2>/dev/null
  [ -s "$out" ] || { rm -f "$out"; die "screenshot failed (is the desktop session up? metacomputer status)"; }
  echo "$out"
}

do_contact_sheet() { # MP4 [OUT.png]
  local in="${1:-}" out="${2:-}" dur rate tmp
  [ -f "$in" ] || die "usage: metacomputer contact-sheet MP4 [OUT.png]"
  [ -n "$out" ] || out="${in%.mp4}-contact.png"
  # The video may have come from the VM: never write through a link or onto anything but a
  # regular file. ffmpeg writes a new file beside it, which then replaces OUT by rename(2).
  [ -L "$out" ] && die "$out is a symbolic link; not writing through it"
  [ -e "$out" ] && [ ! -f "$out" ] && die "$out exists and isn't a regular file"
  dur="$(ffprobe -v error -show_entries format=duration -of csv=p=0 "$in" 2>/dev/null)"
  rate="$("$PY" -c 'import sys; d=float(sys.argv[1] or 0); print(f"{12/max(d,0.5):.4f}")' "${dur:-0}")" || die "unreadable video: $in"
  tmp="$(mktemp "$(dirname "$out")/.contact-sheet.XXXXXX")" || die "cannot write beside $out"
  if ! ffmpeg -v error -y -i "$in" -vf "fps=$rate,scale=480:-2,tile=4x3:padding=6:margin=6:color=0x202020" \
       -frames:v 1 -update 1 -f image2 -c:v png "$tmp" </dev/null; then
    rm -f "$tmp"; die "ffmpeg could not build the contact sheet"
  fi
  chmod 644 "$tmp" 2>/dev/null
  "$PY" -c 'import os, sys; os.replace(sys.argv[1], sys.argv[2])' "$tmp" "$out" 2>/dev/null \
    || { rm -f "$tmp"; die "could not save the contact sheet as $out"; }
  echo "$(abs_host_path "$out")"
}

# Per-task recordings are Cua Driver's: written in the VM, where anything running there can delete them. While
# a task folder is open, a copier on the Mac fetches each recording turn the driver has finished (every one but
# the newest) every TASK_SYNC_INTERVAL seconds, once each; task finish copies the rest and never replaces a turn
# file copied earlier. The video itself is only whole at stop_recording, so it's copied at finish.
task_sync_pidfile() { printf '%s' "$RUN_DIR/task-sync.$1.pid"; }
task_sync_on() { [[ "${TASK_SYNC_INTERVAL:-15}" =~ ^[0-9]{1,5}$ ]] && [ "${TASK_SYNC_INTERVAL:-15}" -gt 0 ]; }
task_sync_start() { # NAME
  task_sync_on || return 0
  daemonize "$RUN_DIR/task-sync.$1.log" "$SELF" _task-sync "$1"
  echo $! > "$(task_sync_pidfile "$1")"
}
task_sync_stop() { # NAME: ask the task's copier to end (it finishes a copy it's in), then make sure it has
  local pidf pid i=0; pidf="$(task_sync_pidfile "$1")"
  [ -f "$pidf" ] || { rm -f "$RUN_DIR/task-sync.$1.done" "$RUN_DIR/task-sync.$1.want"; return 0; }
  pid="$(cat "$pidf" 2>/dev/null)"; rm -f "$pidf"
  [[ "$pid" =~ ^[0-9]+$ ]] || return 0
  while kill -0 "$pid" 2>/dev/null && [ $i -lt 60 ]; do sleep 0.5; i=$((i + 1)); done
  # Still there after 30 s, and still the copier (not a process that reused its number): its whole group goes.
  if kill -0 "$pid" 2>/dev/null && ps -p "$pid" -o command= 2>/dev/null | grep -q "_task-sync $1\$"; then
    kill -TERM -- "-$pid" 2>/dev/null || kill -TERM "$pid" 2>/dev/null
  fi
  [ -s "$RUN_DIR/task-sync.$1.log" ] || rm -f "$RUN_DIR/task-sync.$1.log"
  rm -f "$RUN_DIR/task-sync.$1.done" "$RUN_DIR/task-sync.$1.want"
  return 0
}
do_task_sync() { # NAME (internal; task start runs it detached, task finish ends it)
  local name="${1:-}"
  [[ "$name" =~ ^mcomp-[0-9]{8}-[0-9]{6}-[a-z0-9-]+$ ]] || die "usage: metacomputer _task-sync NAME"
  task_sync_on || return 0
  local every="${TASK_SYNC_INTERVAL:-15}" pidf donef wantf guest host deadline list sorted seen="" changed last t n
  local copied gone=0 down=0
  pidf="$(task_sync_pidfile "$name")"; donef="$RUN_DIR/task-sync.$name.done"; wantf="$RUN_DIR/task-sync.$name.want"
  guest="$GUEST_RUN_DIR/$name/recording"; host="$LAB_ROOT/results/$name/guest/recording"
  deadline=$(( $(date +%s) + 86400 ))        # a task left open ends its copier after a day...
  changed=$(date +%s)                         # ...or after an hour without a new turn (a task never finished)
  mkdir -p "$host"
  while [ "$(date +%s)" -lt "$deadline" ] && [ $(( $(date +%s) - changed )) -lt "${MCOMP_TASK_SYNC_IDLE:-3600}" ]; do
    n=0; while [ $n -lt "$every" ]; do [ -f "$pidf" ] || return 0; sleep 1; n=$((n + 1)); done
    # What the VM lists is only a list of names, read with a byte limit and a deadline (vm_answer); each name is
    # checked here (turn-<digits>) before it's used.
    list="$(vm_answer 4194304 60 "test -d '$guest' || { echo GONE; exit 0; }; cd '$guest' && ls -1 && echo END" 2>/dev/null)" \
      || list=""
    case "$list" in
      GONE) down=0; gone=$((gone + 1)); [ $gone -ge 4 ] && break; continue ;;   # wiped, or the VM was reset
      END|*$'\n'END) gone=0; down=0 ;;
      *) down=$((down + 1)); [ $down -ge 8 ] && break; continue ;;            # unreachable, too much, too slow
    esac
    sorted="$(printf '%s\n' "$list" | grep -E '^turn-[0-9]{1,9}$' | sort -t- -k2,2n)" || continue
    [ "$sorted" = "$seen" ] || { seen="$sorted"; changed=$(date +%s); }
    last="$(printf '%s\n' "$sorted" | tail -n 1)"
    # Done = copied whole once (the .done list), not merely present: a copy cut short is asked for again.
    copied=$'\n'"$(cat "$donef" 2>/dev/null)"$'\n'
    local want=()
    while IFS= read -r t; do
      [ "$t" != "$last" ] || continue                                  # the newest may still be written
      case "$copied" in *$'\n'"$t"$'\n'*) continue ;; esac
      want+=("$t")
      [ ${#want[@]} -lt 500 ] || break
    done <<< "$sorted"
    [ ${#want[@]} -gt 0 ] && [ -f "$pidf" ] || continue
    # Only the folders asked for are taken from the VM's answer (--only-top), a file the Mac already has is
    # never replaced, by a file or a folder (--keep-existing), and the copy has a deadline.
    printf '%s\n' "${want[@]}" > "$wantf"
    ssh_base ops
    if guest_import "$host" --quiet --keep-existing turn- --only-top "$wantf" --timeout 300 \
         -- ssh -T "${SSH_ARGS[@]}" "cd '$guest' && tar -cf - ${want[*]}" 2>/dev/null; then
      for t in "${want[@]}"; do [ -d "$host/$t" ] && printf '%s\n' "$t" >> "$donef"; done
    fi
  done
  rm -f "$pidf" "$donef" "$wantf"
}

do_task() { # start SLUG [--no-sync] | finish NAME
  local sub="${1:-}"; shift || true
  case "$sub" in
    start)
      need_running
      local slug="" name guest host sync=1 a
      for a in "$@"; do   # --no-sync: nothing will be recorded (web checks without --record), so no copier
        case "$a" in --no-sync) sync=0 ;; *) [ -n "$slug" ] || slug="$a" ;; esac
      done
      slug="$(printf '%s' "${slug:-task}" | tr 'A-Z' 'a-z' | tr -cs 'a-z0-9' '-' | sed 's/^-*//; s/-*$//' | cut -c1-40)"
      name="mcomp-$(date +%Y%m%d-%H%M%S)-${slug:-task}"
      guest="$GUEST_RUN_DIR/$name"; host="$LAB_ROOT/results/$name"
      gssh ops "mkdir -p '$guest/recording' '$guest/files'" >/dev/null || die "cannot create $guest in the guest"
      mkdir -p "$host"
      "$PY" - "$host/task.json" "$name" "$guest" "$host" "$PWD" <<'EOF'
import json, sys, time
p, name, guest, host, cwd = sys.argv[1:]
json.dump({"name": name, "started": time.strftime("%Y-%m-%dT%H:%M:%S%z"), "requested_from": cwd,
           "guest_dir": guest, "host_dir": host}, open(p, "w"), indent=2)
EOF
      [ $sync = 0 ] || task_sync_start "$name"
      echo "NAME=$name"
      echo "GUEST_DIR=$guest"
      echo "RECORDING_DIR=$guest/recording    # start_recording output_dir"
      echo "FILES_DIR=$guest/files            # save outputs here in the VM"
      echo "HOST_DIR=$host" ;;
    finish)
      local name="${1:-}" host guest copied=yes
      [[ "$name" =~ ^mcomp-[0-9]{8}-[0-9]{6}-[a-z0-9-]+$ ]] || die "usage: metacomputer task finish mcomp-YYYYMMDD-HHMMSS-slug"
      host="$LAB_ROOT/results/$name"; guest="$GUEST_RUN_DIR/$name"; mkdir -p "$host/guest"
      task_sync_stop "$name"
      local keeprep="$RUN_DIR/task-keep.$name.json"; rm -f "$keeprep"
      if vm_running "$VM_NAME"; then
        # Plain files and folders only: links and special files from the VM are left out, so the
        # contact sheets below can't be written through a link it planted (lib/guest_import.py).
        # Recording turns copied while the task ran stay as they were copied: the VM can't swap them now,
        # and any it changed since are named (--keep-existing), and counted for the event below.
        export MCOMP_IMPORT_KEEP_REPORT="$keeprep"
        vm_tar_copy "$host/guest" "test -d '$guest' && tar -C '$guest' -cf - ." --quiet --keep-existing recording/turn- \
          || { warn "nothing (or not everything) could be copied from $guest"; copied=no; }
        unset MCOMP_IMPORT_KEEP_REPORT
      else
        warn "the virtual computer is off; listing what is already on the Mac"; copied=off
      fi
      # Action-log files written while the task ran (ACTION_LOG=on).
      if [ -d "$LOG_DIR/actions" ]; then
        local a
        while IFS= read -r a; do
          mkdir -p "$host/actions" && cp "$a" "$host/actions/$(basename "$(dirname "$a")")-$(basename "$a")"
        done < <(find "$LOG_DIR/actions" -name '*.jsonl' -newer "$host/task.json" 2>/dev/null)
      fi
      local v
      while IFS= read -r -d '' v; do
        [ -n "$v" ] && ( do_contact_sheet "$v" ) >/dev/null 2>&1 || true
      done < <(find "$host" -type f -name '*.mp4' -size +0 -print0 2>/dev/null)
      export_options
      "$PY" - "$host" "$LAB_ROOT/lib" "$copied" "$keeprep" <<'EOF'
import json, os, subprocess, sys, time
host, lib, copied, keeprep = sys.argv[1:5]
sys.path.insert(0, lib)
from termsafe import escape_for_terminal as esc
items = {"videos": [], "contact_sheets": [], "screenshots": [], "files": []}
for d, _, fs in os.walk(host):
    for f in sorted(fs):
        p = os.path.join(d, f); rel = os.path.relpath(p, host)
        if os.path.islink(p) or not os.path.isfile(p):
            continue
        if f.endswith(".mp4"):
            dur = subprocess.run(["ffprobe", "-v", "error", "-show_entries", "format=duration", "-of", "csv=p=0", p],
                                 capture_output=True, text=True).stdout.strip()
            items["videos"].append({"path": p, "seconds": round(float(dur), 1) if dur else None})
        elif f.endswith("-contact.png"):
            items["contact_sheets"].append(p)
        elif "/turn-" in "/" + rel or f in ("task.json", "artifacts.json"):
            continue
        elif f.endswith(".png") or f.endswith(".jpg"):
            items["screenshots"].append(p)
        elif rel.startswith("guest/files/") or rel.startswith("files/"):
            items["files"].append(p)
rec = os.path.join(host, "guest", "recording")    # Cua Driver's per-action folders, some copied while it ran
items["recording_turns"] = len([t for t in os.listdir(rec) if t.startswith("turn-")]) if os.path.isdir(rec) else 0
try:   # turn files the VM changed after the copier had them (guest_import --keep-existing): the Mac kept its copies
    kr = json.load(open(keeprep)) if keeprep and os.path.isfile(keeprep) else {}
    os.unlink(keeprep)
except (OSError, ValueError):
    kr = {}
changed = kr.get("changed") if isinstance(kr.get("changed"), int) else 0
if changed:
    items["recording_changed_in_vm"] = {"files": changed, "turns": [t for t in kr.get("changed_in") or []
                                                                   if isinstance(t, str) and t[5:].isdigit()][:20]}
items["host_dir"] = host
items["finished"] = time.strftime("%Y-%m-%dT%H:%M:%S%z")
json.dump(items, open(os.path.join(host, "artifacts.json"), "w"), indent=2)
print(f"HOST_DIR={host}")
for v in items["videos"]:
    print(f"video        {esc(v['path'])}  ({v['seconds']} s)")
for k, label in (("contact_sheets", "contact sheet"), ("screenshots", "screenshot"), ("files", "file")):
    for p in items[k]:
        print(f"{label:<12} {esc(p)}")
if items["recording_turns"]:
    print(f"turns        {items['recording_turns']} recording turn folder(s) in {esc(rec)}")
print(f"index        {os.path.join(host, 'artifacts.json')}")
try:   # the optional event stream (docs/events.md); never fails the command
    from datetime import datetime
    sys.path.insert(0, lib)
    import events
    task = json.load(open(os.path.join(host, "task.json")))
    secs = round(time.time() - datetime.strptime(task["started"], "%Y-%m-%dT%H:%M:%S%z").timestamp())
    name = os.path.basename(host)
    empty = not (items["videos"] or items["files"] or items["screenshots"] or items["recording_turns"])
    failed = empty and copied != "yes"
    # What the VM made (file names, how many, a video's own length) is its choice and could spell a value it was
    # given: the event carries counts as classes and no names or lengths from the VM (artifacts.json has them all).
    cc = events.count_class
    counts = {"videos": len(items["videos"]), "files": len(items["files"]), "screenshots": len(items["screenshots"]),
              "recording turns": items["recording_turns"]}
    what = (", ".join(f"{k}: {cc(v)}" for k, v in counts.items() if v) if not empty else "no artifacts")
    partial = copied == "no" and not empty     # the VM's folder was gone at finish; the copier's copies remain
    events.emit("task", "finished",
                f"Task {name} finished after {secs // 60} min {secs % 60} s: {what}"
                + (" (nothing could be copied from the VM)" if failed else
                   " (the copy from the VM failed at finish; this includes what was copied while the task ran)" if partial else "")
                + (f"; the VM changed recording files after they were copied ({cc(changed)}; the Mac kept its copies)"
                   if changed else ""),
                "error" if failed else "warn" if partial or changed else "info",
                f"See {host}" if not failed else "metacomputer status",
                {"task": name, "duration_s": secs, "host_dir": host, "copied_from_vm": copied,
                 "videos": cc(len(items["videos"])), "contact_sheets": cc(len(items["contact_sheets"])),
                 "files": cc(len(items["files"])), "screenshots": cc(len(items["screenshots"])),
                 "recording_turns": cc(items["recording_turns"]), "recording_changed_in_vm": cc(changed)},
                project=task.get("requested_from"))
except Exception:
    pass
EOF
      ;;
    *) die "usage: metacomputer task start SLUG [--no-sync] | finish NAME" ;;
  esac
}

# The live-view (VNC) password. It never goes into an environment or onto a command line: it reaches the
# VM on ssh's stdin, the Keychain through a `security -i` command fed on stdin, and its file through Python's
# stdin. VNC_PASSWORD_STORE=keychain: the login Keychain, service metacomputer-vnc, account VM_NAME, a new
# password each build, written and then checked by a one-time tag in its comment; the user reads it in
# their own terminal. A usable password an earlier setup kept in $SSH_DIR/vnc-pass stays in use.
VNC_KEYCHAIN_SERVICE=metacomputer-vnc
vnc_file() { printf '%s' "$SSH_DIR/vnc-pass"; }
# read: print the file's password if it's usable (status 1 if not); write: the password on stdin goes in.
# The folder must be a real folder of yours (made 0700) under folders that are root's or yours and that only
# their owner can write to, unless they're sticky (/tmp); the file is read and created with no-follow
# opens through a descriptor of that folder: written to a new 0600 file (exclusive), then renamed into place.
vnc_file_io() {
  "$PY" -c '
import os, secrets, stat, sys
mode, d = sys.argv[1], sys.argv[2]
uid, name = os.getuid(), "vnc-pass"
def stop(msg, code=2):
    print(msg, file=sys.stderr); sys.exit(code)
if mode == "write":
    try:
        os.makedirs(d, mode=0o700, exist_ok=True)
    except OSError as e:
        stop(f"could not create {d}: {e.strerror}")
try:
    st = os.lstat(d)
except FileNotFoundError:
    sys.exit(1)
if stat.S_ISLNK(st.st_mode) or not stat.S_ISDIR(st.st_mode):
    stop(f"{d} is a link or not a folder; refusing to keep the live-view password there")
if st.st_uid != uid:
    stop(f"{d} belongs to someone else; refusing to keep the live-view password there")
a = os.path.dirname(os.path.realpath(d))
while True:
    s = os.stat(a)
    if s.st_uid not in (0, uid) or ((s.st_mode & 0o022) and not s.st_mode & stat.S_ISVTX):
        stop(f"{a} (above {d}) can be changed by someone else; refusing to keep the live-view password there")
    if a == "/":
        break
    a = os.path.dirname(a)
dfd = os.open(d, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
s = os.fstat(dfd)
if s.st_uid != uid:
    stop(f"{d} changed while it was checked")
if s.st_mode & 0o077:
    os.fchmod(dfd, 0o700)
if mode == "read":
    try:
        fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW, dir_fd=dfd)
    except OSError:
        sys.exit(1)
    s = os.fstat(fd)
    data = os.read(fd, 257) if stat.S_ISREG(s.st_mode) and s.st_uid == uid and s.st_size <= 256 else b""
    pw = data.decode("utf-8", "replace").rstrip("\n")
    if not pw or "\n" in pw or len(pw) > 64 or not all(33 <= ord(c) < 127 for c in pw):
        sys.exit(1)
    print(pw); sys.exit(0)
pw = sys.stdin.readline().rstrip("\n")
if not pw:
    stop("no password to write")
try:
    if not stat.S_ISREG(os.stat(name, dir_fd=dfd, follow_symlinks=False).st_mode):
        stop(f"{d}/{name} is a link or not a plain file; refusing to write the live-view password through it (remove it, then run this again)")
except FileNotFoundError:
    pass
tmp = ".vnc-pass." + secrets.token_hex(8)
fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600, dir_fd=dfd)
try:
    os.fchmod(fd, 0o600)
    if os.write(fd, pw.encode()) != len(pw.encode()):
        raise OSError("short write")
    os.fsync(fd)
except OSError as e:
    os.close(fd); os.unlink(tmp, dir_fd=dfd); stop(f"could not write the live-view password: {e}")
os.close(fd)
os.rename(tmp, name, src_dir_fd=dfd, dst_dir_fd=dfd)
' "$1" "$SSH_DIR"
}
vnc_file_ok() { vnc_file_io read >/dev/null 2>&1; }
vnc_file_write() { # PASSWORD
  printf '%s\n' "$1" | vnc_file_io write || die "couldn't keep the live-view password in $(vnc_file) (above)"
}
vnc_password_hint() {
  case "$VNC_PASSWORD_STORE" in
    command) echo "$VNC_PASSWORD_GET   (in your own terminal)" ;;
    keychain) if vnc_file_ok; then echo "cat $(vnc_file)   (in your own terminal)"
              else echo "security find-generic-password -s $VNC_KEYCHAIN_SERVICE -a $VM_NAME -w   (in your own terminal)"; fi ;;
    *)       echo "cat $(vnc_file)   (in your own terminal)" ;;
  esac
}

# The live-view password on stdout, for a pipe into lib/liveview.py only (never into a variable that's printed,
# an argument, a file or a log). The same stores as above: your command, an earlier setup's file, the Keychain.
vnc_password_get() {
  case "$VNC_PASSWORD_STORE" in
    command) [ -n "$VNC_PASSWORD_GET" ] || return 1
             sh -c "$VNC_PASSWORD_GET" </dev/null 2>/dev/null ;;
    keychain) vnc_file_io read 2>/dev/null && return 0
              [[ "$VM_NAME" =~ ^[A-Za-z0-9._-]+$ ]] || return 1
              run_until $(( SECONDS + ${MCOMP_KEYCHAIN_WAIT:-20} )) \
                security find-generic-password -s "$VNC_KEYCHAIN_SERVICE" -a "$VM_NAME" -w </dev/null 2>/dev/null ;;
    *) vnc_file_io read 2>/dev/null ;;
  esac
}

view_host() { scutil --get LocalHostName 2>/dev/null || hostname -s; }

do_view() { # [--open | --tailnet]
  case "${1:-}" in
    --open) view_open; return $? ;;
    --tailnet) view_tailnet; return 0 ;;
    "") ;;
    *) die "usage: metacomputer view [--open | --tailnet]" ;;
  esac
  cat <<EOF
Live view of the guest desktop (VNC, view + take over):
  on this Mac:          metacomputer view --open
                        (opens Screen Sharing and puts the live-view password on your clipboard)
  from another device:  ssh -N -L $VNC_PORT:127.0.0.1:$VNC_PORT $(view_host)
                        then connect a VNC client to localhost:$VNC_PORT
  password:             $(vnc_password_hint)
  over your tailnet:    metacomputer view --tailnet   (prints the command; publishing it is your choice)
The port listens on 127.0.0.1 only (cua-netgw forward) and the guest firewall
admits it only from the gateway.
EOF
}

# --open: Screen Sharing on this Mac, with the password on the clipboard for a short while. Never in the URL.
view_open() {
  local why secs="${MCOMP_VIEW_CLIPBOARD_S:-${VIEW_CLIPBOARD_S:-45}}"
  [[ "$secs" =~ ^[0-9]{1,4}$ ]] || secs=45
  vm_running "$VM_NAME" || die "the virtual computer is off: metacomputer start, then metacomputer view --open"
  if ! why="$("$PY" "$LAB_ROOT/lib/liveview.py" gui)"; then
    cat <<EOF
metacomputer view --open needs the Mac's own screen, and $why.
  On the Mac's screen (in person, or through a remote-desktop app such as Screen Sharing
  or Jump Desktop): open Terminal there and run  metacomputer view --open
  From the device you're on:
    ssh -N -L $VNC_PORT:127.0.0.1:$VNC_PORT $(view_host)
    then connect a VNC client to localhost:$VNC_PORT
    password: $(vnc_password_hint)
  Over your own tailnet (your choice; you run it): metacomputer view --tailnet
EOF
    return 1
  fi
  if vnc_password_get | "$PY" "$LAB_ROOT/lib/liveview.py" clip --clear-after "$secs"; then
    echo "The live-view password is on your clipboard: paste it with Cmd+V when Screen Sharing asks (it isn't"
    if [ "$secs" -gt 0 ]; then
      echo "your Mac's password). It's cleared from the clipboard in $secs s, if it's still there then."
    else
      echo "your Mac's password)."
    fi
  else
    warn "the password isn't on the clipboard; when Screen Sharing asks, read it with: $(vnc_password_hint)"
  fi
  open "vnc://127.0.0.1:$VNC_PORT" || die "couldn't open Screen Sharing (vnc://127.0.0.1:$VNC_PORT)"
  echo "Opening the live view in Screen Sharing (vnc://127.0.0.1:$VNC_PORT)."
}

# --tailnet: the commands that would publish the port to your own tailnet. Printed, never run: it changes this
# Mac's networking, so it's yours to run (and to undo).
view_tailnet() {
  local ts="" name=""
  if command -v tailscale >/dev/null 2>&1; then ts=tailscale
  elif [ -x /Applications/Tailscale.app/Contents/MacOS/Tailscale ]; then ts=/Applications/Tailscale.app/Contents/MacOS/Tailscale; fi
  if [ -n "$ts" ]; then
    name="$(run_until $(( SECONDS + 5 )) "$ts" status --json </dev/null 2>/dev/null | "$PY" -c 'import json, re, sys
try:
    n = str((json.load(sys.stdin).get("Self") or {}).get("DNSName") or "").rstrip(".")
except Exception:
    n = ""
print(n if re.fullmatch(r"[A-Za-z0-9.-]{1,253}", n) else "")' 2>/dev/null)"
  fi
  cat <<EOF
The live view listens on 127.0.0.1:$VNC_PORT only. To reach it from your other devices over
Tailscale, publish it to your own tailnet. That's your choice: it changes this Mac's networking,
so metacomputer doesn't run it for you.
  while you need it (Ctrl-C stops it):  tailscale serve --tcp $VNC_PORT tcp://127.0.0.1:$VNC_PORT
  or until you undo it:                 tailscale serve --bg --tcp $VNC_PORT tcp://127.0.0.1:$VNC_PORT
  undo:                                 tailscale serve --tcp $VNC_PORT off
Then connect a VNC client on your other device to ${name:-<this Mac's tailnet name>}:$VNC_PORT
(vnc://${name:-<this Mac's tailnet name>}:$VNC_PORT); the live-view password still guards it:
  $(vnc_password_hint)
Every device your tailnet's access rules let reach this Mac can then reach the port.
EOF
  [ -n "$ts" ] || echo "(Tailscale isn't installed on this Mac: tailscale.com.)"
}

new_vnc_password() { LC_ALL=C tr -dc 'A-Za-z0-9' </dev/urandom | head -c 8; }

# DEADLINE CMD... (with this shell's stdin): CMD, stopped when $SECONDS reaches DEADLINE: TERM a second
# before it, then KILL at it (the process and its children). 124 = stopped. The deadline is checked again
# on every pass, so the whole of it never runs past DEADLINE.
proc_tree() { local c; for c in $(pgrep -P "$1" 2>/dev/null); do printf '%s ' "$c"; proc_tree "$c"; done; }
run_until() {
  local deadline="$1" pid procs; shift
  [ "$SECONDS" -lt "$deadline" ] || return 124
  "$@" 0<&0 &
  pid=$!
  while kill -0 "$pid" 2>/dev/null; do
    if [ "$SECONDS" -ge $(( deadline - 1 )) ]; then
      # The whole tree, listed before anything is signalled (a child whose parent dies is re-parented).
      procs="$pid $(proc_tree "$pid")"
      kill -TERM $procs 2>/dev/null
      while kill -0 "$pid" 2>/dev/null && [ "$SECONDS" -lt "$deadline" ]; do sleep 0.1; done
      kill -KILL $procs $(proc_tree "$pid") 2>/dev/null; wait "$pid" 2>/dev/null
      return 124
    fi
    sleep 0.1
  done
  wait "$pid"
}
# PASSWORD -> the login Keychain as metacomputer-vnc / VM_NAME; 0 = that item now holds this password. All of
# it ends within MCOMP_KEYCHAIN_WAIT seconds. `add-generic-password -w` with no value reads the terminal
# (getpass) and with one puts it on a command line, so the command goes to `security -i` on stdin. It
# updates the item in place (-U: no moment without one) and tags it with a one-time comment; since
# `security -i`'s exit status says nothing, the item is then looked up and must carry that tag, so another
# write that won the race (or an old item) is never taken for this one. The build's VM lock keeps two
# writes for one VM apart in the first place.
vnc_keychain_put() {
  local pw="$1" kc tag deadline
  deadline=$(( SECONDS + ${MCOMP_KEYCHAIN_WAIT:-20} ))
  [[ "$VM_NAME" =~ ^[A-Za-z0-9._-]+$ ]] && [[ "$pw" =~ ^[A-Za-z0-9]+$ ]] || return 1
  tag="mcomp-$(LC_ALL=C tr -dc 'a-f0-9' </dev/urandom | head -c 20)"
  kc="$(run_until "$deadline" security login-keychain </dev/null 2>/dev/null | sed -n '1s/^[[:space:]]*"\(.*\)"[[:space:]]*$/\1/p')"
  case "$kc" in /*) ;; *) return 1 ;; esac
  case "$kc" in *'"'*|*'\'*) return 1 ;; esac
  [ -f "$kc" ] || return 1
  printf 'add-generic-password -U -s %s -a %s -l "metacomputer live view" -j %s -w %s "%s"\n' \
    "$VNC_KEYCHAIN_SERVICE" "$VM_NAME" "$tag" "$pw" "$kc" | run_until "$deadline" security -i >/dev/null 2>&1
  run_until "$deadline" security find-generic-password -s "$VNC_KEYCHAIN_SERVICE" -a "$VM_NAME" "$kc" </dev/null 2>/dev/null \
    | grep -F "\"icmt\"<blob>=\"$tag\"" >/dev/null
}

do_vnc_install() { # make sure a live-view password exists in the configured store, then push it to the guest
  local pw=""
  # The same lock as the build's (held already when the build runs this): one password change per VM at a time.
  vm_lock_or_die "the live-view password of $VM_NAME"
  case "$VNC_PASSWORD_STORE" in
    command)
      [ -n "$VNC_PASSWORD_GET" ] && [ -n "$VNC_PASSWORD_SET" ] || die "VNC_PASSWORD_STORE=command needs VNC_PASSWORD_GET and VNC_PASSWORD_SET (config/local.env)"
      pw="$(sh -c "$VNC_PASSWORD_GET" 2>/dev/null || true)"
      if [ -z "$pw" ]; then
        new_vnc_password | sh -c "$VNC_PASSWORD_SET" >/dev/null || die "VNC_PASSWORD_SET failed"
        pw="$(sh -c "$VNC_PASSWORD_GET" 2>/dev/null || true)"
      fi ;;
    keychain)
      if pw="$(vnc_file_io read 2>/dev/null)"; then
        vnc_file_write "$pw"   # an earlier setup's password: kept, rewritten 0600
      else
        pw="$(new_vnc_password)"
        if ! vnc_keychain_put "$pw"; then
          warn "the login Keychain didn't take the live-view password (none, locked, or waiting on a dialog); it's kept in $(vnc_file) (0600) instead"
          vnc_file_write "$pw"
        fi
      fi ;;
    *)
      pw="$(vnc_file_io read 2>/dev/null)" || pw="$(new_vnc_password)"
      vnc_file_write "$pw" ;;
  esac
  [ -n "$pw" ] || die "no live-view password available (VNC_PASSWORD_STORE=$VNC_PASSWORD_STORE)"
  vnc_push "$pw"
}
vnc_push() { # PASSWORD -> the VM, on ssh's stdin, within MCOMP_VNC_PUSH_WAIT seconds (a VM that holds it open can't stall a build)
  printf '%s\n' "$1" | run_until $(( SECONDS + ${MCOMP_VNC_PUSH_WAIT:-120} )) gssh ops 'umask 077; mkdir -p ~/.config/metacomputer; cat > ~/.config/metacomputer/vnc-pass; pkill -x x11vnc; /opt/metacomputer/bin/session-run /opt/metacomputer/bin/session-init' \
    || die "could not install the VNC password"
  ok "live view enabled on 127.0.0.1:$VNC_PORT (password: $(vnc_password_hint))"
}
do_vnc_push() { # _vnc-push: the password as one line on stdin
  local pw=""; IFS= read -r pw || true
  [ -n "$pw" ] || die "_vnc-push reads the password as one line on stdin"
  vnc_push "$pw"
}

do_where() { # paths a person or an agent may need
  echo "project   $LAB_ROOT"
  echo "config    $LOCAL_CONFIG$([ -f "$LOCAL_CONFIG" ] || echo ' (not created; defaults in use)')"
  echo "skill     $LAB_ROOT/skills/metacomputer"
  echo "docs      $LAB_ROOT/docs"
  echo "results   $LAB_ROOT/results"
  echo "vm        $VM_NAME (baseline $BASELINE_NAME; settings: $MC_SETTINGS_LABEL)$([ "${MC_IMPLICIT:-0}" = 1 ] && echo '; with other VMs in the runner, commands ask you to say which with --vm NAME')"
  echo "vault     $(mc_vault_dir)"
  echo "spool     ${EVENTS_SPOOL:-${HOME}/Library/Application Support/metacomputer/events/spool}"
}

# --- secrets: mcomp-vault (scripts/build-vault.sh) holds them; this only fills in the VM ---
VAULT_BIN="${MCOMP_VAULT_BIN:-$HOME/.local/share/metacomputer/bin/mcomp-vault}"
secrets_log() { # KIND: put the result JSON (stdin, metadata only) in the signed action log when it's on
  if [ "$ACTION_LOG" = on ]; then
    export_options; "$PY" "$LAB_ROOT/lib/actionlog.py" event "$1" || warn "could not write the action log"
  else
    cat >/dev/null
  fi
}
do_secrets() { # the vault's commands, with this VM's name, port, keys, host key and gateway filled in
  [ -x "$VAULT_BIN" ] || die "the secrets vault isn't installed: run scripts/build-vault.sh (or ./install.sh)"
  case "$("$VAULT_BIN" version --json 2>/dev/null)" in
    *'"build":"release"'*) ;;
    *) [ "${MCOMP_VAULT_ALLOW_TEST_BUILD:-}" = 1 ] \
         || die "$VAULT_BIN isn't a release build of the vault; reinstall it with scripts/build-vault.sh --force" ;;
  esac
  local sub="${1:-status}" a has_vm=0 out rc
  [ $# -gt 0 ] && shift
  # This VM's vault and spool (scripts/lib.sh): empty for the main VM, which leaves the vault's own defaults.
  [ -z "${VAULT_DIR:-}" ] || export MCOMP_VAULT_DIR="$VAULT_DIR"
  # Dialogs that wait for you (`secrets ask`'s): only the unlock reads it, from your own settings, when you unlock.
  export MCOMP_INTERACTIVE_PROMPTS="${INTERACTIVE_PROMPTS:-off}"
  [ -z "${EVENTS_SPOOL:-}" ] || export MCOMP_EVENTS_SPOOL="$EVENTS_SPOOL"
  # A per-VM vault folder's parent (the vault makes only the last folder, 0700).
  case "${VAULT_DIR:-}" in "$MC_VMS_APP_DIR/"*) ( umask 077; mkdir -p "$MC_VMS_APP_DIR" ) || die "couldn't make $(mc_tilde "$MC_VMS_APP_DIR")" ;; esac
  for a in "$@"; do case "$a" in --vm|--vm=*) has_vm=1 ;; esac; done
  case "$sub" in
    bind)
      local vm="$VM_NAME" hk
      if [ $# -gt 0 ] && [ "${1#-}" = "$1" ]; then vm="$1"; shift; fi
      hk="$(grep -F "[127.0.0.1]:$SSH_PORT " "$KNOWN_HOSTS" 2>/dev/null | head -1)"
      [ -n "$hk" ] || hk="$(cut -d' ' -f1,2 "$SSH_DIR/hostkey.pub" 2>/dev/null)"
      [ -f "$SSH_DIR/fill" ] || die "no fill key ($SSH_DIR/fill): VMs built before secrets support have no fill account. Rebuild the VM to use secrets (metacomputer build --replace, or a new VM_NAME)"
      [ "${SSH_AUTH:-key}" = cert ] && warn "SSH_AUTH=cert: sealed sessions sign in with the static ops key, which a VM on certificates refuses (fills use their own account and still work)"
      [ -f "$SSH_DIR/hostkey" ] && warn "the VM's private host key is still in $SSH_DIR/hostkey: anything that can read it can pose as the VM. Nothing on the Mac needs it after the build (newer builds delete it): delete it with rm $SSH_DIR/hostkey"
      # API tokens reach the VM through its proxy account (mcproxy, one reverse forward); older VMs have none.
      local proxy=()
      if [ -f "$SSH_DIR/proxy" ]; then
        proxy=(--proxy-key "$SSH_DIR/proxy" --proxy-user mcproxy --proxy-port "${SECRETS_PROXY_PORT:-18765}")
      else
        warn "no proxy key ($SSH_DIR/proxy): this VM was built before API tokens, so 'metacomputer secrets token' won't work with it until it is rebuilt (fills and sessions do)"
      fi
      # Fills sign in as the VM's fill account (mcfill), sessions as the desktop user.
      exec "$VAULT_BIN" bind "$vm" --port "$SSH_PORT" --host-key-line "$hk" --fill-key "$SSH_DIR/fill" --fill-user mcfill \
        --ops-key "$SSH_DIR/ops" --ops-user "$GUEST_USER" --gateway "$NETGW_BIN" ${proxy[@]+"${proxy[@]}"} "$@" ;;
    import-session)
      # The session is for this VM (its approval policy, and where `session load` puts it).
      [ "$has_vm" = 1 ] || set -- "$@" --vm "$VM_NAME"
      exec "$VAULT_BIN" import-session "$@" ;;
    ask)
      # A request for you: nothing acts on the VM until a value comes (give, the dialog), which follows the approvals.
      [ "$has_vm" = 1 ] || set -- "$@" --vm "$VM_NAME"
      exec "$VAULT_BIN" ask "$@" ;;
    status)
      "$VAULT_BIN" status "$@"; rc=$?
      case " $* " in *" --json "*) ;; *)
        echo "codes:    $([ "${CODES_VIA:-vault}" = claude ] && echo "Claude may read and type one-time codes itself (CODES_VIA=claude; guidance, not enforced)" || echo "through the vault: secrets code, relay or ask (CODES_VIA=vault)"); dialogs: ${INTERACTIVE_PROMPTS:-off} (INTERACTIVE_PROMPTS, read at unlock)" ;;
      esac
      return $rc ;;
    approve)
      # Approving a waiting one-time code request fills it in the VM once you've allowed it: that waits for an open
      # handoff like any fill. (Other approvals answer a fill that already holds this, so they go straight on.)
      local id="${1:-}"
      if [[ "$id" =~ ^[0-9a-f]{8}$ ]] && "$VAULT_BIN" requests --json 2>/dev/null | "$PY" -c 'import json,sys
d = json.load(sys.stdin); want = sys.argv[1]
sys.exit(0 if any(r.get("id") == want and r.get("kind") in ("code", "link") and r.get("needs_approval") for r in d.get("requests") or []) else 1)' "$id" 2>/dev/null; then
        handoff_hold
      fi
      exec "$VAULT_BIN" approve "$@" ;;
    fill|login|session|token|code|relay|give)
      local kind="secrets_$sub"
      [ "$sub" = token ] && [ "${1:-}" = renew ] && kind=secrets_token_renew
      # While the user has the computer (metacomputer handoff), a fill, login or session load waits like any acting
      # call: checked under the dispatch lock, which stays held until the vault is done with the request (an approval
      # can take minutes), so a handoff can't open while it's on its way. That check is this VM's, so --vm must
      # name this VM; another VM is chosen by its own settings (MCOMP_CONFIG).
      local inflight=""
      if [ "$sub" = fill ] || [ "$sub" = login ] || [ "$sub" = code ] || [ "$sub" = relay ] || [ "$sub" = give ] \
         || { [ "$sub" = session ] && [ "${1:-}" = load ]; }; then
        secrets_vm_is_this "$@" || die "secrets $sub acts on this VM ($VM_NAME), whose handoff it checks; for another VM, use that VM's settings (MCOMP_CONFIG=its settings file) instead of --vm"
        handoff_hold
        inflight="$RUN_DIR/owners/vault-inflight.$$"
      fi
      if [ "$sub" = session ]; then
        case "${1:-}" in save|load) kind="secrets_session_$1" ;; *) exec "$VAULT_BIN" session "$@" ;; esac
        # The vault signs in for sealed sessions with the VM's static ops key, which a VM on
        # certificates refuses: say so before anyone is asked to approve.
        [ "${SSH_AUTH:-key}" = cert ] && die "sealed sessions need SSH_AUTH=key for now: the vault signs in with the VM's static desktop key, which SSH_AUTH=cert turns off (fills and API tokens use their own accounts and still work)"
      fi
      # give names a request (bound to its VM when it was made), so it takes no --vm.
      [ "$has_vm" = 1 ] || [ "$sub" = give ] || set -- "$@" --vm "$VM_NAME"
      # Ctrl-C, SIGTERM or SIGHUP to this wrapper's process group reaches the vault client too, which withdraws the
      # request and waits for the unlock process to confirm that it stopped: this shell outlives it to pass that on.
      # (Killed outright, the client sees its parent gone and withdraws the request all the same.)
      trap ':' INT TERM HUP
      # Until the unlock process is known to be done with this request, a marker says one may still be working: a
      # handoff opened after this command ended without that knowledge settles the vault first.
      if [ -n "$inflight" ]; then
        ( umask 077; date +%s > "$inflight" ) 2>/dev/null || die "couldn't record the vault request ($inflight)"
      fi
      out="$("$VAULT_BIN" "$sub" "$@")"; rc=$?
      if [ -n "$inflight" ]; then
        # Only an answer the client got from the unlock process (or a refusal before anything was sent) says it's done
        # with the request: exit 0, 1 (failed), 2 (denied), 3 (locked), 4 (error) or 64 (usage). Anything else (5:
        # withdrawn without its confirmation; a crash, a signal) may leave it working: keep the dispatch lock while
        # `settle` waits for it, and the marker if even that doesn't confirm.
        case "$rc" in
          0|1|2|3|4|6|7|64) rm -f "$inflight" ;;
          *) "$VAULT_BIN" settle --timeout "${MCOMP_VAULT_SETTLE_S:-120}" >/dev/null 2>&1 && rm -f "$inflight" ;;
        esac
      fi
      trap - INT TERM HUP
      printf '%s\n' "$out"
      # The action log gets metadata only: never the token itself.
      printf '%s\n' "$out" | secrets_metadata | secrets_log "$kind"
      # Exit 3 (locked): the EXIT trap above reports it to the event stream (events_hook_secrets_exit).
      return $rc ;;
    *) exec "$VAULT_BIN" "$sub" "$@" ;;
  esac
}
secrets_vm_is_this() { # ARGS...: 0 when every --vm among them names this VM (the vault takes the last one)
  local a want=0
  for a in "$@"; do
    if [ "$want" = 1 ]; then [ "$a" = "$VM_NAME" ] || return 1; want=0; continue; fi
    case "$a" in --vm) want=1 ;; --vm=*) [ "${a#--vm=}" = "$VM_NAME" ] || return 1 ;; esac
  done
  [ "$want" = 0 ]
}
secrets_metadata() { # the vault's result JSON (stdin) without the token value
  "$PY" -c 'import json,sys
for line in sys.stdin:
    try: d = json.loads(line)
    except ValueError: continue
    if isinstance(d, dict):
        d.pop("token", None); print(json.dumps(d, sort_keys=True))' 2>/dev/null || true
}

case "$cmd" in
  start)      do_start "$@" ;;
  stop)       do_stop "$@" ;;
  restart)    nv=(); for a in "$@"; do [ "$a" = --no-volumes ] && nv=(--no-volumes); done
              do_stop "$@"; do_start ${nv[@]+"${nv[@]}"} ;;
  status)     do_status "$@" ;;
  reset)      do_reset "$@" ;;
  baseline)   do_baseline "$@" ;;
  test)       parse_flags "$@"; owners_check
              export_options; MCOMP_OVERRIDE="$OVERRIDE" exec "$PY" "$LAB_ROOT/tests/run_tests.py" ${REST[@]+"${REST[@]}"} ;;
  who)        do_who "$@" ;;
  notify)     export_options; exec "$PY" "$LAB_ROOT/lib/events.py" notify "$@" ;;
  handoff)    export_options
              case "${1:-}" in done|cancel|wait|status|guard|-h|--help) ;;
                *) MCOMP_VM_STATE="$(vm_running "$VM_NAME" && echo running || echo off)"; export MCOMP_VM_STATE ;; esac
              exec "$PY" "$LAB_ROOT/lib/handoff.py" "$@" ;;
  events)     export_options
              if [ "${1:-}" = watcher ]; then do_events_watcher "${2:-status}"; exit $?; fi
              "$PY" "$LAB_ROOT/lib/events.py" "$@"; rc=$?
              # A sink added or removed while the computer runs: make sure the watcher runs now (removing the
              # last sink leaves its own announcement to deliver), rather than at the next start.
              if [ $rc = 0 ] && [ "${1:-}" = sink ] && { [ "${2:-}" = add ] || [ "${2:-}" = remove ]; } && vm_running "$VM_NAME"; then events_watcher_start; fi
              exit $rc ;;
  _health)    do_health ;;
  inspect)    do_inspect "$@" ;;
  where)      do_where ;;
  call)       [ $# -ge 1 ] || die "usage: metacomputer call [--session NAME] TOOL ['JSON']"
              export_options; exec "$PY" "$LAB_ROOT/lib/mcomp_sdk.py" call "$@" ;;
  hub)        do_hub "$@" ;;
  browser)    do_browser "$@" ;;
  desktop-restart) do_desktop_restart "$@" ;;
  input-reset) do_input_reset "$@" ;;
  rename)     do_rename "$@" ;;
  web)        export_options; exec "$PY" "$LAB_ROOT/lib/browser_tools.py" "$@" ;;
  release)    "$PY" "$LAB_ROOT/lib/owners.py" release ;;
  put)        do_put "$@" ;;
  get)        do_get "$@" ;;
  shot)       do_shot "$@" ;;
  contact-sheet) do_contact_sheet "$@" ;;
  task)       do_task "$@" ;;
  checkpoint) do_checkpoint "$@" ;;
  checkpoints) do_checkpoints ;;
  vm)         . "$LAB_ROOT/scripts/vm-commands.sh"; do_vm "$@" ;;
  volume|refdisk) export_options; MCOMP_LAB_ROOT="$LAB_ROOT" exec "$PY" "$LAB_ROOT/lib/storage.py" "$cmd" "$@" ;;
  restore)    do_restore "$@" ;;
  record)     do_record "$@" ;;
  _record-pipe) do_record_pipe "$@" ;;
  _task-sync) do_task_sync "$@" ;;
  recordings) do_recordings "$@" ;;
  view)       do_view "$@" ;;
  sh)         do_sh "$@" ;;
  claude)     do_claude "$@" ;;
  ssh)        role="${1:-ops}"; [ $# -gt 0 ] && shift
              ssh_base "$role"; exec ssh "${SSH_ARGS[@]}" "$@" ;;
  mcp)        # With the hub on, an MCP client here gets the guarded bridge (through the hub); only the hub itself
              # and the transport tests (MCOMP_DIRECT_BRIDGE=1) get the raw connection to the driver.
              if [ "${MCOMP_DIRECT_BRIDGE:-}" != 1 ] && [ "${MCOMP_MCP_HUB:-${MCP_HUB:-on}}" = on ]; then
                export_options; exec "$PY" "$LAB_ROOT/lib/mcp_lazy.py"
              fi
              vm_running "$VM_NAME" || { echo "metacomputer: VM '$VM_NAME' is not running (metacomputer start)" >&2; exit 1; }
              req="$(driver_request)" || exit 1
              ssh_base mcp
              if [ "$ACTION_LOG" = on ]; then
                export_options; exec "$PY" "$LAB_ROOT/lib/mcp_relay.py" ssh -T "${SSH_ARGS[@]}" ${req:+"$req"}
              fi
              exec ssh -T "${SSH_ARGS[@]}" ${req:+"$req"} ;;
  mcp-lazy)   export_options; exec "$PY" "$LAB_ROOT/lib/mcp_lazy.py" ;;
  actions)    export_options; exec "$PY" "$LAB_ROOT/lib/actionlog.py" "$@" ;;
  security)   do_security "$@" ;;
  secrets)    do_secrets "$@"; exit $? ;;
  learn)      export_options; exec "$PY" "$LAB_ROOT/lib/learn.py" "$@" ;;
  build)      exec "$LAB_ROOT/scripts/build-vm.sh" "$@" ;;
  setup)      # ./install.sh; with no terminal to ask on, only with --yes (as the plugin's setup)
              [ "$MC_SETTINGS_KIND" != vm ] || die "setup sets up this checkout's main VM (config/local.env); for $VM_NAME: metacomputer --vm $VM_NAME build"
              case " $* " in *" --yes "*|*" -y "*) ;; *)
                [ -t 0 ] || { printf '%s\n' "metacomputer setup runs $LAB_ROOT/install.sh, which asks before it changes anything." \
                  "There's no terminal here to ask on: to go ahead, run: metacomputer setup --yes" >&2; exit 3; } ;; esac
              exec "$LAB_ROOT/install.sh" "$@" ;;
  logs)       n="${1:-40}"; [[ "$n" =~ ^[0-9]{1,6}$ ]] || die "usage: metacomputer logs [LINES]"
              { tail -n "$n" "$LOG_DIR/lume-$VM_NAME.log" "$LOG_DIR/netgw.log" 2>/dev/null
                gssh admin "sudo /usr/local/sbin/metacomputer-admin logs $n" 2>/dev/null; } | term_safe ;;
  _vnc-install) do_vnc_install ;;
  _vnc-push)  do_vnc_push ;;
  help|-h|--help) sed -n '2,/^set -uo/p' "$SELF" | sed '$d' | sed 's/^# \{0,1\}//' ;;
  *) die "unknown command '$cmd' (metacomputer help)" ;;
esac
